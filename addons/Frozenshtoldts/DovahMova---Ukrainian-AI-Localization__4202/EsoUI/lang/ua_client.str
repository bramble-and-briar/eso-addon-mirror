[SI_GUILD_DESCRIPTION_EMPTY_TEXT] = "Для цієї гільдії не встановлено опис."
[SI_GUILD_DESCRIPTION_HEADER] = "Про нас"
[SI_GUILD_DISBAND] = "Ви є останнім членом гільдії. Вихід розпустить гільдію та дозволить іншим використовувати її назву. Це також знищить усі предмети, що зберігаються в банку гільдії.\n\nВи впевнені, що хочете залишити: <<X:1>>|cffffff<<2>>|r?"
