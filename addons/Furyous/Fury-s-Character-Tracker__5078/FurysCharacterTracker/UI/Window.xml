<GuiXml>
    <Controls>
        <!-- One character per row. The cells are made in Window.lua, as many as the widest tab needs. -->
        <Control name="FurysCharacterTracker_Row" virtual="true" mouseEnabled="true">
            <Dimensions x="1368" y="28" />
            <Controls>
                <Texture name="$(parent)Stripe" color="16142C" layer="BACKGROUND" level="3" hidden="true">
                    <AnchorFill />
                </Texture>
                <Texture name="$(parent)Highlight" color="211D46" layer="BACKGROUND" level="5" hidden="true">
                    <AnchorFill />
                </Texture>
            </Controls>
        </Control>

        <TopLevelControl name="FurysCharacterTracker_Window" hidden="true" mouseEnabled="true" movable="true" clampedToScreen="true">
            <Dimensions x="1420" y="784" />
            <Anchor point="CENTER" />
            <OnMouseDown>FurysCharacterTracker.Raise(self)</OnMouseDown>
            <OnMoveStop>FurysCharacterTracker.Window.SavePosition()</OnMoveStop>
            <Controls>
                <Backdrop name="$(parent)BG" centerColor="0F0E1F" edgeColor="4A3D99" alpha="1">
                    <AnchorFill />
                    <Edge edgeSize="2" />
                </Backdrop>
                <Label name="$(parent)Title" font="ZoFontWinH2" color="ECEAF8" text="Fury's Character Tracker">
                    <Anchor point="TOPLEFT" offsetX="18" offsetY="12" />
                </Label>
                <Label name="$(parent)Subtitle" font="ZoFontGameSmall" color="B4B0D8">
                    <Anchor point="LEFT" relativeTo="$(parent)Title" relativePoint="RIGHT" offsetX="14" offsetY="4" />
                </Label>
                <Button name="$(parent)Close" inherits="ZO_CloseButton">
                    <Anchor point="TOPRIGHT" offsetX="-12" offsetY="12" />
                    <OnClicked>FurysCharacterTracker.Window:Hide()</OnClicked>
                </Button>
                <!-- The tabs, made in Window.lua, and the line they sit on. -->
                <Control name="$(parent)Views">
                    <Dimensions x="1384" y="32" />
                    <Anchor point="TOPLEFT" offsetX="18" offsetY="54" />
                </Control>
                <Texture name="$(parent)ViewsLine" color="4A3D99">
                    <Dimensions x="1384" y="1" />
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Views" relativePoint="BOTTOMLEFT" />
                </Texture>
                <Label name="$(parent)Summary" font="ZoFontGameSmall" color="B4B0D8" wrapMode="ELLIPSIS" mouseEnabled="true">
                    <Dimensions x="1384" y="20" />
                    <Anchor point="TOPLEFT" relativeTo="$(parent)ViewsLine" relativePoint="BOTTOMLEFT" offsetY="8" />
                </Label>
                <Control name="$(parent)Header">
                    <Dimensions x="1384" y="26" />
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Summary" relativePoint="BOTTOMLEFT" offsetY="4" />
                </Control>
                <Texture name="$(parent)HeaderLine" color="4A3D99">
                    <Dimensions x="1384" y="1" />
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Header" relativePoint="BOTTOMLEFT" offsetY="2" />
                </Texture>
                <Control name="$(parent)List" inherits="ZO_ScrollList">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)HeaderLine" relativePoint="BOTTOMLEFT" offsetY="4" />
                    <Anchor point="BOTTOMRIGHT" offsetX="-18" offsetY="-116" />
                </Control>
                <Texture name="$(parent)TotalsLine" color="4A3D99">
                    <Dimensions x="1384" y="1" />
                    <Anchor point="BOTTOMLEFT" offsetX="18" offsetY="-112" />
                </Texture>
                <Control name="$(parent)Totals" inherits="FurysCharacterTracker_Row">
                    <Dimensions x="1384" />
                    <Anchor point="TOPLEFT" relativeTo="$(parent)TotalsLine" relativePoint="BOTTOMLEFT" offsetY="4" />
                </Control>
                <Control name="$(parent)Footer">
                    <Dimensions x="1384" y="30" />
                    <Anchor point="BOTTOMLEFT" offsetX="18" offsetY="-38" />
                </Control>
                <Label name="$(parent)Legend" font="ZoFontGameSmall" color="B4B0D8">
                    <Anchor point="BOTTOMLEFT" offsetX="20" offsetY="-12" />
                </Label>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
