[SI_GUILD_INFO_FETCHING_DATA] = "Pobieranie informacji o gildii..."
[SI_GUILD_INFO_SCENE_TITLE] = "Informacje o gildii"
[SI_GUILD_INTRODUCTION] = "Gildie są świetnym sposobem na połączenie sił z innymi podróżnikami, których spotykasz podczas eksploracji świata Tamriel! Te wielkie, stałe grupy pozwalają graczom zjednoczyć się, spełniać wspólne cele i odblokować specjalne dodatki w sklepie gildii."
[SI_GUILD_INVITED_PLAYER_LOCATION] = "Oczekujące zaproszenie"
[SI_GUILD_INVITE_ACTION] = "Dodaj członka"
[SI_GUILD_INVITE_BLACKISTED_ALERT] = "<<1>> jest na czarnej liście w <<2>>."
[SI_GUILD_INVITE_MESSAGE] = "Zaproszono cię do <<X:1>>|cffffff<<2>>|r przez |cffffff<<3>>|r."
[SI_GUILD_KEEP_ATTACK_END] = "Nie zabito więcej strażników w: <<1>>."
[SI_GUILD_KEEP_ATTACK_UPDATE] = "<<1>> <<1[strażnik został zabity/strażników zostało zabitych]>> przez <<3>> <<3[gracza/graczy]>> w: <<2>>."
[SI_GUILD_KEEP_OWNERSHIP_HEADER] = "Wojna Frakcji\nWłaściciel"
[SI_GUILD_KIOSK_BANKED_GOLD_HEADER] = "Saldo banku gildii:"
[SI_GUILD_KIOSK_BIDDING_CLOSES_IN_HEADER] = "Licytacja zamknie się za:"
[SI_GUILD_KIOSK_BID_DESCRIPTION] = "Twoja gildia może ubiegać się o zatrudnienie tego kupca do wykorzystania w przyszłości. Sklep zwycięskiej gildii zostanie udostępniony ogółowi społeczeństwa za pośrednictwem tego kupca przez łącznie |cffffff7 dni|r. Okres wynajmu nie rozpocznie się, dopóki nie zostanie wyłoniony zwycięzca po zakończeniu licytacji.\n\n|cffffffUWAGA:|r Możesz licytować do |cffffff<<1>>|r kupców na gildię w ciągu tygodnia, jednak możesz wygrać tylko |cffffff1|r na podstawie twojej najwyższej wygranej stawki. Jeśli jest wiele zwycięskich ofert o tej samej wysokości, wygrywa ta najwcześniejsza. Wszystkie pozostałe stawki zostaną zwrócone po zakończeniu licytacji."
[SI_GUILD_KIOSK_BID_ERROR_TRADING_HOUSE_LOCKED] = "Gildie muszą odblokować sklepy gildii, aby licytować kupca. Ta gildia nie ma wymaganych |cffffff<<1>>|r członków."
[SI_GUILD_KIOSK_BID_GUILD_CHOICE_HEADER] = "Stawka dla gildii:"
[SI_GUILD_KIOSK_BID_RATE_EXCEEDED] = "Przekroczono stawkę."
[SI_GUILD_KIOSK_BID_TITLE] = "Postaw na kupca gildii"
[SI_GUILD_KIOSK_CURRENT_BID_HEADER] = "Obecna stawka:"
[SI_GUILD_KIOSK_DISPLAY_CAPTION_WITH_OWNER] = "Kupiec gildii (<<1>>)"
[SI_GUILD_KIOSK_INITIAL_BID] = "Potwierdź stawkę"
[SI_GUILD_KIOSK_MINIMUM_BID_HEADER] = "Minimalna stawka:"
[SI_GUILD_KIOSK_NEW_BID_HEADER] = "Nowa stawka:"
[SI_GUILD_KIOSK_PURCHASE] = "Zatrudnij"
[SI_GUILD_KIOSK_PURCHASE_COST] = "Koszt wynajmu:"
[SI_GUILD_KIOSK_PURCHASE_DESCRIPTION] = "Twoja gildia może wynająć tego kupca, aby użyć go natychmiast. Kiedy będzie wynajęty, twój sklep gildii stanie się dostępny publicznie poprzez tego kupca przez następne |cffffff<<1>>|r.\n\n|cffffffPAMIĘTAJ:|r tylko jeden kupiec naraz może być wynajęty dla gildii."
[SI_GUILD_KIOSK_PURCHASE_ERROR_KIOSK_RENTED] = "Gildie mogą wynająć tylko jednego kupca gildii. Ta gildia aktualnie ma wynajętego |cffffff<<1>>|r."
[SI_GUILD_KIOSK_PURCHASE_ERROR_TRADING_HOUSE_LOCKED] = "Gildie muszą odblokować sklepy gildii, aby wynająć kupca. Ta gildia nie ma wymaganych |cffffff<<1>>|r członków."
