<GuiXml>
    <Controls>
        <!-- Etiqueta de una fila: recibe el ratón para poder mostrar el texto completo si está cortado,
             y reenvía los eventos a la fila para que el resaltado y el clic sigan funcionando -->
        <Label name="AlchemyFavoritePotions_RowLabel" mouseEnabled="true" wrapMode="ELLIPSIS" maxLineCount="1" virtual="true">
            <OnMouseEnter>
                AlchemyFavoritePotions.OnFavoriteRowMouseEnter(self:GetParent(), self)
            </OnMouseEnter>

            <OnMouseExit>
                AlchemyFavoritePotions.OnFavoriteRowMouseExit(self:GetParent())
            </OnMouseExit>

            <OnMouseUp>
                AlchemyFavoritePotions.OnFavoriteRowMouseUp(self:GetParent(), button, upInside)
            </OnMouseUp>
        </Label>

        <!-- Etiqueta de ingrediente con icono a la izquierda (mismo aspecto que los rasgos de la fila de reactivo) -->
        <Label name="AlchemyFavoritePotions_IngredientLabel" inherits="AlchemyFavoritePotions_RowLabel" font="ZoFontWinH4" virtual="true">
            <Dimensions x="170" y="20" />

            <OnInitialized>
                self.icon = self:GetNamedChild("Icon")
            </OnInitialized>

            <Controls>
                <Texture name="$(parent)Icon" inherits="ZO_AlchemyTraitIcon">
                    <Anchor point="RIGHT" relativePoint="LEFT" offsetX="-5" />
                </Texture>
            </Controls>
        </Label>

        <!-- Fila de poción favorita: mismas medidas y posiciones que ZO_AlchemyInventoryReagentRow -->
        <Control name="AlchemyFavoritePotions_Row" mouseEnabled="true" virtual="true">
            <Dimensions x="392" y="108" />

            <OnInitialized>
                self.highlight = self:GetNamedChild("Highlight")
                self.icon = self:GetNamedChild("Icon")
                self.name = self:GetNamedChild("Name")
                self.ingredientLabels = {
                    self:GetNamedChild("Ingredient1"),
                    self:GetNamedChild("Ingredient2"),
                    self:GetNamedChild("Ingredient3"),
                    self:GetNamedChild("Ingredient4"),
                }
            </OnInitialized>

            <OnMouseEnter>
                AlchemyFavoritePotions.OnFavoriteRowMouseEnter(self)
            </OnMouseEnter>

            <OnMouseExit>
                AlchemyFavoritePotions.OnFavoriteRowMouseExit(self)
            </OnMouseExit>

            <OnMouseUp>
                AlchemyFavoritePotions.OnFavoriteRowMouseUp(self, button, upInside)
            </OnMouseUp>

            <Controls>
                <Texture name="$(parent)Highlight" textureFile="EsoUI/Art/Miscellaneous/listItem_selectedHighlight.dds" hidden="true">
                    <AnchorFill />
                    <TextureCoords left="0" right="1" top="0" bottom=".625" />
                </Texture>

                <Texture name="$(parent)Icon">
                    <Dimensions x="40" y="40" />
                    <Anchor point="CENTER" relativePoint="TOPLEFT" offsetX="70" offsetY="46" />
                </Texture>

                <Label name="$(parent)Name" inherits="AlchemyFavoritePotions_RowLabel" font="ZoFontGameShadow">
                    <Dimensions x="270" />
                    <Anchor point="TOPLEFT" offsetX="110" offsetY="15" />
                </Label>

                <Label name="$(parent)Ingredient1" inherits="AlchemyFavoritePotions_IngredientLabel">
                    <Anchor point="TOPLEFT" offsetX="150" offsetY="43" />
                </Label>
                <Label name="$(parent)Ingredient2" inherits="AlchemyFavoritePotions_IngredientLabel">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Ingredient1" relativePoint="BOTTOMLEFT" offsetY="10" />
                </Label>
                <Label name="$(parent)Ingredient3" inherits="AlchemyFavoritePotions_IngredientLabel">
                    <Anchor point="TOPLEFT" offsetX="370" offsetY="43" />
                </Label>
                <Label name="$(parent)Ingredient4" inherits="AlchemyFavoritePotions_IngredientLabel">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Ingredient3" relativePoint="BOTTOMLEFT" offsetY="10" />
                </Label>
            </Controls>
        </Control>
    </Controls>
</GuiXml>
