[SI_ZONECOMPLETIONTYPE1] = "Zadania fabuły regionu"
[SI_ZONECOMPLETIONTYPE10] = "Intrygujące zakątki"
[SI_ZONECOMPLETIONTYPE11] = "Książki Biblioteki Shalidora"
[SI_ZONECOMPLETIONTYPE12] = "Kamienie Mundus"
[SI_ZONECOMPLETIONTYPE13] = "Publiczne lochy"
[SI_ZONECOMPLETIONTYPE14] = "Stanowisko wytwarzania zestawów"
[SI_ZONECOMPLETIONTYPE2] = "Interesujące miejsca (POI)"
[SI_ZONECOMPLETIONTYPE3] = "Osiągnięcia"
[SI_ZONECOMPLETIONTYPE4] = "Kapliczki"
[SI_ZONECOMPLETIONTYPE5] = "Groty"
[SI_ZONECOMPLETIONTYPE6] = "Grupowe groty"
[SI_ZONECOMPLETIONTYPE7] = "Niebiańskie Odłamki"
[SI_ZONECOMPLETIONTYPE8] = "Wydarzenia światowe"
[SI_ZONECOMPLETIONTYPE9] = "Światowi bossowie"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION1] = "|cffffffZadania fabuły regionu|r są głównym wątkiem fabularnym danego regionu. Nagrodą za ukończenie tych zadań mogą być punkty umiejętności, doświadczenie, złoto lub wyposażenie."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION10] = "|cffffffIntrygujące zakątki|r są interesującymi miejscami znajdującymi się w całym Tamriel. Odnalezienie wszystkich intrygujących zakątków na danym regionie zostanie nagrodzone osiągnięciem Badacz."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION11] = "|cffffffKsiążki Biblioteki Shalidora|r są rozrzucone po całym świecie. Książki wyróżniają się charakterystyczną fioletową poświatą. Odnalezienie ich zwiększy twoją rangę w Gildii Magów i pozwoli rozwinąć powiązane z nią drzewko umiejętności."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION12] = "|cffffffKamienie Mundus|r to obiekty, które dają dar w postaci czasowych wzmocnień. Efekt wzmocnienia będzie trwał, póki nie zostanie zastąpiony poprzez dar innego Kamienia Mundus."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION13] = "|cffffffPubliczne Lochy|r są otwartymi lochami znajdującymi się w całym Tamriel i poza nim. Są one przeznaczone dla czteroosobowych grup. Nagrodą za ukończenie różnych części publicznych lochów może być punkt umiejętności, doświadczenie, złoto oraz wyposażenie."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION14] = "|cffffffStanowiska Wytwarzania Zestawów|r są miejscami, w których możesz wytworzyć przedmioty ze specjalnymi bonusami zestawów."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION2] = "|cffffffInteresujące Miejsca|r są samodzielnymi historiami o świecie, postaciach i lokacjach w regionie. Odkrycie ich nagradzane jest doświadczeniem, złotem lub wyposażeniem."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION4] = "|cffffffKapliczki|r pozwalają na darmową, szybką podróż pomiędzy tymi kapliczkami, które zostały odkryte i odblokowane. Możesz również przenieść się do odblokowanej kapliczki z jakiegokolwiek miejsca, ale w tym wypadku za drobną opłatą."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION5] = "|cffffffGroty|r są lochami przeznaczonymi dla jednego gracza. W grotach zawsze jest jeden Niebiański Odłamek i boss, za którego pokonanie otrzymuje się przedmiot z zestawu."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION6] = "|cffffffGrupowe Groty|r są lochami, znajdują się w Craglorn i są stworzone dla czteroosobowych grup. W grupowych grotach zawsze jest jeden Niebiański Odłamek i boss, za którego pokonanie otrzymuje się przedmiot z zestawu."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION7] = "|cffffffNiebiańskie Odłamki|r są rozrzucone po całym świecie i można je rozpoznać po jasnym promieniu białego światła, które emitują. Odnalezienie trzech Niebiańskich Odłamków zapewnia punkt umiejętności, który może zostać użyty do odblokowania lub przekształcenia zdolności."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION8] = "|cffffffWydarzenia Światowe|r, takie jak Mroczne Kotwice, są aktywnościami, które występują w świecie i na które najlepiej wybrać się w drużynie. Ukończenie wydarzenia światowego nagradzane jest doświadczeniem, złotem lub wyposażeniem o wyższym poziomie."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION9] = "|cffffffŚwiatowi bossowie|r są trudnymi przeciwnikami, których atakowanie zalecane jest w grupach. Za pokonanie światowego bossa możesz otrzymać wyposażenie o wyższym poziomie."
