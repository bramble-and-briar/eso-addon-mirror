<GuiXml>
    <Controls>
        <!-- Small recruiting status bar: zones posted, pending applications, whisper leads.
             Shown only when turned on (Recruiting > Status bar). Drag it to move it. -->
        <TopLevelControl name="FuryGMTRecruitBar" hidden="true" mouseEnabled="true" movable="true" clampedToScreen="true">
            <Dimensions x="420" y="34" />
            <Anchor point="TOP" relativeTo="GuiRoot" offsetY="70" />
            <OnMoveStop>FuryGMT.Recruit:SaveBarPosition()</OnMoveStop>
            <OnMouseEnter>FuryGMT.Report.ShowTip(self, FuryGMT.Recruit:BarTip())</OnMouseEnter>
            <OnMouseExit>FuryGMT.Report.HideTip()</OnMouseExit>
            <Controls>
                <Backdrop name="$(parent)BG" inherits="ZO_DefaultBackdrop">
                    <AnchorFill />
                </Backdrop>
                <Label name="$(parent)Text" font="ZoFontGameSmall" color="FFFFFF" verticalAlignment="CENTER">
                    <Anchor point="LEFT" offsetX="12" />
                </Label>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
