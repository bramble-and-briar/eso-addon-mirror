<GuiXml>
  <Controls>

    <TopLevelControl name="VerdantLogLamp"
                     hidden="true"
                     movable="true"
                     mouseEnabled="true"
                     clampedToScreen="true">
      <Dimensions x="32" y="32"/>

      <OnMoveStop>Verdant.Window.LogLamp.on_move_stop()</OnMoveStop>
      <OnMouseDown>Verdant.Window.LogLamp.on_mouse_down()</OnMouseDown>
      <OnMouseUp>Verdant.Window.LogLamp.on_mouse_up(upInside)</OnMouseUp>
      <OnMouseEnter>Verdant.Window.LogLamp.on_enter()</OnMouseEnter>
      <OnMouseExit>Verdant.Window.LogLamp.on_exit()</OnMouseExit>

      <Controls>
        <Texture name="$(parent)Glow" textureFile="Verdant/assets/glow_white.dds" hidden="true">
          <Dimensions x="64" y="64"/>
          <Anchor point="CENTER" relativeTo="$(parent)" relativePoint="CENTER"/>
        </Texture>

        <Texture name="$(parent)Icon">
          <AnchorFill/>
        </Texture>
      </Controls>
    </TopLevelControl>

  </Controls>
</GuiXml>
