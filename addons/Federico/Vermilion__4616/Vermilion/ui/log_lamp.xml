<GuiXml>
  <Controls>

    <TopLevelControl name="VermilionLogLamp"
                     hidden="true"
                     movable="true"
                     mouseEnabled="true"
                     clampedToScreen="true">
      <Dimensions x="32" y="32"/>

      <OnMoveStop>Vermilion.LogLamp.on_move_stop()</OnMoveStop>
      <OnMouseDown>Vermilion.LogLamp.on_mouse_down()</OnMouseDown>
      <OnMouseUp>Vermilion.LogLamp.on_mouse_up(upInside)</OnMouseUp>
      <OnMouseEnter>Vermilion.LogLamp.on_enter()</OnMouseEnter>
      <OnMouseExit>Vermilion.LogLamp.on_exit()</OnMouseExit>

      <Controls>
        <Texture name="$(parent)Glow" textureFile="Vermilion/assets/glow.dds" hidden="true">
          <Dimensions x="64" y="64"/>
          <Anchor point="CENTER" relativeTo="$(parent)" relativePoint="CENTER"/>
        </Texture>

        <Texture name="$(parent)Icon" textureFile="Vermilion/assets/skin/lamp_off.dds">
          <AnchorFill/>
        </Texture>
      </Controls>
    </TopLevelControl>

  </Controls>
</GuiXml>
