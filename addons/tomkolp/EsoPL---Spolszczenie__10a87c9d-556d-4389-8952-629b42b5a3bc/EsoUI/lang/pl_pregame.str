[SI_DELETE_CHARACTER] = "Usuń <<X:1>>"
[SI_DELETE_CHARACTER_CONFIRMATION_BUTTON] = "Usuń"
[SI_DELETE_CHARACTER_CONFIRMATION_TEXT] = "USUŃ"
[SI_DELETE_CHARACTER_DIALOG_GAMEPAD_CONTINUE] = "Kontynuuj"
[SI_DELETE_CHARACTER_DIALOG_GAMEPAD_TEXT] = "Możesz usunąć jeszcze <<1>> <<1[/postać/postacie]>>.\n\n|cff9633Usunięcie postaci sprawi, że utracisz przedmioty pochodzące ze sklepu koronowego lub otrzymane z kodów.|r\n\nJeżeli chcesz je zatrzymać, umieść te przedmioty w najbliższym banku.\n\nPrzedmioty kolekcjonerskie takie jak wierzchowce, chowańce, przebrania i dodatkowa zawartość konta nie zostaną utracone.\n\nZwykłe przedmioty będące na wyposażeniu lub w ekwipunku twojej postaci ulegną zniszczeniu."
[SI_DELETE_CHARACTER_DIALOG_GAMEPAD_TITLE] = "Usuń postać"
[SI_DELETE_CHARACTER_DIALOG_TEXT] = "|cff0000Usunięcie postaci sprawi, że utracisz przedmioty pochodzące ze sklepu koronowego lub otrzymane z kodów.|r\n\nPrzedmioty kolekcjonerskie takie jak wierzchowce, chowańce, przebrania oraz dodatkowa zawartość konta nie zostaną utracone. Zwykłe przedmioty będące na wyposażeniu lub w ekwipunku twojej postaci ulegną zniszczeniu. Jeżeli chcesz zatrzymać te przedmioty, umieść je w najbliższym banku.\n\nMożesz usunąć |cFFFFFF<<4>>|r <<4[/postać/postacie]>>. Dodatkowe usunięcia będą dostępne po pewnym czasie.\n\nCzy na pewno chcesz usunąć |cFFFFFF<<1>>|r? Aby potwierdzić, wpisz |cFFFFFF<<2>>|r poniżej i kliknij przycisk <<3>>."
[SI_DELETE_CHARACTER_DISABLED_GAMEPAD_TEXT] = "Obecnie nie możesz usunąć żadnej postaci.\n\nKolejne usunięcia będą dostępne po pewnym czasie. Spróbuj ponownie później."
[SI_DELETE_CHARACTER_DISABLED_GAMEPAD_TITLE] = "Nie można usunąć postaci"
[SI_DELETE_CHARACTER_DISABLED_TOOLTIP] = "Obecnie nie możesz usunąć żadnej postaci.\n\nKolejne usunięcia będą dostępne po pewnym czasie. Spróbuj ponownie później."
[SI_DELETE_CHARACTER_ENABLED_TOOLTIP] = "Obecnie możesz usunąć |cFFFFFF<<1>>|r <<1[/postać/postacie]>>.\n\nDodatkowe usunięcia będą dostępne po pewnym czasie."
[SI_DELETE_CHARACTER_GAMEPAD_DELETING] = "Usuwanie"
[SI_DELETE_CHARACTER_GAMEPAD_DELETING_CHARACTER] = "Usuwanie postaci..."
[SI_DELETE_CHARACTER_GAMEPAD_DIALOG_TEXT] = "Naciśnij przyciski, aby usunąć tę\npostać"
