<GuiXml>
    <Controls>
        <TopLevelControl name="ERUI_Container" mouseEnabled="false" movable="true" hidden="false">
            <Dimensions x="998" y="50"/>
            <Anchor point="BOTTOM" relativeTo="GuiRoot" relativePoint="BOTTOM" offsetX="4" offsetY="-197"/>
            <Controls></Controls>
        </TopLevelControl>

        <StatusBar name="ERUI_BarTemplate" orientation="HORIZONTAL" hidden="false" virtual="true">
            <Dimensions x="998" y="19"/>
            <Limits min="0" max="1"/>
            <Controls>
                <Texture name="$(parent)Backdrop" textureFile="EldenRingUI/Textures/ERBarBackdrop.dds" layer="BACKGROUND" level="0">
                    <Anchor point="TOPLEFT" offsetX="-0" offsetY="1"/>
                    <Anchor point="BOTTOMRIGHT" offsetX="0" offsetY="-1"/>
                </Texture>
				
                <Texture name="$(parent)CurrentHPIcon" tier="MEDIUM" level="2" textureFile="EldenRingUI/Textures/CurrentHPIconBoss.dds">
                    <Dimensions x="28" y="14"/>    
                </Texture>
				
                <Texture name="$(parent)Icon" tier="MEDIUM" level="1" textureFile="EldenRingUI/Textures/Angle.dds">
                    <Dimensions x="32" y="32"/> 
                    <Anchor point="RIGHT" relativeTo="$(parent)" relativePoint="LEFT" offsetX="10" offsetY="-1"/>
                </Texture>
				
                <Texture name="$(parent)Icon2" tier="MEDIUM" level="4" textureFile="EldenRingUI/Textures/Angle2.dds">
                    <Dimensions x="32" y="32"/> 
                    <Anchor point="RIGHT" relativeTo="$(parent)" relativePoint="RIGHT" offsetX="14" offsetY="3"/>
                </Texture>				
                
                <Label name="$(parent)BossName" color="FFFFFF" font="EldenRingUI/Fonts/Vollkorn-Regular_0.slug|22|soft-shadow-thick" verticalAlignment="BOTTOM" horizontalAlignment="LEFT">
                    <Anchor point="BOTTOMLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="3" offsetY="2"/>
                </Label>
                
                <Label name="$(parent)Percent" color="FFFFFF" font="EldenRingUI/Fonts/Vollkorn-Regular_0.slug|20|soft-shadow-thick" verticalAlignment="BOTTOM" horizontalAlignment="RIGHT">
                    <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)" relativePoint="TOPRIGHT" offsetX="-2" offsetY="2"/>
                </Label>
				
                <Label name="$(parent)HealthValue" color="FFFFFF" font="EldenRingUI/Fonts/Vollkorn-Regular_0.slug|20|soft-shadow-thick" verticalAlignment="BOTTOM" horizontalAlignment="RIGHT">
                    <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)Percent" relativePoint="BOTTOMLEFT" offsetX="-5" offsetY="0"/>
                </Label>
            </Controls>
        </StatusBar>
    </Controls>
</GuiXml>