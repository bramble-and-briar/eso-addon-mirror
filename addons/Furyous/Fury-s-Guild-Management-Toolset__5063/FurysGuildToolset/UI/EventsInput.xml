<GuiXml>
    <Controls>
        <!-- Text window for the Events tab: paste a sesh sign-up post, type someone's account,
             or check the Group Finder listing before it is created. Nothing happens until OK. -->
        <TopLevelControl name="FurysGuildToolset_EventsInput" hidden="true" mouseEnabled="true" movable="true" clampedToScreen="true" tier="HIGH">
            <Dimensions x="760" y="520" />
            <Anchor point="CENTER" />
            <Controls>
                <Backdrop name="$(parent)BG" centerColor="0F0E1F" edgeColor="4A3D99" alpha="1">
                    <AnchorFill />
                    <Edge edgeSize="2" />
                </Backdrop>
                <Label name="$(parent)Title" font="ZoFontWinH3">
                    <Anchor point="TOPLEFT" offsetX="16" offsetY="10" />
                </Label>
                <Button name="$(parent)Close" inherits="ZO_CloseButton">
                    <Anchor point="TOPRIGHT" offsetX="-10" offsetY="10" />
                    <OnClicked>FurysGuildToolset.Events:CloseInput()</OnClicked>
                    <OnMouseEnter>FurysGuildToolset.Report.ShowTip(self, "Close without saving (Esc)")</OnMouseEnter>
                    <OnMouseExit>FurysGuildToolset.Report.HideTip()</OnMouseExit>
                </Button>
                <Label name="$(parent)Hint" font="ZoFontGameSmall" color="B4B0D8">
                    <Dimensions x="728" />
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Title" relativePoint="BOTTOMLEFT" offsetY="14" />
                </Label>
                <Backdrop name="$(parent)Text" inherits="ZO_MultiLineEditBackdrop_Keyboard">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Hint" relativePoint="BOTTOMLEFT" offsetY="8" />
                    <Anchor point="BOTTOMRIGHT" offsetX="-16" offsetY="-54" />
                    <Controls>
                        <EditBox name="$(parent)Box" inherits="ZO_DefaultEditMultiLineForBackdrop" />
                    </Controls>
                </Backdrop>
                <!-- One-line box for Set account (1.22.0): suggestions drop down under it as you type. -->
                <Backdrop name="$(parent)Line" inherits="ZO_SingleLineEditBackdrop_Keyboard" hidden="true">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Hint" relativePoint="BOTTOMLEFT" offsetY="10" />
                    <Anchor point="RIGHT" offsetX="-16" />
                    <Controls>
                        <EditBox name="$(parent)Box" inherits="ZO_DefaultEditForBackdrop" defaultText="@account">
                            <OnEnter>FurysGuildToolset.Events:SubmitInput()</OnEnter>
                        </EditBox>
                    </Controls>
                </Backdrop>
                <Button name="$(parent)Cancel" inherits="ZO_DefaultButton" text="Cancel">
                    <Dimensions x="140" y="28" />
                    <Anchor point="BOTTOMRIGHT" offsetX="-16" offsetY="-14" />
                    <OnClicked>FurysGuildToolset.Events:CloseInput()</OnClicked>
                    <OnMouseEnter>FurysGuildToolset.Report.ShowTip(self, "Close without saving.")</OnMouseEnter>
                    <OnMouseExit>FurysGuildToolset.Report.HideTip()</OnMouseExit>
                </Button>
                <Button name="$(parent)OK" inherits="ZO_DefaultButton">
                    <Dimensions x="200" y="28" />
                    <Anchor point="RIGHT" relativeTo="$(parent)Cancel" relativePoint="LEFT" offsetX="-10" />
                    <OnClicked>FurysGuildToolset.Events:SubmitInput()</OnClicked>
                    <OnMouseEnter>FurysGuildToolset.Report.ShowTip(self, FurysGuildToolset.Events:InputTip())</OnMouseEnter>
                    <OnMouseExit>FurysGuildToolset.Report.HideTip()</OnMouseExit>
                </Button>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
