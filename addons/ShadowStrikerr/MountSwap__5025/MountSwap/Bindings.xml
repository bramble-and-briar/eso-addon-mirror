<Bindings>
  <Layer name="SI_KEYBINDINGS_LAYER_GENERAL">
    <Category name="MountSwap - Multi-Rider Favorites">
      <Action name="MOUNTSWAP_SLOT1">
        <Down>MountSwap:Slot(1)</Down>
      </Action>
      <Action name="MOUNTSWAP_SLOT2">
        <Down>MountSwap:Slot(2)</Down>
      </Action>
      <Action name="MOUNTSWAP_SLOT3">
        <Down>MountSwap:Slot(3)</Down>
      </Action>
      <Action name="MOUNTSWAP_SLOT4">
        <Down>MountSwap:Slot(4)</Down>
      </Action>
    </Category>
    <Category name="MountSwap - Single-Rider Favorites">
      <Action name="MOUNTSWAP_SLOT5">
        <Down>MountSwap:Slot(5)</Down>
      </Action>
      <Action name="MOUNTSWAP_SLOT6">
        <Down>MountSwap:Slot(6)</Down>
      </Action>
      <Action name="MOUNTSWAP_SLOT7">
        <Down>MountSwap:Slot(7)</Down>
      </Action>
      <Action name="MOUNTSWAP_SLOT8">
        <Down>MountSwap:Slot(8)</Down>
      </Action>
    </Category>
    <Category name="MountSwap - General">
      <Action name="MOUNTSWAP_GAMEPAD_MENU">
        <Down>MountSwap:Toggle()</Down>
      </Action>
      <Action name="MOUNTSWAP_PASSENGER">
        <Down>MountSwap:NearestPassenger()</Down>
      </Action>
      <Action name="MOUNTSWAP_RANDOM">
        <Down>MountSwap:Random()</Down>
      </Action>
      <Action name="MOUNTSWAP_MENU">
        <Down>MountSwap:Toggle()</Down>
      </Action>
    </Category>
  </Layer>
  <Layer name="MountSwapGamepad" allowFallthrough="false">
    <Category>
      <Action name="MOUNTSWAP_GP_UP" hideAction="true" rebindable="false" inheritsBindFrom="UI_SHORTCUT_INPUT_UP"><Down>return MountSwap:GamepadCommand("up")</Down></Action>
      <Action name="MOUNTSWAP_GP_DOWN" hideAction="true" rebindable="false" inheritsBindFrom="UI_SHORTCUT_INPUT_DOWN"><Down>return MountSwap:GamepadCommand("down")</Down></Action>
      <Action name="MOUNTSWAP_GP_LEFT" hideAction="true" rebindable="false" inheritsBindFrom="UI_SHORTCUT_INPUT_LEFT"><Down>return MountSwap:GamepadCommand("left")</Down></Action>
      <Action name="MOUNTSWAP_GP_RIGHT" hideAction="true" rebindable="false" inheritsBindFrom="UI_SHORTCUT_INPUT_RIGHT"><Down>return MountSwap:GamepadCommand("right")</Down></Action>
      <Action name="MOUNTSWAP_GP_SELECT" hideAction="true" rebindable="false" inheritsBindFrom="UI_SHORTCUT_PRIMARY"><Down>return MountSwap:GamepadCommand("select")</Down></Action>
      <Action name="MOUNTSWAP_GP_BACK" hideAction="true" rebindable="false" inheritsBindFrom="UI_SHORTCUT_NEGATIVE"><Down>return MountSwap:GamepadCommand("back")</Down></Action>
      <Action name="MOUNTSWAP_GP_SECONDARY" hideAction="true" rebindable="false" inheritsBindFrom="UI_SHORTCUT_SECONDARY"><Down>return MountSwap:GamepadCommand("secondary")</Down></Action>
      <Action name="MOUNTSWAP_GP_OPTIONS" hideAction="true" rebindable="false" inheritsBindFrom="UI_SHORTCUT_TERTIARY"><Down>return MountSwap:GamepadCommand("options")</Down></Action>
      <Action name="MOUNTSWAP_GP_DETAILS" hideAction="true" rebindable="false" inheritsBindFrom="UI_SHORTCUT_RIGHT_STICK"><Down>return MountSwap:GamepadCommand("details")</Down></Action>
      <Action name="MOUNTSWAP_GP_MULTI" hideAction="true" rebindable="false" inheritsBindFrom="UI_SHORTCUT_LEFT_SHOULDER"><Down>return MountSwap:GamepadCommand("multi")</Down></Action>
      <Action name="MOUNTSWAP_GP_SINGLE" hideAction="true" rebindable="false" inheritsBindFrom="UI_SHORTCUT_RIGHT_SHOULDER"><Down>return MountSwap:GamepadCommand("single")</Down></Action>
      <Action name="MOUNTSWAP_GP_PREVIOUSPAGE" hideAction="true" rebindable="false" inheritsBindFrom="UI_SHORTCUT_LEFT_TRIGGER"><Down>return MountSwap:GamepadCommand("previousPage")</Down></Action>
      <Action name="MOUNTSWAP_GP_NEXTPAGE" hideAction="true" rebindable="false" inheritsBindFrom="UI_SHORTCUT_RIGHT_TRIGGER"><Down>return MountSwap:GamepadCommand("nextPage")</Down></Action>
      <Action name="MOUNTSWAP_GP_TOGGLE" hideAction="true" rebindable="false" inheritsBindFrom="MOUNTSWAP_GAMEPAD_MENU"><Down>MountSwap:Toggle()</Down></Action>
      <Action name="MOUNTSWAP_GP_KEYBOARD_TOGGLE" hideAction="true" rebindable="false" inheritsBindFrom="MOUNTSWAP_MENU"><Down>MountSwap:Toggle()</Down></Action>
      <AllowAction name="TAKE_SCREENSHOT"/>
      <AllowAction name="TOGGLE_SYSTEM"/>
      <AllowAction name="TOGGLE_GAME_CAMERA_UI_MODE"/>
      <AllowAction name="TOGGLE_GAMEPAD_MODE"/>
      <AllowAction name="START_CHAT_ENTER"/>
      <AllowAction name="START_CHAT_SLASH"/>
    </Category>
  </Layer>
</Bindings>
