[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY304] = "Переслідування/цькування"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION101] = "Використовуйте це для повідомлення про будь-яку загрозу дітям. Це може призвести до подання заяви в поліцію."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION102] = "Використовуйте це, коли бачите ситуацію, яка може вимагати повідомлення федеральних правоохоронних органів."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION103] = "Використовуйте це, якщо ви спостерігаєте поведінку, яка, на вашу думку, може призвести до повідомлення поліції для перевірки стану здоров'я."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION104] = "У разі безпосередньої небезпеки, будь ласка, зверніться до місцевих екстрених служб на додаток до подання цього звіту."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION201] = "Використовуйте це для повідомлення про образливі або загрозливі висловлювання чи письмові повідомлення, що виражають упередження щодо певної групи, особливо за ознаками раси, національності, релігії чи сексуальної орієнтації."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION202] = "Використовуйте це для повідомлення про того, хто навмисно порушує ігрове середовище або досвід спільноти."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION203] = "Використовуйте це, повідомляючи про іншого гравця за надсилання одного й того ж повідомлення знову і знову в ТЕКСТОВОМУ ЧАТІ."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION204] = "Використовуйте це для повідомлення лише про ГОЛОСОВИЙ чат."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION205] = "Використовуйте це для повідомлення про ім'я персонажа або <<1>>, що є нецензурним або іншим чином образливим."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION301] = "Представники служби підтримки перевірятимуть ігрові журнали чату, щоб підтвердити деталі обговореної торгівлі та порівняти їх з ігровими журналами торгівлі."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION302] = "Використовуйте цю опцію, щоб повідомити про будь-якого гравця, який публікує особисту інформацію іншого гравця."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION303] = "Це включає, але не обмежується, використання сторонніх програм (ботів), зламаної зброї, wall hacks, збоїв ландшафту, scroll trolling тощо."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION304] = "Використовуйте цю опцію, коли гравці використовують текст або ігрові механіки для багаторазового виконання небажаних дій після прохання припинити."
