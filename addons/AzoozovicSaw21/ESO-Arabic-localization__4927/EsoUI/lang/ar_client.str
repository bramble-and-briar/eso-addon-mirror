[SI_HOUSING_PATH_SETTINGS_CONFORM_TO_GROUND_TOOLTIP] = ".ﻦﻜﻣﺃ ﻰﺘﻣ ﻲﺿﺭﺃ ﺢﻄﺳ ﺏﺮﻗﺄﺑ ﺮﺼﻨﻌﻟﺍ ﻖﺼﺘﻠﻳ ،ﻞﻴﻌﻔﺘﻟﺍ ﺪﻨﻋ\n\n.ﺽﺭﺍ ﺢﻄﺳ ﻕﻮﻓ ﻪﺋﺎﻘﺑ ﻊﻣ ﻪﺗﺄﺸﻧﺃ ﻱﺬﻟﺍ ﺭﺎﺴﻤﻟﺍ ﺮﺼﻨﻌﻟﺍ ﻊﺒﺘﻳ ،ﻞﻴﻄﻌﺘﻟﺍ ﺪﻨﻋ"
