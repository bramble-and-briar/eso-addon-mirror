[SI_ZONECOMPLETIONTYPE8] = "Світові події"
[SI_ZONECOMPLETIONTYPE9] = "Світові боси"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION1] = "|cffffffСюжетні завдання зони|r є основною сюжетною лінією для зони. Виконання цих завдань може нагородити вас очками навичок, досвідом, золотом та спорядженням."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION10] = "|cffffffВизначні місця|r — це цікаві місця у світі. Відкриття всіх визначних місць у зоні нагородить вас досягненням «Слідопит» для цієї зони."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION11] = "|cffffffКниги Бібліотеки Шалідора|r розкидані по всьому світу. Ці книги відрізняються своїм характерним фіолетовим світінням. Відкриття цих книг покращить ваш ранг у Гільдії магів та просуне відповідну лінію навичок."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION12] = "|cffffffКамені Мундуса|r — це об'єкти у світі, які надають благословення у вигляді тимчасового посилення гравця. Це посилення зберігатиметься, доки його не замінить інше благословення Каменя Мундуса."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION13] = "|cffffffПублічні підземелля|r — це відкриті світові підземелля, що зустрічаються по всьому Тамріелю та за його межами. Вони розроблені для груп із чотирьох гравців. Завершення різних частин публічних підземель може нагородити вас очком навичок, досвідом, золотом та спорядженням."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION14] = "|cffffffСтанції комплектів|r — це місця у світі, де ви можете створювати предмети з певними бонусами комплектів."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION2] = "|cffffffЦікаві місця|r — це самостійні історії, які досліджують лор, персонажів та локації в межах зони. Вони можуть нагородити вас досвідом, золотом та спорядженням."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION4] = "|cffffffВівтарі|r дозволяють безкоштовно та миттєво подорожувати між вівтарями, які були відкриті та розблоковані. Ви також можете подорожувати безпосередньо до будь-якого розблокованого вівтаря з будь-якої точки світу за невелику кількість золота."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION5] = "|cffffffЗаглибини|r — це підземелля, що зустрічаються по всьому світу, які можна проходити поодинці. Заглибини завжди містять один небесний уламок та боса, з якого падає спорядження з комплектів."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION6] = "|cffffffГрупові заглибини|r — це відкриті світові підземелля, що зустрічаються в Краглорні, спеціально розроблені для груп із чотирьох гравців. Групові заглибини завжди матимуть один небесний осколок та боса, з якого падає спорядження з комплектів."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION7] = "|cffffffНебесні уламки|r розкидані по всьому світу і їх можна впізнати за яскравим променем білого світла, що вони випромінюють. Відкриття трьох Небесних уламків надасть вам очко навичок, яке можна використати для розблокування або зміни нових здібностей."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION8] = "|cffffffСвітові події|r, такі як Темні якорі, — це дії, що відбуваються у світі, і найкраще їх долати групою шукачів пригод. Завершення Світової події може нагородити вас досвідом, золотом та спорядженням вищого рівня."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION9] = "|cffffffСвітові боси|r — це складні вороги, призначені для боротьби групою шукачів пригод. Перемога над світовим босом може нагородити вас спорядженням вищого рівня."
