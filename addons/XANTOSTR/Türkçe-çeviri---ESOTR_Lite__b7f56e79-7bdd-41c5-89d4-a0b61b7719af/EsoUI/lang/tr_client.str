[SI_SKILLS_SUBCLASSING_COMMIT_TEXT_SWAP_SKILL_LINE] = "Herhangi bir beceri hattını çıkardığınızda, o hatlarda harcadığınız Beceri Puanları iade edilir. Bu beceri hatlarındaki ilerlemeniz korunur, |cff1919ancak gelecekte bu beceri hatlarını yeniden kuşandığınızda Beceri Puanlarını tekrar dağıtmanız gerekir.|r"
[SI_SKILLS_SUBCLASSING_COMMIT_TEXT_TRAIN_SKILL] = "|cffffff<<1>>|r alt sınıfını seçerseniz, |cff1919<<2[it/them]>> alt sınıfını oluşturmayı durduramazsınız.|r Beceri rütbesi 50'ye ulaştığınızda, bir beceri satırı ustalaşılmış sayılır ve artık alt sınıf sınırınıza dahil edilmez. Herhangi bir zamanda, birincil sınıf beceri satırları, ustalaşılmış beceri satırları ve seçtiğiniz alt sınıf beceri satırları yeniden belirleme yoluyla donatılabilir veya donatılmayabilir."
