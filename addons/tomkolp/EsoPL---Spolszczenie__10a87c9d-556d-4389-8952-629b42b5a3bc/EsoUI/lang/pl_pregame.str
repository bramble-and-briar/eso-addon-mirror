[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY203] = "Spam"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY204] = "Wulgaryzmy na czacie głosowym"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY205] = "Nieprzyzwoita nazwa/<<1>>"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY301] = "Wyłudzanie"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY302] = "Doxing/Udostępnianie danych osobowych"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY303] = "Oszukiwanie/Wykorzystywanie"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY304] = "Szykanowanie/Zastraszanie"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION101] = "Użyj tej opcji, aby zgłosić wszelkie sprawy związane z zagrożeniem dla dzieci. Może to doprowadzić do złożenia raportu policyjnego."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION102] = "Użyj tej opcji, gdy widzisz sytuację, która wzrasta do poziomu wymagającego powiadomienia federalnych organów ścigania."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION103] = "Użyj tej opcji, jeśli obserwujesz zachowanie, które twoim zdaniem może być podstawą do powiadomienia policji w celu przeprowadzenia kontroli stanu zdrowia."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION104] = "W przypadku bezpośredniego zagrożenia, oprócz wypełnienia niniejszego raportu, należy skontaktować się z lokalnymi służbami ratunkowymi."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION201] = "Użyj tej opcji, aby zgłosić obraźliwe lub zawierające groźby wypowiedzi lub teksty, które wyrażają uprzedzenia wobec konkretnej grupy, zwłaszcza na tle rasowym, narodowościowym, religijnym lub orientacji seksualnej."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION202] = "Użyj tej opcji, aby zgłosić osobę, która celowo zakłóca środowisko gry lub doświadczenia społeczności."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION203] = "Użyj tej opcji, jeśli chcesz zgłosić innego gracza za wysyłanie w kółko tej samej wiadomości na CZACIE TEKSTOWYM."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION204] = "Użyj tej opcji, aby zgłosić sprawy dotyczące tylko czatu GŁOSOWEGO."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION205] = "Użyj tej opcji, aby zgłosić nazwę postaci lub <<1>>, która jest wulgarna lub w inny sposób obraźliwa."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION301] = "Społeczna Odpowiedzialność Biznesu oceni zapisy czatu z gry, aby potwierdzić szczegóły omawianej transakcji i porówna je z zapisami transakcji w grze."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION302] = "Użyj tej opcji, aby zgłosić gracza udostępniającego prywatne informacje na temat innego gracza."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION303] = "Dotyczy to używania programów osób trzecich (botów) oraz hakowania broni, hakowania ścian, błędów terenu, scroll trollingu itp."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION304] = "Użyj tej opcji, gdy gracze poproszeni o zaprzestanie nadal używają tekstu lub mechaniki gry do powtarzania niechcianych zachowań."
