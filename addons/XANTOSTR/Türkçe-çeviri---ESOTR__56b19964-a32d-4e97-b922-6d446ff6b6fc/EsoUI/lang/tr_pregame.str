[SI_GRAPHICS_OPTIONS_VIDEO_HDR_PEAK_BRIGHTNESS_TOOLTIP] = "En yüksek HDR parlaklığını ayarlar."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_SCENE_BRIGHTNESS] = "HDR Manzara Parlaklığı"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_SCENE_BRIGHTNESS_TOOLTIP] = "HDR Manzara parlaklığını ayarlar."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_SCENE_CONTRAST] = "HDR Manzara Karşıtlığı (Contrast)"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_SCENE_CONTRAST_TOOLTIP] = "HDR Manzara karşıtlığını ayarlar."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_UI_BRIGHTNESS] = "HDR Arayüz Parlaklığı"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_UI_BRIGHTNESS_TOOLTIP] = "HDR Arayüz parlaklığını ayarlar."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_UI_CONTRAST] = "HDR Arayüz Karşıtlığı (Contrast)"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_UI_CONTRAST_TOOLTIP] = "HDR Arayüz karşıtlığını ayarlar."
[SI_GRAPHICS_OPTIONS_VIDEO_MAC_AMBIENT_OCCLUSION_TYPE_TOOLTIP] = "Işık kaynağını engelleyen nesneleri hesaba katarak ışık ve gölgenin doğruluk oranını ayarlar. HBAO, SSAO ayarına göre daha çok performans tüketir fakat daha gerçekçi bir görünüm sunar. Seçeneği kapatmak oyun performansını iyileştirebilir."
[SI_GRAPHICS_OPTIONS_VIDEO_MAXIMUM_PARTICLE_SYSTEMS] = "Parçacık Sistemi"
[SI_GRAPHICS_OPTIONS_VIDEO_MAXIMUM_PARTICLE_SYSTEMS_RESTRICTION] = "Bu seçenek sadece çıkış yaptığınızda ya da harita değiştirdiğinizde uygulanır."
[SI_GRAPHICS_OPTIONS_VIDEO_MAXIMUM_PARTICLE_SYSTEMS_TOOLTIP] = "Oyunda belirli bir süre içerisinde kaç tane parçacık sisteminin görüntüleneceğini ayarlar. Ayarı düşürmek gösterilen parçacık sistemi sayısını düşürebilir fakat performansı yükseltebilir."
[SI_GRAPHICS_OPTIONS_VIDEO_OCCLUSION_CULLING_ENABLED] = "Yazılım Tıkanıklığı Ayıklama"
[SI_GRAPHICS_OPTIONS_VIDEO_OCCLUSION_CULLING_ENABLED_TOOLTIP] = "Tıkanıklık ayıklamasının etkin olup olmadığını kontrol eder. Tıkanıklık ayıklaması, GPU'nuzun iş yükünü azaltmak için CPU'nuzun daha fazla alanını kullanır. Kare hızınız GPU'nuz tarafından sınırlandırılıyorsa bunu kullanın."
[SI_GRAPHICS_OPTIONS_VIDEO_PARTICLE_SUPPRESSION_DISTANCE] = "Parçacık Mesafesi"
[SI_GRAPHICS_OPTIONS_VIDEO_PARTICLE_SUPPRESSION_DISTANCE_TOOLTIP] = "Hangi mesafede önemli parçacık efektlerinin görünemeyeceğini belirler. Yüksek ayarlarda bu tip parçacıklar uzaktayken daha fazla görünür fakat buna bağlı olarak performans kaybı yaşatabilir."
[SI_GRAPHICS_OPTIONS_VIDEO_PLANAR_WATER_REFLECTION_QUALITY] = "Yüzeysel Yansıtma Kalitesi"
[SI_GRAPHICS_OPTIONS_VIDEO_PLANAR_WATER_REFLECTION_QUALITY_TOOLTIP] = "Su yüzeyindeki beliren yansımaların detaylarını ve çözünürlüğünü ayarlar. Yüzey yansımaları yüksek kalite seçeneğidir ve aktif edildiğinde performansı düşürebilir. Su yüzey yansıtması kullanmıyorsa, ekran alanı yansıtmalarını kullanacaktır."
[SI_GRAPHICS_OPTIONS_VIDEO_PRESETS] = "Grafik Kalitesi"
[SI_GRAPHICS_OPTIONS_VIDEO_PRESETS_TOOLTIP] = "Oyunun grafiklerinin genel kalitesini ayarlar."
[SI_GRAPHICS_OPTIONS_VIDEO_RENDER_THREAD] = "Çok iş parçacıklı işleme"
[SI_GRAPHICS_OPTIONS_VIDEO_RENDER_THREAD_TOOLTIP] = "Render sürecinde performansı artırabilen ayrı bir sanal çekirdek kullanımını ayarlar."
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION] = "Çözünürlük"
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION_FORMAT] = "<<1>>x<<2>>"
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION_FORMAT_WIDE] = "<<1>>x<<2>> (GenişEkran)"
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION_TOOLTIP] = "Oyunun görüntüleneceği çözünürlüğü ayarlar. Çözünürlüğü artırmak aslına uygun bir görüntü sağlar fakat performansı düşürür. Seçilecek çözünürlük monitörün en boy oranına uygun olmalıdır."
[SI_GRAPHICS_OPTIONS_VIDEO_SCREENSPACE_WATER_REFLECTION_QUALITY] = "Ekran Alanı Yansıtma Kalitesi"
[SI_GRAPHICS_OPTIONS_VIDEO_SCREENSPACE_WATER_REFLECTION_QUALITY_TOOLTIP] = "Sü yüzeyinde gösterilecek ekran alanı yansımalarının kalitesini ayarlar. Bu seçeneği yüksek ayarda kullanmak yansımanın doğruluğunu artırır fakat performansı düşürebilir."
[SI_GRAPHICS_OPTIONS_VIDEO_SHADOWS] = "Gölge Kalitesi"
[SI_GRAPHICS_OPTIONS_VIDEO_SHADOWS_TOOLTIP] = "Oyunda görüntülenen gölge kalitesini belirler. Yüksek ayarları kullanmak gölgelerin çizildiği mesafeyi, doğruluklarını ve nesne sayısını etkiler. Kaliteyi düşürmek performansı artırabilir."
[SI_GRAPHICS_OPTIONS_VIDEO_SHOW_ADDITIONAL_ALLY_EFFECTS] = "İlave Dost Efektlerini Göster"
[SI_GRAPHICS_OPTIONS_VIDEO_SHOW_ADDITIONAL_ALLY_EFFECTS_TOOLTIP] = "Zindan ve açık alanlarda dostlarının kalıcı saldırı yetenekleri gösterir. Bu seçeneği kapatmak performansı artırabilir."
[SI_GRAPHICS_OPTIONS_VIDEO_SUB_SAMPLING] = "SubSampling Kalitesi"
[SI_GRAPHICS_OPTIONS_VIDEO_SUB_SAMPLING_TOOLTIP] = "Oyunun dünyayı gösterdiği çözünürlüğü belirler. Oyun arayüzü bu ayardan etkilenmez. Kaliteyi düşürmek performansı artırabilir."
[SI_GRAPHICS_OPTIONS_VIDEO_TEXTURE_RES] = "Doku Kalitesi"
[SI_GRAPHICS_OPTIONS_VIDEO_TEXTURE_RES_TOOLTIP] = "Oyunda kullanılan tüm nesnelerin doku kalitesini belirler.Daha yüksek ayarlar nesneleri, karakterleri ve çevreyi daha ayrıntılı gösterir fakat daha fazla video belleği gerektirir."
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_ENEMY_INTENSITY] = "Enemy VFX Intensity"
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_ENEMY_INTENSITY_TOOLTIP] = "Adjusts the visibility of visual effects cast by all enemy players."
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_FRIENDLY_INTENSITY] = "Friendly VFX Intensity"
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_FRIENDLY_INTENSITY_TOOLTIP] = "Adjusts the visibility of visual effects cast by all friendly players."
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_SELF_INTENSITY] = "Self VFX Intensity"
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_SELF_INTENSITY_TOOLTIP] = "Adjusts the visibility of visual effects cast by self."
[SI_GRAPHICS_OPTIONS_VIDEO_VIEW_DISTANCE] = "Görünen Uzaklık Ayarı"
[SI_GRAPHICS_OPTIONS_VIDEO_VIEW_DISTANCE_TOOLTIP] = "Oyundaki nesnelerin hangi mesafede görünmemeye başlayacağını ayarlar. Yüksek ayarlar daha gerçekçi ve zengin bir ortam sunar fakat performansı düşürebilir."
[SI_GRAPHICS_OPTIONS_VIDEO_VSYNC] = "Dikey Senkronizasyon (VSync)"
[SI_GRAPHICS_OPTIONS_VIDEO_VSYNC_TOOLTIP] = "Görüntü hızını monitörün yenileme hızıyla senkronize eder."
[SI_GRAPHICS_OPTIONS_VIDEO_WINDOWS_AMBIENT_OCCLUSION_TYPE_TOOLTIP] = "Işık kaynağını engelleyen nesneleri hesaba katarak ışık ve gölgenin doğruluk oranını ayarlar. LSAO, HBAO ayarına göre, HBAO ise SSAO ayarına göre daha çok performans tüketir fakat daha gerçekçi bir görünüm sunar. Screen Space GI, LSAO ayarını ek ışık hüzmelerini hesaba kattığı için geliştirir. Seçeneği kapatmak oyun performansını iyileştirebilir."
