[SI_STAT_TOOLTIP_MITIGATION] = "Resistance"
[SI_STAT_TOOLTIP_PHYSICAL_PENETRATION] = "Makes your Bleed, Disease, Physical, and Poison damaging attacks bypass your target's Physical Resistance."
[SI_STAT_TOOLTIP_PHYSICAL_RESIST] = "Decreases the amount of damage you take from Martial attacks. Affects Bleed, Disease, Physical, and Poison Damage."
[SI_STAT_TOOLTIP_POWER] = "Affects how much damage or healing your abilities and weapons cause if it is higher than your Spell Damage."
[SI_STAT_TOOLTIP_SPELL_CRITICAL] = "Gives your damage and healing abilities a chance to gain bonus potency if it is higher than your Weapon Critical."
[SI_STAT_TOOLTIP_SPELL_MITIGATION] = "Reduces the Damage you take from Spells."
[SI_STAT_TOOLTIP_SPELL_PENETRATION] = "Makes your Flame, Frost, Magic, and Shock damaging attacks bypass your target's Spell Resistance."
[SI_STAT_TOOLTIP_SPELL_POWER] = "Affects how much damage or healing your abilities and weapons cause if it is higher than your Weapon Damage."
[SI_STAT_TOOLTIP_SPELL_RESIST] = "Decreases the amount of damage you take from Magical attacks. Affects Flame, Frost, Magic, and Shock Damage."
[SI_STAT_TOOLTIP_STAMINA_MAX] = "Affects how many Stamina Abilities you can cast, as well as core combat mechanics such as Roll Dodge and Block. Increases the potency of many of your damaging, healing, and shield abilities if this resource is higher than your Max Magicka."
[SI_STAT_TOOLTIP_STAMINA_REGENERATION_COMBAT] = "When in combat, you recover <<1>> Stamina every two seconds."
