<Bindings>
    <Layer name="SI_KEYBINDINGS_LAYER_GENERAL">
        <Category name="Nirnhoned Metrics">
            <Action name="NIRNHONEDMETRICS_TOGGLE">
                <Down>NirnhonedMetrics.Toggle()</Down>
            </Action>
            <Action name="NIRNHONEDMETRICS_METRIC">
                <Down>NirnhonedMetrics.SwitchMetric()</Down>
            </Action>
            <Action name="NIRNHONEDMETRICS_MODE">
                <Down>NirnhonedMetrics.SwitchMode()</Down>
            </Action>
            <Action name="NIRNHONEDMETRICS_RESET">
                <Down>NirnhonedMetrics.Reset()</Down>
            </Action>
        </Category>
    </Layer>
</Bindings>
