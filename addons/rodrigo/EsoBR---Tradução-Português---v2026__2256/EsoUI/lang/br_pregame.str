[SI_ZONECOMPLETIONTYPE_DESCRIPTION1] = "|cffffffMissões de História da Zona|r são o arco principal da história para a zona. Ao completar estas missões, você pode ganhar pontos de habilidade, experiência, ouro e equipamentos."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION10] = "|cffffffLocais Macantes|r são pontos de interesse dentro do mundo. A descoberta de todos os Locais Marcantes em uma zona premiará a conquista de Patrulheiro dessa zona."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION11] = "|cffffffLivros da Biblioteca de Shalidor|r estão espalhados por todo o mundo. Estes livros são identificados por seu distinto brilho púrpura. A descoberta destes livros melhorará sua classificação no Guilda dos Magos e fará avançar a linha de habilidade associada."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION12] = "|cffffffPedras de Mundus|r são objetos no mundo que concedem uma vantagem sob a forma de um bônus ao jogador. Este bônus persistirá até ser substituído por uma outra pedra Mundus."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION13] = "As |cffffffMasmorras Públicas|r são masmorras do mundo aberto encontradas em Tamriel e além. Elas são projetadas para grupos de quatro jogadores. Completando diferentes partes das Masmorras Públicas, você pode receber um ponto de habilidade, experiência, ouro e equipamentos."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION14] = "|cffffffEstações de Conjuntos|r são locais no mundo onde você pode fabricar conjuntos de itens com bônus específicos."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION2] = "|cffffffPontos de Interesse|r são histórias auto-contidas que exploram a tradição, os personagens e os locais dentro de uma zona. Estes podem premiá-lo com experiência, ouro e equipamento."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION4] = "|cffffffSantuários|r permitem viagens livres e instantâneas entre os santuários que foram descobertos e desbloqueados. Você também pode viajar diretamente para qualquer santuário desbloqueado de qualquer lugar do mundo por uma pequena quantidade de ouro."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION5] = "|cffffffCovis|r são masmorras soláveis encontradas em todo o mundo. Elas sempre conterão um único Fragmento Celeste e um chefe que deixa cair algum equipamento de conjunto."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION6] = "|cffffCovis de Grupo|r são masmorras do mundo aberto encontradas em Cânion Desolado, especificamente projetadas para grupos de quatro jogadores. Os Covis de grupo terão sempre um único Fragmento Celeste e um chefe que deixa cair algum equipamento de conjunto."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION7] = "|cffffffFragmentos Celestes|r estão espalhados pelo mundo e podem ser identificados pelo feixe brilhante de luz branca que emanam. A descoberta de três Fragmentos Celestes lhe concederá um ponto de habilidade, que pode ser usado para desbloquear ou evoluir novas habilidades."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION8] = "|cffffffEventos de Mundo|r como as Âncoras Negras são atividades que ocorrem no mundo e que são melhor abordadas por um grupo de aventureiros. A realização de um Evento de Mundo pode premiá-lo com experiência, ouro e equipamentos de nível superior."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION9] = "|cffffffChefes de Mundo|r são inimigos difíceis destinados a serem enfrentados por um grupo de aventureiros. Derrotar um chefe de mundo pode lhe conceder um equipamento de nível superior."
