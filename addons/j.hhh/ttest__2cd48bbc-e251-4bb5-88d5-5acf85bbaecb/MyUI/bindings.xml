<Bindings>
	<Layer name="SI_KEYBINDINGS_LAYER_GENERAL">
		<Category name="|c4B8BFESatuve|r Xbox UI">
			<Action name="TOGGLE_MINIMAP">
				<Down>BUI.Vars.MiniMap=not BUI.Vars.MiniMap BUI.MiniMap.ReInit()</Down>
			</Action>
			<Action name="REGROUPER_REINVITE">
				<Down>BUI.RG_ReInvite()</Down>
			</Action>
			<Action name="REGROUPER_REGROUP">
				<Down>BUI.RG_ReGroup()</Down>
			</Action>
			<Action name="BUI_DISMISS_ALL">
				<Down>BUI.DismissPets()</Down>
			</Action>
		</Category>
		<Category name="|c4B8BFESatuve|r Xbox UI Statistics">
			<Action name="DISPLAY_DAMAGE_REPORT_WINDOW">
				<Down>BUI.Stats:Toggle()</Down>
			</Action>
			<Action name="POST_DAMAGE_RESULTS_TO_CHAT">
				<Down>BUI.Stats:Post()</Down>
			</Action>
			<Action name="RESET_FIGHT">
				<Down>BUI.Stats:Reset()</Down>
			</Action>
			<Action name="SHOW_LOG">
				<Down>BUI.ShowLog()</Down>
			</Action>
		</Category>
		<Category name="|c4B8BFESatuve|r Xbox UI Custom slots">
			<Action name="BUI_CUSTOMSLOT_1">
				<Down>BUI.UseCustomSlot(1)</Down>
			</Action>
			<Action name="BUI_CUSTOMSLOT_2">
				<Down>BUI.UseCustomSlot(2)</Down>
			</Action>
			<Action name="BUI_CUSTOMSLOT_3">
				<Down>BUI.UseCustomSlot(3)</Down>
			</Action>
			<Action name="BUI_CUSTOMSLOT_4">
				<Down>BUI.UseCustomSlot(4)</Down>
			</Action>
			<Action name="BUI_CUSTOMSLOT_5">
				<Down>BUI.UseCustomSlot(5)</Down>
			</Action>
			<Action name="BUI_CUSTOMSLOT_6">
				<Down>BUI.UseCustomSlot(6)</Down>
			</Action>
		</Category>
	</Layer>
	<Layer name="SI_KEYBINDINGS_LAYER_SIEGE">
		<Category name="">
			<Action name="SIEGECAMERATOGGLE">
				<Down>SiegeCameraToggle()</Down>
			</Action>
		</Category>
	</Layer>
<!-- Embedded AutoInteract gamepad-accessible bindings -->

    <Layer name="SI_KEYBINDINGS_LAYER_GENERAL">
        <Category name="AutoInteract">
            <Action name="AUTOINTERACT_TOGGLE_ENABLED">
                <Down>AutoInteract.ToggleMaster()</Down>
            </Action>
        </Category>
    </Layer>

<!-- Embedded BindAll gamepad-accessible bindings -->

	<Layer name="SI_KEYBINDINGS_LAYER_GENERAL">
		<Category name="BindAll">
			<Action name="BINDALL">
				<Down>BindAll.BindAllUnknown()</Down>
			</Action>
		</Category>
	</Layer>

<!-- Embedded Recharge gamepad-accessible bindings -->

  <Layer name="SI_KEYBINDINGS_LAYER_GENERAL">
    <Category name="SI_KEYBINDINGS_CATEGORY_RECHARGE">
      <Action name="RUN_RECHARGE">
        <Down>Recharge.Triggle_Action()</Down>
      </Action>
      <Action name="RUN_RECHARGE_SINGLE">
        <Down>Recharge.Keybind_Recharge()</Down>
      </Action>
      <Action name="RUN_REPAIR_SINGLE">
        <Down>Recharge.Keybind_Repair()</Down>
      </Action>
    </Category>
  </Layer>

</Bindings>
