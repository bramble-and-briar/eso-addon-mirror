[SI_GAMEPAD_DYEING_COMPANION_COLLECTIBLE_TAB_DESCRIPTION_LOCKED] = "Barwienie przebrania twojego aktywnego towarzysza jest aktualnie niedostępne. Opcja ta wymaga aktywnego towarzysza i zostanie odblokowana po przystąpieniu do subskrypcji ESO Plus."
