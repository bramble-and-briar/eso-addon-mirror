[SI_GUILD_LEAVE_WARNING] = "Czy na pewno chcesz opuścić: <<X:1>>|cffffff<<2>>|r?"
[SI_GUILD_LEAVE_WARNING_LEADER] = "Jesteś mistrzem gildii. Opuszczenie jej spowoduje przypisanie tej rangi osobie, która jest w gildii najdłużej i posiada najwyższą rangę.\n\nNa pewno chcesz opuścić: <<X:1>>|cffffff<<2>>|r?"
