[SI_GRAPHICS_OPTIONS_BACKGROUND_FPS_LIMIT] = "FPS-gräns"
[SI_GRAPHICS_OPTIONS_BACKGROUND_FPS_LIMIT_TOOLTIP] = "Anger den högsta FPS som spelet begränsas till när alternativet Begränsa FPS i bakgrunden är aktiverat och spelet körs i bakgrunden."
[SI_GRAPHICS_OPTIONS_CAP_CONSOLE_FRAMERATE_IN_MENUS] = "FPS-gräns i menyer"
[SI_GRAPHICS_OPTIONS_CAP_CONSOLE_FRAMERATE_IN_MENUS_TOOLTIP] = "Begränsar bildfrekvensen i de flesta menyer för att minska strömförbrukningen. Gäller bara när grafikläget Prestanda används."
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY] = "Grafik"
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY_TOOLTIP] = "Styr renderingskvaliteten."
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY_TOOLTIP_PS5] = "Kvalitet – Prioriterar upplösning framför bildfrekvens.\n\nPrestanda – Prioriterar bildfrekvens framför upplösning."
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY_TOOLTIP_XBSS] = "Kvalitet – Prioriterar upplösning och grafikfunktioner framför bildfrekvens.\n\nPrestanda – Prioriterar bildfrekvens framför upplösning och grafikfunktioner."
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY_TOOLTIP_XBSX] = "Kvalitet – Prioriterar upplösning framför bildfrekvens.\n\nPrestanda – Prioriterar bildfrekvens framför upplösning."
[SI_GRAPHICS_OPTIONS_ENERGY_SUSTAINABILITY_SCREEN_DIM_AND_RESOLUTION] = "Energisparläge vid inaktivitet"
[SI_GRAPHICS_OPTIONS_ENERGY_SUSTAINABILITY_SCREEN_DIM_AND_RESOLUTION_CONSOLE_TOOLTIP] = "Sänker upplösningen efter en stunds inaktivitet."
[SI_GRAPHICS_OPTIONS_ENERGY_SUSTAINABILITY_SCREEN_DIM_AND_RESOLUTION_PC_TOOLTIP] = "Dämpar skärmen och sänker upplösningen efter en stunds inaktivitet."
[SI_GRAPHICS_OPTIONS_USE_BACKGROUND_FPS_LIMIT] = "Begränsa FPS i bakgrunden"
[SI_GRAPHICS_OPTIONS_USE_BACKGROUND_FPS_LIMIT_TOOLTIP] = "Begränsar FPS när spelet körs i bakgrunden för att spara CPU- och GPU-resurser."
[SI_GRAPHICS_OPTIONS_VIDEO_ACTIVE_DISPLAY] = "Aktiv skärm"
[SI_GRAPHICS_OPTIONS_VIDEO_ACTIVE_DISPLAY_FORMAT] = "Skärm <<1>>"
[SI_GRAPHICS_OPTIONS_VIDEO_ACTIVE_DISPLAY_TOOLTIP] = "Anger vilken skärm spelet ska köras på."
[SI_GRAPHICS_OPTIONS_VIDEO_AMBIENT_OCCLUSION_TYPE] = "Ambient occlusion"
[SI_GRAPHICS_OPTIONS_VIDEO_ANTI_ALIASING] = "Kantutjämning"
[SI_GRAPHICS_OPTIONS_VIDEO_ANTI_ALIASING_TOOLTIP] = "Jämnar ut kanterna på objekt i världen. Om du stänger av detta kan prestandan öka, men objektens kanter blir då skarpare."
[SI_GRAPHICS_OPTIONS_VIDEO_BLOOM] = "Bloom-effekt"
[SI_GRAPHICS_OPTIONS_VIDEO_BLOOM_TOOLTIP] = "Ökar intensiteten i skenet runt ljuskällor. Om du stänger av detta ökar prestandan."
[SI_GRAPHICS_OPTIONS_VIDEO_CATEGORY_ABILITY] = "Förmåga"
[SI_GRAPHICS_OPTIONS_VIDEO_CATEGORY_DISPLAY] = "Skärm"
[SI_GRAPHICS_OPTIONS_VIDEO_CATEGORY_GRAPHICS] = "Grafik"
[SI_GRAPHICS_OPTIONS_VIDEO_CHARACTER_RESOLUTION] = "Upplösning för karaktärer"
[SI_GRAPHICS_OPTIONS_VIDEO_CHARACTER_RESOLUTION_TOOLTIP] = "Avgör antalet högupplösta figurer nära spelaren och på vilket avstånd de visas."
[SI_GRAPHICS_OPTIONS_VIDEO_CLUTTER_2D_QUALITY] = "Gräs"
[SI_GRAPHICS_OPTIONS_VIDEO_CLUTTER_2D_QUALITY_TOOLTIP] = "Avgör mängden gräs och markdetaljer i världen. Högre inställningar ökar avståndet på vilket gräs syns. Att sänka denna inställning kan öka prestandan."
[SI_GRAPHICS_OPTIONS_VIDEO_DEPTH_OF_FIELD_MODE] = "Skärpedjup"
[SI_GRAPHICS_OPTIONS_VIDEO_DEPTH_OF_FIELD_MODE_TOOLTIP] = "Avgör hur skärpedjupet ser ut. Det simulerar den fotografiska effekt som gör att avlägsna objekt blir oskarpa beroende på deras avstånd från objekt i förgrunden."
[SI_GRAPHICS_OPTIONS_VIDEO_DISPLAY_MODE] = "Visningsläge"
[SI_GRAPHICS_OPTIONS_VIDEO_DISPLAY_MODE_TOOLTIP] = "Anger spelets primära visningsläge."
[SI_GRAPHICS_OPTIONS_VIDEO_DISTORTION] = "Förvrängning"
[SI_GRAPHICS_OPTIONS_VIDEO_DISTORTION_TOOLTIP] = "Får vissa objekt i världen att visa förvrängningseffekter i sin närhet. Om du stänger av detta kan prestandan förbättras."
[SI_GRAPHICS_OPTIONS_VIDEO_DLSS_MODE] = "DLSS-läge"
[SI_GRAPHICS_OPTIONS_VIDEO_DLSS_MODE_TOOLTIP] = "Styr balansen mellan kvalitet och prestandaförbättring när NVIDIA DLSS är aktiverat."
[SI_GRAPHICS_OPTIONS_VIDEO_FSR_MODE] = "FSR-läge"
[SI_GRAPHICS_OPTIONS_VIDEO_FSR_MODE_TOOLTIP] = "Styr balansen mellan kvalitet och prestandaförbättring när Fidelity Fx Super Resolution (FSR) är aktiverat."
[SI_GRAPHICS_OPTIONS_VIDEO_GAMMA_ADJUSTMENT] = "Gammajustering"
[SI_GRAPHICS_OPTIONS_VIDEO_GAMMA_ADJUSTMENT_TOOLTIP] = "Justerar spelets övergripande gamma (ljusstyrka) utan att påverka prestandan. Ändra denna inställning om spelet ser för ljust eller för mörkt ut på din skärm."
[SI_GRAPHICS_OPTIONS_VIDEO_GOD_RAYS] = "Solstrålar"
[SI_GRAPHICS_OPTIONS_VIDEO_GOD_RAYS_TOOLTIP] = "Får solen att visa ljusstrålar beroende på dess vinkel i förhållande till kameran. Om du stänger av detta kan prestandan förbättras."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_ENABLED] = "HDR (beta)"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_ENABLED_TOOLTIP] = "Aktiverar HDR om spelet körs på en bildskärm som stöder HDR och har HDR aktiverat."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_MODE] = "HDR-läge"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_MODE_TOOLTIP] = "Anger HDR-läget."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_PEAK_BRIGHTNESS] = "Högsta HDR-ljusstyrka"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_PEAK_BRIGHTNESS_TOOLTIP] = "Anger den högsta HDR-ljusstyrkan."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_SCENE_BRIGHTNESS] = "HDR-ljusstyrka för scenen"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_SCENE_BRIGHTNESS_TOOLTIP] = "Anger HDR-ljusstyrkan för scenen."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_SCENE_CONTRAST] = "HDR-kontrast för scenen"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_SCENE_CONTRAST_TOOLTIP] = "Anger HDR-kontrasten för scenen."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_UI_BRIGHTNESS] = "HDR-ljusstyrka för gränssnittet"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_UI_BRIGHTNESS_TOOLTIP] = "Anger HDR-ljusstyrkan för gränssnittet."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_UI_CONTRAST] = "HDR-kontrast för gränssnittet"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_UI_CONTRAST_TOOLTIP] = "Anger HDR-kontrasten för gränssnittet."
[SI_GRAPHICS_OPTIONS_VIDEO_MAC_AMBIENT_OCCLUSION_TYPE_TOOLTIP] = "Förbättrar kvaliteten på skuggor och ljussättning genom att ta hänsyn till objekt som blockerar ljuset. HBAO är mer krävande än SSAO men ger ett mer realistiskt resultat. Om du stänger av denna inställning kan prestandan förbättras."
[SI_GRAPHICS_OPTIONS_VIDEO_MAXIMUM_PARTICLE_SYSTEMS] = "Maximalt antal partikelsystem"
[SI_GRAPHICS_OPTIONS_VIDEO_MAXIMUM_PARTICLE_SYSTEMS_RESTRICTION] = "Denna inställning tillämpas först när du loggar ut eller byter plats."
[SI_GRAPHICS_OPTIONS_VIDEO_MAXIMUM_PARTICLE_SYSTEMS_TOOLTIP] = "Avgör det totala antalet partikelsystem som visas i världen samtidigt. Att sänka denna inställning minskar antalet partikelsystem som visas, men kan förbättra prestandan."
[SI_GRAPHICS_OPTIONS_VIDEO_OCCLUSION_CULLING_ENABLED] = "Mjukvarubaserad occlusion culling"
[SI_GRAPHICS_OPTIONS_VIDEO_OCCLUSION_CULLING_ENABLED_TOOLTIP] = "Styr om occlusion culling är aktiverat. Occlusion culling använder mer av din processor för att minska grafikkortets arbetsbelastning. Använd detta om din bildfrekvens begränsas av ditt grafikkort."
[SI_GRAPHICS_OPTIONS_VIDEO_PARTICLE_SUPPRESSION_DISTANCE] = "Avstånd för partikeldämpning"
[SI_GRAPHICS_OPTIONS_VIDEO_PARTICLE_SUPPRESSION_DISTANCE_TOOLTIP] = "Justerar avståndet där mindre viktiga partiklar inte längre syns. Att öka detta visar fler sådana partiklar längre bort i världen, på bekostnad av prestandan."
[SI_GRAPHICS_OPTIONS_VIDEO_PLANAR_WATER_REFLECTION_QUALITY] = "Kvalitet på plana reflektioner"
[SI_GRAPHICS_OPTIONS_VIDEO_PLANAR_WATER_REFLECTION_QUALITY_TOOLTIP] = "Avgör upplösningen och detaljnivån för plana reflektioner på vattenytor. Plana reflektioner håller hög kvalitet men kan sänka prestandan när de är aktiverade. Vatten som inte kan använda plana reflektioner använder i stället skärmrymdsreflektioner."
[SI_GRAPHICS_OPTIONS_VIDEO_PRESETS] = "Grafikkvalitet"
[SI_GRAPHICS_OPTIONS_VIDEO_PRESETS_TOOLTIP] = "Anger spelets övergripande grafikkvalitet och justerar alla avancerade alternativ nedan. "
[SI_GRAPHICS_OPTIONS_VIDEO_RENDER_THREAD] = "Flertrådad rendering"
[SI_GRAPHICS_OPTIONS_VIDEO_RENDER_THREAD_TOOLTIP] = "Aktiverar en separat tråd för renderingsprocessen, vilket kan förbättra prestandan."
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION] = "Upplösning"
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION_FORMAT_WIDE] = "<<1>>x<<2>> (bred)"
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION_TOOLTIP] = "Anger den övergripande upplösning som spelet körs i. En högre upplösning ger en skarpare bild på bekostnad av prestandan. Den valda upplösningen bör motsvara bildskärmens bildförhållande."
[SI_GRAPHICS_OPTIONS_VIDEO_SCREENSPACE_WATER_REFLECTION_QUALITY] = "Kvalitet på skärmrymdsreflektioner"
[SI_GRAPHICS_OPTIONS_VIDEO_SCREENSPACE_WATER_REFLECTION_QUALITY_TOOLTIP] = "Avgör kvaliteten på skärmrymdsreflektioner på vattenytor. Att höja denna inställning gör reflektionerna mer exakta men kan sänka prestandan."
[SI_GRAPHICS_OPTIONS_VIDEO_SHADOWS] = "Skuggkvalitet"
[SI_GRAPHICS_OPTIONS_VIDEO_SHADOWS_TOOLTIP] = "Avgör kvaliteten på skuggorna i världen. Högre inställningar ökar skuggornas ritavstånd, skärpa och antalet objekt i världen som kastar skuggor. Att sänka kvaliteten kan förbättra prestandan."
[SI_GRAPHICS_OPTIONS_VIDEO_SHOW_ADDITIONAL_ALLY_EFFECTS] = "Visa fler effekter från allierade"
[SI_GRAPHICS_OPTIONS_VIDEO_SHOW_ADDITIONAL_ALLY_EFFECTS_TOOLTIP] = "Visar alla allierades varaktiga offensiva förmågor i fängelsehålor och i den öppna världen. Om du stänger av detta kan prestandan öka."
[SI_GRAPHICS_OPTIONS_VIDEO_SUB_SAMPLING] = "Kvalitet på undersampling"
[SI_GRAPHICS_OPTIONS_VIDEO_SUB_SAMPLING_TOOLTIP] = "Avgör upplösningen som spelet renderar världen i. Gränssnittet påverkas inte av denna inställning. Att sänka kvaliteten kan förbättra prestandan."
[SI_GRAPHICS_OPTIONS_VIDEO_TEXTURE_RES] = "Texturkvalitet"
[SI_GRAPHICS_OPTIONS_VIDEO_TEXTURE_RES_TOOLTIP] = "Styr kvaliteten på texturerna i världen genom att ändra texturernas storlek. Högre inställningar ger mer detaljer på objekt, figurmodeller och omgivningar, men kräver mer grafikminne för att spelet ska flyta smidigt. "
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_ENEMY_INTENSITY] = "Intensitet för fienders visuella effekter"
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_ENEMY_INTENSITY_TOOLTIP] = "Justerar synligheten för visuella effekter från alla fientliga spelare."
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_FRIENDLY_INTENSITY] = "Intensitet för allierades visuella effekter"
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_FRIENDLY_INTENSITY_TOOLTIP] = "Justerar synligheten för visuella effekter från alla allierade spelare."
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_SELF_INTENSITY] = "Intensitet för egna visuella effekter"
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_SELF_INTENSITY_TOOLTIP] = "Justerar synligheten för dina egna visuella effekter."
[SI_GRAPHICS_OPTIONS_VIDEO_VIEW_DISTANCE] = "Siktavstånd"
[SI_GRAPHICS_OPTIONS_VIDEO_VIEW_DISTANCE_TOOLTIP] = "Justerar avståndet där vissa objekt i spelet inte längre syns. Att öka detta ger en rikare och mer realistisk miljö på bekostnad av prestandan."
[SI_GRAPHICS_OPTIONS_VIDEO_VSYNC] = "Vertikal synkronisering"
[SI_GRAPHICS_OPTIONS_VIDEO_VSYNC_TOOLTIP] = "Hjälper till att förhindra bildrivning genom att synkronisera bildfrekvensen med bildskärmens uppdateringsfrekvens."
[SI_GRAPHICS_OPTIONS_VIDEO_WINDOWS_AMBIENT_OCCLUSION_TYPE_TOOLTIP] = "Förbättrar kvaliteten på skuggor och ljussättning genom att ta hänsyn till objekt som blockerar ljuset. LSAO är mer realistiskt och mer krävande än HBAO, som i sin tur är mer realistiskt och mer krävande än SSAO. Screen Space GI förbättrar LSAO genom att ta hänsyn till ytterligare ljusstudsar. Om du stänger av denna inställning kan prestandan förbättras."
