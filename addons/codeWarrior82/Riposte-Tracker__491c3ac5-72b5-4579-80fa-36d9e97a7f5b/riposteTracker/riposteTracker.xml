<GuiXml>
	<Controls>
		<TopLevelControl name="riptrack">
			<Dimensions x="80" y="80"/>
			<Anchor point="TOPLEFT" relativeTo="GuiRoot" relativePoint="TOPLEFT" offsetX="1400" offsetY="930"/>
			<Controls>
				<!-- [CHANGED] Switched from Label to Texture so the icon fills the box edge-to-edge without font baseline padding -->
				<Texture name="$(parent)Icon" inheritAlpha="true">
					<AnchorFill/>
				</Texture>
				<!-- [CHANGED] Auto-sized height with horizontal centering so Lua can dynamically center it using GetTextHeight() -->
				<Label name="$(parent)LabelMain" font="" inheritAlpha="true" color="FFFFFF" wrapMode="TRUNCATE" horizontalAlignment="CENTER">
					<Anchor point="CENTER" relativeTo="$(parent)" relativePoint="CENTER"/>
				</Label>
				<!-- [CHANGED] Anchored to TOPRIGHT so corner text scales cleanly at any size -->
				<Label name="$(parent)LabelCorner" font="" inheritAlpha="true" color="FFFFFF" wrapMode="TRUNCATE" verticalAlignment="TOP" horizontalAlignment="RIGHT">
					<Anchor point="TOPRIGHT" relativeTo="$(parent)" relativePoint="TOPRIGHT" offsetX="-2" offsetY="-2"/>
				</Label>
			</Controls>
		</TopLevelControl>
	</Controls>
</GuiXml>
