[SI_ACCESSIBILITY_OPTIONS_VOICE_CHAT_ACCESSIBILITY_TOOLTIP] = "Gdy to ustawienie jest włączone, przychodzące rozmowy głosowe będą poddawane transkrypcji, a tekst wychodzący będzie mógł zostać wyrenderowany głosowo i wysłany do aktywnego kanału rozmów głosowych."
