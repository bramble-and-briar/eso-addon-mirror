<Bindings>
    <Layer name="SI_KEYBINDINGS_LAYER_GENERAL">
        <Category name="Mansu's InstanceReset">
            <Action name="MANSUSINSTANCERESET_RESET">
                <Down>MansusInstanceReset.Reset()</Down>
            </Action>
            <Action name="MANSUSINSTANCERESET_TOGGLE">
                <Down>MansusInstanceReset.Toggle()</Down>
            </Action>
            <Action name="MANSUSINSTANCERESET_LEAVE">
                <Down>MansusInstanceReset.Leave()</Down>
            </Action>
        </Category>
    </Layer>
</Bindings>
