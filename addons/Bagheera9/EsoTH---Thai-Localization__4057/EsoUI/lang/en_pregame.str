[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION101] = "Use this to report any endangerment issue related to children. This may lead to a police report being filed."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION102] = "Use this when you see a situation that rises to the level that may require notifying Federal Law Enforcement authorities."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION103] = "Use this if you are observing behavior that you believe could result in police being notified to perform a wellness check."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION104] = "For immediate danger, please contact local emergency services in addition to filing this report."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION201] = "Use this to report abusive or threatening speech or writing that expresses prejudice against a particular group, especially on the basis of race, nationality, religion, or sexual orientation."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION202] = "Use this to report someone who is deliberately disrupting the game environment or community experience."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION203] = "Use this when reporting another player for sending the same message over and over in TEXT CHAT."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION204] = "Use this to report VOICE chat only."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION205] = "Use this to report a character name or <<1>> that is profane or otherwise offensive."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION301] = "CSRs will evaluate in-game chat logs to confirm the details of the trade discussed and compare it to the game trade logs."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION302] = "Use this option to report any player posting any other player's real life information."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION303] = "This includes, but is not limited to, using third party programs (bots), hacked weapons, wall hacks, terrain glitches, scroll trolling, etc."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION304] = "Use this option when players use text or game mechanics to repeatedly perform unwanted behaviors after being asked to stop."
