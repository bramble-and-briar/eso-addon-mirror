[SI_GUILD_HERALDRY_DESIGN_HEADER] = "Дизайн"
[SI_GUILD_HERALDRY_DIALOG_ACCEPT] = "Прийняти"
[SI_GUILD_HERALDRY_DIALOG_APPLY_CHANGES_DESCRIPTION] = "Застосування змін до геральдики гільдії оновить дизайн, що відображається на гербовій накидці гільдії. Зміни будуть відображені негайно і не можуть бути скасовані.\n\nБажаєте застосувати свої зміни?"
[SI_GUILD_HERALDRY_DIALOG_APPLY_CHANGES_PENDING_EXIT_DESCRIPTION] = "Ви намагаєтеся вийти, не застосувавши зміни.\n\nЗастосування змін до геральдики гільдії оновить дизайн, що відображається на гербовій накидці гільдії. Зміни будуть відображені негайно і не можуть бути скасовані.\n\nБажаєте застосувати свої зміни?"
[SI_GUILD_HERALDRY_DIALOG_APPLY_CHANGES_TITLE] = "Застосувати зміни"
[SI_GUILD_HERALDRY_DIALOG_BANKED_GOLD_HEADER] = "Баланс гільдії:"
[SI_GUILD_HERALDRY_DIALOG_CANCEL] = "Скасувати"
[SI_GUILD_HERALDRY_DIALOG_COST_HEADER] = "Вартість:"
[SI_GUILD_HERALDRY_DIALOG_PURCHASE_DESCRIPTION] = "Після придбання дизайн цієї гільдії з'явиться на гербовій накидці гільдії.\n\nУчасники можуть придбати гербову накидку, відвідавши крамницю гільдії."
