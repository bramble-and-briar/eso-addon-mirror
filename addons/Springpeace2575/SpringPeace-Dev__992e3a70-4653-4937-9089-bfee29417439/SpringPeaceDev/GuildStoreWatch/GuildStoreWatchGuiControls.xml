<GuiXml>
    <Controls>
        <Control name="GSWFilterRowTemplate" virtual="true" inherits="ZO_GamepadMenuEntryControlSizedTemplate">
            <Dimensions x="328" y="54" />
            <Controls>
                <Backdrop name="$(parent)Bg">
                    <AnchorFill />
                </Backdrop>
                <Label name="$(parent)Label" font="ZoFontGamepad27" wrapMode="ELLIPSIS" verticalAlignment="CENTER" horizontalAlignment="LEFT">
                    <Anchor point="TOPLEFT" offsetX="16" offsetY="0" />
                    <Anchor point="BOTTOMRIGHT" offsetX="-12" offsetY="0" />
                </Label>
            </Controls>
        </Control>

        <Control name="GSWResultRowTemplate" virtual="true" inherits="ZO_GamepadMenuEntryControlSizedTemplate">
            <Dimensions x="958" y="76" />
            <Controls>
                <Backdrop name="$(parent)Bg">
                    <AnchorFill />
                </Backdrop>

                <Texture name="$(parent)CollectibleIcon" textureFile="EsoUI/Art/Inventory/Gamepad/gp_inventory_icon_can_learn.dds" hidden="false">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="14" offsetY="24" />
                    <Dimensions x="28" y="28" />
                </Texture>

                <Texture name="$(parent)ItemIcon" hidden="false">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="60" offsetY="24" />
                    <Dimensions x="28" y="28" />
                </Texture>

                <Label name="$(parent)Label" font="ZoFontGamepad27" wrapMode="ELLIPSIS" verticalAlignment="TOP" horizontalAlignment="LEFT">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="96" offsetY="24" />
                    <Dimensions x="430" y="28" />
                </Label>

                <Label name="$(parent)Name" inherits="ZO_GamepadInteractiveSortFilterListRowLabel" maxLineCount="2">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Label" relativePoint="BOTTOMLEFT" offsetX="0" offsetY="0" />
                    <Dimensions x="430" y="20" />
                </Label>

                <Label name="$(parent)PriceLabel" font="ZoFontGamepad27" wrapMode="ELLIPSIS" verticalAlignment="TOP" horizontalAlignment="RIGHT">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="498" offsetY="24" />
                    <Dimensions x="150" y="28" />
