[SI_DECONSTRUCTACTIONNAME_CONFIRMMULTIPLE0] = "Ви впевнені, що хочете очистити всі вибрані |cffffff<<1>>|r неочищені матеріали?"
[SI_DECONSTRUCTACTIONNAME_CONFIRMMULTIPLE1] = "Ви впевнені, що хочете видобути ці |cffffff<<1>>|r предмети?"
[SI_DECONSTRUCTACTIONNAME_CONFIRMMULTIPLE2] = "Ви впевнені, що хочете розібрати ці |cffffff<<1>>|r предмети?"
