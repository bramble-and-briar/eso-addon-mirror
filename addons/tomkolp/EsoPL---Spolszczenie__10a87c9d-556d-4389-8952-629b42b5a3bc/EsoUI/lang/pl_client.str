[SI_STAT_TOOLTIP_ARMOR_RATING] = "Redukuje obrażenia otrzymywane od ataków fizycznych."
[SI_STAT_TOOLTIP_ATTACK_POWER] = "Wpływa na ilość zadawanych obrażeń przez ataki fizyczne."
[SI_STAT_TOOLTIP_CRITICAL_RESISTANCE] = "Zmniejsza otrzymane obrażenia, gdy padniesz ofiarą krytycznego uderzenia."
[SI_STAT_TOOLTIP_CRITICAL_STRIKE] = "Daje szansę na uzyskanie dodatkowej mocy zdolności zadających obrażenia i leczących, jeśli jest ona wyższa niż wskaźnik krytyczny zaklęć."
[SI_STAT_TOOLTIP_DIMINISHING_RETURNS] = "|t16:16:EsoUI/Art/Stats/diminishingReturns_icon.dds|tKiedy dana statystyka jest przeładowana, coraz trudniej jest ją podnieść. Zastanów się nad zmianą wyposażenia, umiejętności lub atrybutów, aby bardziej równomiernie rozłożyć statystyki."
[SI_STAT_TOOLTIP_HEALTH_MAX] = "Wpływa na ilość obrażeń, jakie możesz otrzymać przed śmiercią. Zwiększa siłę działania niektórych zdolności zadających obrażenia, leczących oraz osłaniających."
[SI_STAT_TOOLTIP_HEALTH_REGENERATION_COMBAT] = "Kiedy walczysz, odzyskujesz <<1>> zdrowia co dwie sekundy."
[SI_STAT_TOOLTIP_HEALTH_REGENERATION_IDLE] = "Kiedy nie walczysz, odzyskujesz <<1>> zdrowia co dwie sekundy."
[SI_STAT_TOOLTIP_MAGICKA_MAX] = "Wpływa na liczbę zdolności magicznych, których możesz użyć. Zwiększa skuteczność wielu zdolności zadających obrażenia, leczących i osłaniających, jeśli zasób ten jest wyższy niż maksymalna kondycja."
[SI_STAT_TOOLTIP_MAGICKA_REGENERATION_COMBAT] = "Kiedy walczysz, odzyskujesz <<1>> many co dwie sekundy."
[SI_STAT_TOOLTIP_MAGICKA_REGENERATION_IDLE] = "Kiedy nie walczysz, odzyskujesz <<1>> many co dwie sekundy."
[SI_STAT_TOOLTIP_MITIGATION] = "Odporność"
[SI_STAT_TOOLTIP_PHYSICAL_PENETRATION] = "Sprawia, że twoje ataki zadające obrażenia fizyczne oraz od krwawienia, choroby i trucizny przebijają odporność fizyczną twojego celu."
[SI_STAT_TOOLTIP_PHYSICAL_RESIST] = "Zmniejsza ilość obrażeń otrzymywanych od fizycznych ataków. Wpływa na obrażenia fizyczne oraz od krwawienia, choroby i trucizny."
[SI_STAT_TOOLTIP_POWER] = "Wpływa na ilość obrażeń lub leczenia powodowanych przez twoje bronie i zdolności, jeśli jest ona wyższa niż obrażenia zaklęć."
[SI_STAT_TOOLTIP_SPELL_CRITICAL] = "Daje szansę na uzyskanie dodatkowej mocy zdolności zadających obrażenia i leczących, jeśli jest ona wyższa niż wskaźnik krytyczny broni."
[SI_STAT_TOOLTIP_SPELL_MITIGATION] = "Redukuje obrażenia otrzymywane od zaklęć."
[SI_STAT_TOOLTIP_SPELL_PENETRATION] = "Sprawia, że twoje ataki zadające obrażenia magiczne oraz od ognia, mrozu i porażenia przebijają odporność magiczną twojego celu."
[SI_STAT_TOOLTIP_SPELL_POWER] = "Wpływa na ilość obrażeń lub leczenia powodowanych przez twoje bronie i zdolności, jeśli jest ona wyższa niż obrażenia broni."
[SI_STAT_TOOLTIP_SPELL_RESIST] = "Zmniejsza ilość obrażeń otrzymywanych od magicznych ataków. Wpływa na obrażenia magiczne oraz od ognia, mrozu i porażenia."
[SI_STAT_TOOLTIP_STAMINA_MAX] = "Wpływa na liczbę zdolności opartych na kondycji, których możesz użyć oraz na podstawowe mechaniki walki, takie jak przewrót i blok. Zwiększa skuteczność wielu zdolności zadających obrażenia, leczących i osłaniających, jeśli zasób ten jest wyższy niż maksymalna mana."
[SI_STAT_TOOLTIP_STAMINA_REGENERATION_COMBAT] = "Kiedy walczysz, odzyskujesz <<1>> kondycji co dwie sekundy."
[SI_STAT_TOOLTIP_STAMINA_REGENERATION_IDLE] = "Kiedy nie walczysz, odzyskujesz <<1>> kondycji co dwie sekundy."
[SI_STAT_TOOLTIP_WEAPON_POWER] = "Wpływa na ilość obrażeń lub leczenia powodowanych przez twoje bronie i zdolności opartych na kondycji."
