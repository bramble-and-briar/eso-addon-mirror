[SI_ZONECOMPLETIONTYPE8] = "Світові події"
[SI_ZONECOMPLETIONTYPE9] = "Світові боси"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION1] = "|cffffffСюжетні завдання зони|r є основною сюжетною лінією для зони. Виконання цих завдань може нагородити вас очками навичок, досвідом, золотом та спорядженням."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION10] = "|cffffffВизначні місця|r є цікавими місцями у світі. Відкриття всіх визначних місць у зоні нагородить вас досягненням «Першопроходець» цієї зони."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION11] = "|cffffffКниги Бібліотеки Шалідора|r розкидані по всьому світу. Ці книги можна впізнати за їхнім характерним фіолетовим світінням. Відкриття цих книг покращить ваш ранг у Гільдії магів та просуне відповідну лінію навичок."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION12] = "|cffffffКамені Мундуса|r є об'єктами у світі, які надають благословення у вигляді тимчасового посилення гравця. Це посилення зберігатиметься, доки його не замінить інше благословення Каменя Мундуса."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION13] = "|cffffffПублічні підземелля|r — це відкриті підземелля, що зустрічаються по всьому Тамріелю та за його межами. Вони розроблені для груп із чотирьох гравців. Виконання різних частин публічних підземель може нагородити вас очком навичок, досвідом, золотом та спорядженням."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION14] = "|cffffffСтанції наборів|r — це місця у світі, де ви можете створювати предмети з певними бонусами від наборів."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION2] = "|cffffffЦікаві місця|r — це самостійні історії, що досліджують лор, персонажів та локації в межах зони. Вони можуть нагородити вас досвідом, золотом та спорядженням."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION4] = "|cffffffДорожні святилища|r дозволяють безкоштовно та миттєво подорожувати між дорожніми святилищами, які були відкриті та розблоковані. Ви також можете подорожувати безпосередньо до будь-якого розблокованого дорожнього святилища з будь-якої точки світу за невелику кількість золота."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION5] = "|cffffffПідземелля|r — це підземелля, які можна проходити наодинці, розкидані по всьому світу. Підземелля завжди містять один небесний осколок і боса, який скидає спорядження з комплектів."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION6] = "|cffffffГрупові підземелля|r — це відкриті підземелля, знайдені в Краглорні, спеціально розроблені для груп з чотирьох гравців. Групові підземелля завжди матимуть один небесний осколок і боса, який скидає спорядження з комплектів."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION7] = "|cffffffНебесні осколки|r розкидані по всьому світу і їх можна ідентифікувати за яскравим променем білого світла, яке вони випромінюють. Відкриття трьох небесних осколків надасть вам очко навичок, яке можна використовувати для розблокування або зміни нових здібностей."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION8] = "|cffffffСвітові події|r, такі як Темні якорі, — це дії, що відбуваються у світі, які найкраще долати групою шукачів пригод. Завершення світової події може нагородити вас досвідом, золотом та спорядженням вищого рівня."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION9] = "|cffffffСвітові боси|r — це складні вороги, призначені для боротьби групою шукачів пригод. Перемога над світовим босом може нагородити вас спорядженням вищого рівня."
[SI_ZONECOMPLETIONTYPE_PROGRESSDESCRIPTION10] = "Відкрито <<1>> визначних місць у <<2>>"
[SI_ZONECOMPLETIONTYPE_PROGRESSDESCRIPTION11] = "Відкрито <<1>> книг Бібліотеки Шалідора у <<2>>"
[SI_ZONECOMPLETIONTYPE_PROGRESSDESCRIPTION12] = "Відкрито <<1>> каменів Мундуса у <<2>>"
[SI_ZONECOMPLETIONTYPE_PROGRESSDESCRIPTION13] = "Завершено <<1>> публічних підземель у <<2>>"
[SI_ZONECOMPLETIONTYPE_PROGRESSDESCRIPTION14] = "Відкрито <<1>> станцій комплектів у <<2>>"
[SI_ZONECOMPLETIONTYPE_PROGRESSDESCRIPTION2] = "Завершено <<1>> цікавих місць у <<2>>"
[SI_ZONECOMPLETIONTYPE_PROGRESSDESCRIPTION4] = "Відкрито <<1>> святилищ у <<2>>"
[SI_ZONECOMPLETIONTYPE_PROGRESSDESCRIPTION5] = "Завершено <<1>> підземель у <<2>>"
