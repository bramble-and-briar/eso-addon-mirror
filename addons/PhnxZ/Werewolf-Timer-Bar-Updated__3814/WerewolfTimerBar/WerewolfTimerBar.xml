<GuiXml> 
   <Controls>
		<TopLevelControl name="WerewolfTimerBarWindow" clampedToScreen="true" allowBringToTop="false" mouseEnabled="true" hidden="true" tier="LOW" layer="CONTROLS" inherits="ZO_HUDManager_Element">	
			<Dimensions x="500" y="100"/>
			<Anchor point="TOPLEFT" relativeTo="GuiRoot" relativePoint="CENTER" offsetX="0" offsetY="0"/>
			<Controls>
 				<Backdrop name="$(parent)_Backdrop" edgeColor="000000" centerColor="000000" alpha="0.4"  hidden="false">
					<Dimensions x="305" y="50"/>
					<Anchor point="TOPLEFT"  relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="0" offsetY="1"/>
					<Edge edgeSize="2"/>
				</Backdrop>
				<Button name="$(parent)_UltimateBlockButton" hidden="false" mouseEnabled="true" tier="HIGH" layer="CONTROLS">
					<Dimensions x="20" y="20"/>
					<Anchor point="TOPLEFT"  relativeTo="$(parent)_Backdrop" relativePoint="TOPLEFT" offsetX="6" offsetY="3"/>
					<Textures normal="esoui/art/miscellaneous/unlocked_up.dds"
						pressed="esoui/art/miscellaneous/locked_up.dds"
						mouseOver="esoui/art/miscellaneous/unlocked_up.dds"/>
					<OnClicked>
						WerewolfTimerBar.ClickUltimateBlockButton(self)
					</OnClicked>
				</Button>
				<Label name="$(parent)_Label" font="ZoFontWinH1" color="ffffff" text="Werewolf Form" verticalAlignment="CENTER" horizontalAlignment="CENTER"  alpha="1">			
					<Dimensions x="300" y="20"/>
					<Anchor point="TOP" relativeTo="$(parent)_Backdrop" relativePoint="TOP" offsetX="0" offsetY="3"/>
				</Label>
				<StatusBar name="$(parent)_StatusBar" color="8A2BE2" alpha="1" hidden="false">
					<Dimensions x="300" y="20"/>
					<Anchor point="TOPLEFT" relativeTo="$(parent)_UltimateBlockButton" relativePoint="BOTTOMLEFT" offsetX="0" offsetY="2"/>
					<Limits min="100" max="300"/>
				</StatusBar>
				<Label name="$(parent)_StatusBarLabel" font="ZoFontWinH1" color="ffffff" text="Ultimate" verticalAlignment="CENTER" horizontalAlignment="CENTER"  alpha="1">			
					<Dimensions x="300" y="20"/>
					<Anchor point="CENTER" relativeTo="$(parent)_StatusBar" relativePoint="CENTER" offsetX="0" offsetY="0"/>
				</Label>
				<StatusBar name="$(parent)_FuryBar" color="8A2BE2" alpha="1" hidden="false">
					<Dimensions x="300" y="20"/>
					<Anchor point="TOPLEFT" relativeTo="$(parent)_StatusBar" relativePoint="BOTTOMLEFT" offsetX="0" offsetY="0"/>
					<Limits min="100" max="300"/>
				</StatusBar>
				<Label name="$(parent)_FuryBarLabel" font="ZoFontWinH1" color="ffffff" text="Fury" verticalAlignment="CENTER" horizontalAlignment="CENTER"  alpha="1">			
					<Dimensions x="300" y="20"/>
					<Anchor point="CENTER" relativeTo="$(parent)_FuryBar" relativePoint="CENTER" offsetX="0" offsetY="0"/>
				</Label>
			</Controls>
		</TopLevelControl>
	</Controls>
</GuiXml>