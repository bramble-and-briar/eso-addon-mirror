[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION205] = ".ﻖﺋ ﺮﻴﻏ ﻭﺃ ﺎﺸًﺣﺎﻓ <<1>> ﻭﺃ ﺔﻴﺼﺨﺸﻟﺍ ﻢﺳﺍ ﻥﻮﻜﻳ ﺎﻣﺪﻨﻋ ﺭﺎﻴﺨﻟﺍ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION301] = ".ﺔﺒﻌﻠﻟﺍ ﺕﺠﺴﺑ ﺎﻬﺘﻧﺭﺎﻘﻣﻭ ﻝﻭﺍﺪﺘﻟﺍ ﺕﺎﻴﻠﻤﻋ ﻞﻴﺻﺎﻔﺗ ﻦﻣ ﻖﻘﺤﺘﻠﻟ ﺔﺒﻌﻠﻟﺍ ﻞﺧﺍﺩ ﺔﺷﺩﺭﺪﻟﺍ ﺕﺠﺳ ﺀﻤﻌﻟﺍ ﺔﻣﺪﺧ ﻮﻔﻇﻮﻣ ﻊﺟﺍﺮﻴُﺳ"
