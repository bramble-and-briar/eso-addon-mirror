[SI_INTERFACE_OPTIONS_CAMERA_THIRD_PERSON_SIEGE_WEAPONRY] = "Siege Weaponry"
[SI_INTERFACE_OPTIONS_CAMERA_THIRD_PERSON_SIEGE_WEAPONRY_TOOLTIP] = "Controls the camera mode used when aiming Siege Weapons. Free Mode provides a more open feel while aiming, while Constrained Mode limits the camera to the area at which you are aiming."
