[SI_INTERFACE_OPTIONS_CHAT_BUBBLES_FADE_RATE] = "Fade Rate"
[SI_INTERFACE_OPTIONS_CHAT_BUBBLES_FADE_RATE_TOOLTIP] = "Controls how quickly a chat bubble will fade after appearing."
[SI_INTERFACE_OPTIONS_CHAT_BUBBLES_ONLY_KNOWN] = "Only Known Players"
[SI_INTERFACE_OPTIONS_CHAT_BUBBLES_ONLY_KNOWN_TOOLTIP] = "Displays a chat bubble only for players that are in any of your guilds, in your contact list, or in your group."
