[SI_STAT_TOOLTIP_CRITICAL_RESISTANCE] = "Зменшує шкоду, яку ви отримаєте, якщо станете жертвою критичного удару."
[SI_STAT_TOOLTIP_CRITICAL_STRIKE] = "Надає вашим здібностям шкоди та зцілення шанс отримати бонус до потужності, якщо він вищий за ваш критичний удар заклинаннями."
[SI_STAT_TOOLTIP_DIMINISHING_RETURNS] = "|t16:16:EsoUI/Art/Stats/diminishingReturns_icon.dds|tКоли показник перевантажений, його стає дедалі важче підвищити. Розгляньте можливість зміни спорядження, навичок або атрибутів, щоб рівномірніше розподілити свої показники."
[SI_STAT_TOOLTIP_HEALTH_MAX] = "Впливає на кількість шкоди, яку ви можете отримати до смерті. Збільшує ефективність деяких ваших здібностей до шкоди, лікування та щитів."
[SI_STAT_TOOLTIP_HEALTH_REGENERATION_COMBAT] = "Під час бою ви відновлюєте <<1>> здоров'я кожні дві секунди."
[SI_STAT_TOOLTIP_HEALTH_REGENERATION_IDLE] = "Поза боєм ви відновлюєте <<1>> здоров'я кожні дві секунди."
[SI_STAT_TOOLTIP_MAGICKA_MAX] = "Впливає на кількість здібностей Магіки, які ви можете застосувати. Збільшує ефективність багатьох ваших здібностей до шкоди, лікування та щитів, якщо цей ресурс вищий за вашу максимальну витривалість."
[SI_STAT_TOOLTIP_MAGICKA_REGENERATION_COMBAT] = "Під час бою ви відновлюєте <<1>> Магіки кожні дві секунди."
[SI_STAT_TOOLTIP_MAGICKA_REGENERATION_IDLE] = "Поза боєм ви відновлюєте <<1>> Магіки кожні дві секунди."
[SI_STAT_TOOLTIP_MITIGATION] = "Опір"
[SI_STAT_TOOLTIP_PHYSICAL_PENETRATION] = "Дозволяє вашим атакам, що завдають шкоди від кровотечі, хвороби, фізичної шкоди та отрути, ігнорувати фізичний опір цілі."
[SI_STAT_TOOLTIP_PHYSICAL_RESIST] = "Зменшує кількість шкоди, яку ви отримуєте від бойових атак. Впливає на шкоду від кровотечі, хвороби, фізичну шкоду та отруту."
[SI_STAT_TOOLTIP_POWER] = "Впливає на обсяг шкоди або зцілення, які завдають ваші здібності та зброя, якщо він вищий за вашу Силу заклинань."
[SI_STAT_TOOLTIP_SPELL_CRITICAL] = "Надає вашим здібностям, що завдають шкоди та зцілюють, шанс отримати бонус до ефективності, якщо він вищий за ваш Критичний удар зброєю."
[SI_STAT_TOOLTIP_SPELL_MITIGATION] = "Зменшує шкоду, яку ви отримуєте від заклинань."
[SI_STAT_TOOLTIP_SPELL_PENETRATION] = "Дозволяє вашим атакам, що завдають шкоди Вогнем, Морозом, Магією та Шоком, ігнорувати Опір заклинанням вашої цілі."
[SI_STAT_TOOLTIP_SPELL_POWER] = "Впливає на обсяг шкоди або зцілення, які завдають ваші здібності та зброя, якщо він вищий за вашу Силу зброї."
[SI_STAT_TOOLTIP_SPELL_RESIST] = "Зменшує обсяг шкоди, яку ви отримуєте від магічних атак. Впливає на шкоду Вогнем, Морозом, Магією та Шоком."
[SI_STAT_TOOLTIP_STAMINA_MAX] = "Впливає на кількість здібностей Витривалості, які ви можете застосувати, а також на основні бойові механіки, такі як Перекат та Блок. Збільшує ефективність багатьох ваших здібностей, що завдають шкоди, зцілюють та надають щити, якщо цей ресурс вищий за вашу Максимальну Магіку."
