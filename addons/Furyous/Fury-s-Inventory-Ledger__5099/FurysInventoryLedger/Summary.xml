<GuiXml>
    <Controls>
        <TopLevelControl name="FurysInventoryLedgerSummary" hidden="true" mouseEnabled="true" movable="true" clampedToScreen="true" tier="HIGH">
            <Dimensions x="980" y="760" />
            <Anchor point="CENTER" />
            <Controls>
                <Backdrop name="$(parent)Bg" edgeColor="FF4A3D99">
                    <AnchorFill />
                    <Edge edgeSize="2" />
                    <OnInitialized>self:SetCenterColor(0.059, 0.055, 0.122, 1)</OnInitialized>
                </Backdrop>

                <Label name="$(parent)Title" font="$(ANTIQUE_FONT)|26|soft-shadow-thick" color="ECEAF8" text="Fury's Inventory Ledger - Summary">
                    <Anchor point="TOPLEFT" offsetX="20" offsetY="14" />
                </Label>

                <Button name="$(parent)Close" inherits="ZO_CloseButton">
                    <Anchor point="TOPRIGHT" offsetX="-12" offsetY="12" />
                    <OnClicked>FurysInventoryLedger.CloseSummary()</OnClicked>
                </Button>

                <Button name="$(parent)Settings">
                    <Dimensions x="32" y="32" />
                    <Anchor point="RIGHT" relativeTo="$(parent)Close" relativePoint="LEFT" offsetX="-10" />
                    <Textures normal="/esoui/art/chatwindow/chat_options_up.dds" pressed="/esoui/art/chatwindow/chat_options_down.dds" mouseOver="/esoui/art/chatwindow/chat_options_over.dds" />
                    <OnClicked>FurysInventoryLedger.OpenSettings()</OnClicked>
                    <OnMouseEnter>InitializeTooltip(InformationTooltip, self, BOTTOM, 0, -4); SetTooltipText(InformationTooltip, "Settings (also /ledger settings)")</OnMouseEnter>
                    <OnMouseExit>ClearTooltip(InformationTooltip)</OnMouseExit>
                </Button>

                <Backdrop name="$(parent)FindBg" inherits="ZO_EditBackdrop">
                    <Dimensions x="300" y="28" />
                    <Anchor point="TOPRIGHT" offsetX="-20" offsetY="52" />
                    <Controls>
                        <EditBox name="$(parent)Edit" inherits="ZO_DefaultEditForBackdrop" maxInputCharacters="60">
                            <OnTextChanged>FurysInventoryLedger.OnFindChanged(self)</OnTextChanged>
                            <OnMouseEnter>InitializeTooltip(InformationTooltip, self, BOTTOM, 0, -4); SetTooltipText(InformationTooltip, "Type part of an item or set name to see where it is, on every character and account. Clear the box to go back.")</OnMouseEnter>
                            <OnMouseExit>ClearTooltip(InformationTooltip)</OnMouseExit>
                        </EditBox>
                    </Controls>
                </Backdrop>

                <Label name="$(parent)Sub" font="ZoFontGame" color="B4B0D8" wrapMode="ELLIPSIS">
                    <Dimensions x="620" y="24" />
                    <Anchor point="TOPLEFT" offsetX="20" offsetY="54" />
                </Label>

                <Control name="$(parent)Body" inherits="ZO_ScrollContainer">
                    <Anchor point="TOPLEFT" offsetX="20" offsetY="90" />
                    <Anchor point="BOTTOMRIGHT" offsetX="-16" offsetY="-60" />
                </Control>

                <Button name="$(parent)Refresh" inherits="ZO_DefaultButton" text="Refresh">
                    <Dimensions x="140" y="30" />
                    <Anchor point="BOTTOMLEFT" offsetX="20" offsetY="-16" />
                    <OnClicked>FurysInventoryLedger.RefreshSummary()</OnClicked>
                    <OnMouseEnter>InitializeTooltip(InformationTooltip, self, BOTTOM, 0, -4); SetTooltipText(InformationTooltip, "Redraws the page with the latest numbers.")</OnMouseEnter>
                    <OnMouseExit>ClearTooltip(InformationTooltip)</OnMouseExit>
                </Button>

                <Button name="$(parent)Copy" inherits="ZO_DefaultButton" text="Export / Copy">
                    <Dimensions x="170" y="30" />
                    <Anchor point="BOTTOMRIGHT" offsetX="-20" offsetY="-16" />
                    <OnClicked>FurysInventoryLedger.SummaryToCopy()</OnClicked>
                    <OnMouseEnter>InitializeTooltip(InformationTooltip, self, BOTTOM, 0, -4); SetTooltipText(InformationTooltip, "Opens the whole list as text you can select, copy and paste into Excel, Google Sheets or anywhere else (also /ledger copy).")</OnMouseEnter>
                    <OnMouseExit>ClearTooltip(InformationTooltip)</OnMouseExit>
                </Button>

                <Button name="$(parent)Export" inherits="ZO_DefaultButton" text="Prepare the Excel file">
                    <Dimensions x="230" y="30" />
                    <Anchor point="RIGHT" relativeTo="$(parent)Copy" relativePoint="LEFT" offsetX="-10" />
                    <OnClicked>FurysInventoryLedger.PrepareExport()</OnClicked>
                    <OnMouseEnter>InitializeTooltip(InformationTooltip, self, BOTTOM, 0, -4); SetTooltipText(InformationTooltip, "Builds the full list for ExportToExcel.cmd in the Windows tools. The game only writes it to your PC when the interface reloads or you log out, so it asks before it reloads (also /ledger export).")</OnMouseEnter>
                    <OnMouseExit>ClearTooltip(InformationTooltip)</OnMouseExit>
                </Button>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
