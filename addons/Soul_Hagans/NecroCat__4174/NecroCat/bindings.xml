<Bindings>
    <Layer name="SI_KEYBINDINGS_LAYER_GENERAL">
        <Category name="NecroCat">
            <Action name="NECROCAT_MOUNT_UP">
                <Down>NecroCat.MountRider()</Down>
            </Action>
            <!-- Твои кнопки сложности -->
            <Action name="NC_DIFF_BASEGAME">
                <Down>NecroCat.SetDiffBasegame()</Down>
            </Action>
            <Action name="NC_DIFF_JOURNEYMAN">
                <Down>NecroCat.SetDiffJourneyman()</Down>
            </Action>
            <Action name="NC_DIFF_ADVENTURER">
                <Down>NecroCat.SetDiffAdventurer()</Down>
            </Action>
            <Action name="NC_DIFF_VETERAN">
                <Down>NecroCat.SetDiffVeteran()</Down>
            </Action>
            <Action name="NECROCAT_FOLLOW_SEND">
                <Down>NecroCat.Follow.SendBeacon()</Down>
            </Action>
            <Action name="NECROCAT_FOLLOW_YES">
                <Down>NecroCat.Follow.AcceptDialog()</Down>
            </Action>
            <Action name="NECROCAT_FOLLOW_NO">
                <Down>NecroCat.Follow.CloseDialog()</Down>
            </Action>
            <Action name="NECROCAT_SELF_WHISPER">
                <Down>NecroCat.SelfWhisper()</Down>
            </Action>
            <Action name="NECROCAT_KICK_RANDOMS">
                <Down>NecroCat.KickNonFavorites()</Down>
            </Action>
            <Action name="NECROCAT_TELEPORT_VIVEC">
                <Down>NecroCat.TeleportToVivec()</Down>
            </Action>
            <!-- Режим скриншота (Clean Screen) -->
            <Action name="NC_CLEAN_SCREEN_TOGGLE">
                <Down>NecroCat.ToggleCleanScreen()</Down>
            </Action>
            <Action name="NC_CLEAN_SCREEN_CAM_UP">
                <Down>NecroCat.CleanScreenCamStart('UP')</Down>
                <Up>NecroCat.CleanScreenCamStop('UP')</Up>
            </Action>
            <Action name="NC_CLEAN_SCREEN_CAM_DOWN">
                <Down>NecroCat.CleanScreenCamStart('DOWN')</Down>
                <Up>NecroCat.CleanScreenCamStop('DOWN')</Up>
            </Action>
            <Action name="NC_CLEAN_SCREEN_CAM_LEFT">
                <Down>NecroCat.CleanScreenCamStart('LEFT')</Down>
                <Up>NecroCat.CleanScreenCamStop('LEFT')</Up>
            </Action>
            <Action name="NC_CLEAN_SCREEN_CAM_RIGHT">
                <Down>NecroCat.CleanScreenCamStart('RIGHT')</Down>
                <Up>NecroCat.CleanScreenCamStop('RIGHT')</Up>
            </Action>
        </Category>
    </Layer>
</Bindings>