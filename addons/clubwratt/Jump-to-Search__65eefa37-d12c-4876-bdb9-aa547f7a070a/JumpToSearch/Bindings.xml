<Bindings>
    <!--
        Our own action layer so the D-pad Right press is only live while a searchable gamepad
        screen is showing (Main pushes/removes it on scene state changes). The action
        inherits D-pad Right's default binding (UI_SHORTCUT_INPUT_RIGHT, the ethereal "forward/select"
        bind used by stick-navigation screens) and falls through to whatever the screen
        itself bound to D-pad Right when the handler returns false, i.e. when the header is
        unavailable or the user is already in it. None of our target screens bind it (they
        all use GAME_NAVIGATION_TYPE_BUTTON), and vertical lists never poll the d-pad
        horizontally, so the press is otherwise a no-op in the list.
    -->
    <Layer name="JumpToSearchLayer" allowFallthrough="true">
        <Category name="SI_KEYBINDINGS_CATEGORY_USER_INTERFACE">
            <Action name="JUMP_TO_SEARCH_FOCUS" inheritsBindFrom="UI_SHORTCUT_INPUT_RIGHT">
                <Down>return JumpToSearch.FocusActions.OnJumpKeyDown()</Down>
                <Up>return JumpToSearch.FocusActions.OnJumpKeyUp()</Up>
            </Action>
        </Category>
    </Layer>
</Bindings>
