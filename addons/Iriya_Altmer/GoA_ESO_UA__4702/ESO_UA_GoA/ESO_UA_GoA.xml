<GuiXml>
	<Controls>
		<TopLevelControl name="ESO_UA_GoAUI" mouseEnabled="true" movable="true" clampedToScreen="false" hidden="true">
			<Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" relativeTo="GuiRoot" offsetX="0" offsetY="7" />
			<OnMouseUp>
				ESO_UA_GoA.Selected()
			</OnMouseUp>
			<Controls>
				<Texture name="$(parent)Bg" textureFile="EsoUI/Art/Performance/StatusMeterMunge.dds">
					<Dimensions x="200" y="256"/>
					<Anchor point="CENTER" relativeTo="$(parent)" relativePoint="CENTER"/>
				</Texture>
			</Controls>
		</TopLevelControl>

		<Button name="ESO_UA_GoA_FlagControl" virtual="true" mouseEnabled="true" text="">
			<Dimensions x="32" y="32" />
			<Controls>
				<Texture name="$(parent)Texture" alpha=".7" >
					<Dimensions x="32" y="32" />
					<AnchorFill />
				</Texture>
			</Controls>
		</Button>

	</Controls>
</GuiXml>
