[SI_DELETE_CHARACTER] = "Excluir <<X:1>>"
[SI_DELETE_CHARACTER_CONFIRMATION_BUTTON] = "Excluir"
[SI_DELETE_CHARACTER_CONFIRMATION_TEXT] = "EXCLUIR"
[SI_DELETE_CHARACTER_DIALOG_GAMEPAD_CONTINUE] = "Prosseguir"
[SI_DELETE_CHARACTER_DIALOG_GAMEPAD_TEXT] = "Você pode excluir mais <<1>> <<1[/personagem/personagens]>>.\n\n|cff9633Excluir um personagem com itens da Crown Store ou recebidos via códigos promocionais irá fazer com que esses itens sejam perdidos da sua conta.|r\n\nSe você deseja manter tais itens, visite, por favor, o banco mais próximo a fim de guardá-los.\n\nColetáveis, tais como Montarias, Familiares, Trajes e Upgrades à Conta não serão perdidos.\n\nItens normais que estejam equipados ou no inventário do personagem serão destruídos."
[SI_DELETE_CHARACTER_DIALOG_GAMEPAD_TITLE] = "Excluir Personagem"
[SI_DELETE_CHARACTER_DIALOG_TEXT] = "|cff0000Excluir um personagem com itens da Loja de Crown ou obtidos através do resgate de códigos em seu inventário fará com que esses itens sejam perdidos de sua conta.|r\n\nColecionáveis como Montarias, Mascotes, Trajes e Aprimoramentos de Conta não serão perdidos. Itens normais equipados no personagem e em seu inventário também serão destruídos. Se você deseja manter esses itens, visite o banqueiro mais próximo para armazenar os itens.\n\nVocê pode excluir |cFFFFFF<<4>>|r <<4[/personagem/personagens]>>. Exclusões adicionais ficarão disponíveis com o passar do tempo.\n\nVocê tem certeza de que deseja excluir |cFFFFFF<<1>>|r? Para confirmar, digite |cFFFFFF<<2>>|r abaixo e clique no botão <<3>>."
[SI_DELETE_CHARACTER_DISABLED_GAMEPAD_TEXT] = "Você não pode excluir nenhum personagem neste momento.As eliminações ficam disponíveis ao longo do tempo. Por favor, tente novamente mais tarde."
[SI_DELETE_CHARACTER_DISABLED_GAMEPAD_TITLE] = "Não é possível excluir personagem"
[SI_DELETE_CHARACTER_DISABLED_TOOLTIP] = "Você não pode excluir nenhum personagem neste momento.As eliminações ficam disponíveis ao longo do tempo. Por favor, tente novamente mais tarde."
[SI_DELETE_CHARACTER_ENABLED_TOOLTIP] = "Você pode excluir atualmente |cFFFFFF<<1>>|r <<1[/personagem/personagens]>>.\n\nEliminações adicionais estarão disponíveis ao longo do tempo."
