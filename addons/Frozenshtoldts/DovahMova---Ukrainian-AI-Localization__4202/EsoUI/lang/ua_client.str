[SI_GUILD_HISTORY_SHOW_MORE] = "Показати більше"
[SI_GUILD_HISTORY_SUBCATEGORY_ALL] = "Усі"
[SI_GUILD_INFO_DATA_UNAVAILABLE] = "Інформація про гільдію наразі недоступна."
[SI_GUILD_INFO_FETCHING_DATA] = "Отримання інформації про гільдію..."
[SI_GUILD_INFO_SCENE_TITLE] = "Інформація про гільдію"
[SI_GUILD_INTRODUCTION] = "Гільдії — це чудовий спосіб об'єднатися з іншими мандрівниками, яких ви зустрічаєте під час дослідження світу Тамріеля! Ці великі, постійні групи дозволяють гравцям об'єднуватися, працювати над спільними цілями та розблоковувати особливі переваги, такі як гільдійські крамниці."
[SI_GUILD_INVITED_PLAYER_LOCATION] = "Запрошення очікує"
[SI_GUILD_INVITE_ACTION] = "Додати учасника"
[SI_GUILD_INVITE_BLACKISTED_ALERT] = "<<1>> занесено до чорного списку <<2>>."
[SI_GUILD_INVITE_MESSAGE] = "Вас запрошено приєднатися до <<X:1>>|cffffff<<2>>|r від |cffffff<<3>>|r."
[SI_GUILD_KEEP_ATTACK_END] = "Більше жоден охоронець не був убитий у <<1>>."
[SI_GUILD_KEEP_ATTACK_UPDATE] = "<<1>> <<1[охоронець був/охоронців було]>> убито у <<2>> <<3>> <<3[гравцем/гравцями]>>."
[SI_GUILD_KEEP_OWNERSHIP_HEADER] = "Війна Альянсів\nВолодіння"
[SI_GUILD_KIOSK_BANKED_GOLD_HEADER] = "Баланс гільдійського банку:"
[SI_GUILD_KIOSK_BIDDING_CLOSES_IN_HEADER] = "Торги закриваються через:"
[SI_GUILD_KIOSK_BID_DESCRIPTION] = "Ваша гільдія може зробити ставку, щоб найняти цього торговця для майбутнього використання. Магазин гільдії-переможця буде доступний широкій публіці через цього торговця протягом |cffffff7 днів|r. Період найму не починається, доки не буде визначено переможця після закриття торгів.\n\n|cffffffПРИМІТКА:|r Ви можете робити ставки на до |cffffff<<1>>|r торговців за гільдію на тиждень, однак ви можете виграти лише |cffffff1|r, виходячи з вашої найвищої виграшної ставки. Якщо є кілька виграшних ставок на однакову суму, виграє найраніша. Усі інші ставки будуть повернені після закриття торгів."
[SI_GUILD_KIOSK_BID_ERROR_TRADING_HOUSE_LOCKED] = "Гільдії повинні мати розблоковані гільдійські магазини, щоб робити ставки на гільдійського торговця. Ця гільдія не має необхідної кількості учасників: |cffffff<<1>>|r."
[SI_GUILD_KIOSK_BID_GUILD_CHOICE_HEADER] = "Ставка для гільдії:"
[SI_GUILD_KIOSK_BID_RATE_EXCEEDED] = "Перевищено ліміт ставок."
[SI_GUILD_KIOSK_BID_TITLE] = "Зробити ставку на гільдійського торговця"
[SI_GUILD_KIOSK_CURRENT_BID_HEADER] = "Поточна ставка:"
[SI_GUILD_KIOSK_DISPLAY_CAPTION_WITH_OWNER] = "Гільдійський торговець (<<1>>)"
[SI_GUILD_KIOSK_INITIAL_BID] = "Подати ставку"
[SI_GUILD_KIOSK_MINIMUM_BID_HEADER] = "Мінімальна ставка:"
[SI_GUILD_KIOSK_NEW_BID_HEADER] = "Нова ставка:"
[SI_GUILD_KIOSK_PURCHASE] = "Найняти"
[SI_GUILD_KIOSK_PURCHASE_COST] = "Вартість найму:"
[SI_GUILD_KIOSK_PURCHASE_DESCRIPTION] = "Ваша гільдія може найняти цього торговця для негайного використання. Після найму, магазин вашої гільдії буде доступний для широкої публіки через цього торговця протягом наступних |cffffff<<1>>|r.\n\n|cffffffПРИМІТКА:|r Одночасно гільдія може найняти лише одного торговця."
[SI_GUILD_KIOSK_PURCHASE_ERROR_KIOSK_RENTED] = "Гільдії можуть наймати лише одного гільдійського торговця одночасно. Ця гільдія вже найняла |cffffff<<1>>|r."
[SI_GUILD_KIOSK_PURCHASE_ERROR_TRADING_HOUSE_LOCKED] = "Гільдії повинні розблокувати Гільдійські магазини, щоб найняти Гільдійського торговця. Ця гільдія не має необхідних |cffffff<<1>>|r учасників."
[SI_GUILD_KIOSK_PURCHASE_GUILD_CHOICE_HEADER] = "Найняти для гільдії:"
[SI_GUILD_KIOSK_PURCHASE_TITLE] = "Найняти гільдійського торговця"
[SI_GUILD_KIOSK_UPDATE_BID] = "Оновити ставку"
[SI_GUILD_KIOSK_WEEKLY_BIDS_HEADER] = "Щотижневі ставки:"
