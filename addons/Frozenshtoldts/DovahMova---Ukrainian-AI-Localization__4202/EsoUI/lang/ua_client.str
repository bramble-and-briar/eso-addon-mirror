[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION101] = "Використовуйте це, щоб повідомити про будь-яку загрозу для дітей. Це може призвести до подання заяви в поліцію."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION102] = "Використовуйте це, коли ви бачите ситуацію, яка може вимагати повідомлення федеральних правоохоронних органів."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION103] = "Використовуйте це, якщо ви спостерігаєте поведінку, яка, на вашу думку, може призвести до повідомлення поліції для перевірки стану здоров'я."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION104] = "У разі безпосередньої небезпеки, будь ласка, зверніться до місцевих екстрених служб на додаток до подання цього звіту."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION201] = "Використовуйте це, щоб повідомити про образливі або загрозливі висловлювання чи письмові повідомлення, що виражають упередження проти певної групи, особливо на основі раси, національності, релігії або сексуальної орієнтації."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION202] = "Використовуйте це, щоб повідомити про того, хто навмисно порушує ігрове середовище або досвід спільноти."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION203] = "Використовуйте це, коли повідомляєте про іншого гравця, який надсилає одне й те саме повідомлення знову і знову в ТЕКСТОВОМУ ЧАТІ."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION204] = "Використовуйте це, щоб повідомити лише про ГОЛОСОВИЙ чат."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION205] = "Використовуйте це, щоб повідомити про ім'я персонажа або <<1>>, яке є нецензурним або іншим чином образливим."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION301] = "Представники служби підтримки оцінюватимуть ігрові журнали чату, щоб підтвердити деталі обговорюваної торгівлі та порівняти їх з ігровими журналами торгівлі."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION302] = "Використовуйте цю опцію, щоб повідомити про будь-якого гравця, який публікує особисту інформацію іншого гравця."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION303] = "Це включає, але не обмежується, використання сторонніх програм (ботів), зламаної зброї, стінових хаків, збоїв рельєфу, тролінгу зі скролом тощо."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION304] = "Використовуйте цю опцію, коли гравці використовують текст або ігрові механіки для багаторазового виконання небажаних дій після прохання зупинитися."
