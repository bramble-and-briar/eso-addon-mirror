[SI_GRAPHICSPRESETS7] = "Personalizado"
[SI_GRAPHICS_OPTIONS_BACKGROUND_FPS_LIMIT] = "Limite de FPS"
[SI_GRAPHICS_OPTIONS_BACKGROUND_FPS_LIMIT_TOOLTIP] = "Define o FPS máximo ao qual o jogo é limitado quando a opção de Limitar o FPS em Segundo Pano está ativada e o jogo está sendo executado em segundo plano."
[SI_GRAPHICS_OPTIONS_CAP_CONSOLE_FRAMERATE_IN_MENUS] = "Limitar FPS em Menu"
[SI_GRAPHICS_OPTIONS_CAP_CONSOLE_FRAMERATE_IN_MENUS_TOOLTIP] = "Limita a taxa de quadros na maioria dos menus para reduzir o consumo de energia. Aplicável apenas ao usar gráficos no modo Desempenho."
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY] = "Gráficos"
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY_TOOLTIP] = "Controle a qualidade da renderização."
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY_TOOLTIP_PS5] = "Fidelidade - prioriza a resolução em relação à taxa de quadros.\n\nDesempenho - prioriza a taxa de quadros em relação à resolução."
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY_TOOLTIP_XBSS] = "Fidelidade - prioriza a resolução e os recursos gráficos em relação à taxa de quadros.\n\nDesempenho - prioriza a taxa de quadros em relação à resolução e aos recursos gráficos."
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY_TOOLTIP_XBSX] = "Fidelidade - prioriza a resolução em relação à taxa de quadros.\n\nDesempenho - prioriza a taxa de quadros em relação à resolução."
[SI_GRAPHICS_OPTIONS_ENERGY_SUSTAINABILITY_SCREEN_DIM_AND_RESOLUTION] = "Redução de Energia em Inatividade"
[SI_GRAPHICS_OPTIONS_ENERGY_SUSTAINABILITY_SCREEN_DIM_AND_RESOLUTION_CONSOLE_TOOLTIP] = "Diminui a resolução após um período de inatividade."
[SI_GRAPHICS_OPTIONS_ENERGY_SUSTAINABILITY_SCREEN_DIM_AND_RESOLUTION_PC_TOOLTIP] = "Reduz o brilho da tela e a resolução após ficar inativo."
[SI_GRAPHICS_OPTIONS_USE_BACKGROUND_FPS_LIMIT] = "Limite o FPS em Segundo Plano"
[SI_GRAPHICS_OPTIONS_USE_BACKGROUND_FPS_LIMIT_TOOLTIP] = "Ativa um limite de FPS quando o jogo está sendo executado em segundo plano para economizar recursos de CPU e GPU."
[SI_GRAPHICS_OPTIONS_VIDEO_ACTIVE_DISPLAY] = "Monitor Ativo"
[SI_GRAPHICS_OPTIONS_VIDEO_ACTIVE_DISPLAY_FORMAT] = "Mostrar <<1>>"
[SI_GRAPHICS_OPTIONS_VIDEO_ACTIVE_DISPLAY_TOOLTIP] = "Define o dispositivo de exibição no qual o jogo será executado."
[SI_GRAPHICS_OPTIONS_VIDEO_AMBIENT_OCCLUSION_TYPE] = "Oclusão do Ambiente"
[SI_GRAPHICS_OPTIONS_VIDEO_ANTI_ALIASING] = "Anti-Aliasing (Anti Serrilhado)"
[SI_GRAPHICS_OPTIONS_VIDEO_ANTI_ALIASING_TOOLTIP] = "Suaviza a borda dos objetos no mundo. Desativar essa opção pode melhorar o desempenho, mas exibirá contornos de objetos grosseiros."
[SI_GRAPHICS_OPTIONS_VIDEO_BLOOM] = "Resplandecer"
[SI_GRAPHICS_OPTIONS_VIDEO_BLOOM_TOOLTIP] = "Aumenta a intensidade do brilho que circunda as fontes de luz. Desativar essa opção aumentará o desempenho."
[SI_GRAPHICS_OPTIONS_VIDEO_CATEGORY_ABILITY] = "Habilidades"
[SI_GRAPHICS_OPTIONS_VIDEO_CATEGORY_DISPLAY] = "Tela"
[SI_GRAPHICS_OPTIONS_VIDEO_CATEGORY_GRAPHICS] = "Gráficos"
[SI_GRAPHICS_OPTIONS_VIDEO_CHARACTER_RESOLUTION] = "Resolução de Personagens"
[SI_GRAPHICS_OPTIONS_VIDEO_CHARACTER_RESOLUTION_TOOLTIP] = "Determina o número de personagens de alta resolução próximos ao jogador e a distância em que eles aparecem."
[SI_GRAPHICS_OPTIONS_VIDEO_CLUTTER_2D_QUALITY] = "Grama"
[SI_GRAPHICS_OPTIONS_VIDEO_CLUTTER_2D_QUALITY_TOOLTIP] = "Determina a quantidade de grama e desordem do solo no mundo. Configurações mais altas aumentam a distância em que a grama é visível. Diminuir essa configuração pode aumentar o desempenho."
[SI_GRAPHICS_OPTIONS_VIDEO_DEPTH_OF_FIELD_MODE] = "Profundidade de campo"
[SI_GRAPHICS_OPTIONS_VIDEO_DEPTH_OF_FIELD_MODE_TOOLTIP] = "Determina a aparência da profundidade de campo que simula o efeito fotográfico de fazer com que objetos distantes pareçam borrados, com base na distância dos objetos em primeiro plano."
[SI_GRAPHICS_OPTIONS_VIDEO_DISPLAY_MODE] = "Modo de Exibição"
[SI_GRAPHICS_OPTIONS_VIDEO_DISPLAY_MODE_TOOLTIP] = "Configura o modo de exibição do jogo."
[SI_GRAPHICS_OPTIONS_VIDEO_DISTORTION] = "Distorção"
[SI_GRAPHICS_OPTIONS_VIDEO_DISTORTION_TOOLTIP] = "Cria efeitos de distorção em torno de certos objetos. Desativar esta opção pode aprimorar o desempenho."
[SI_GRAPHICS_OPTIONS_VIDEO_DLSS_MODE] = "Modo DLSS"
[SI_GRAPHICS_OPTIONS_VIDEO_DLSS_MODE_TOOLTIP] = "Controla o equilíbrio entre qualidade e melhoria de desempenho quando NVIDIA DLSS está habilitado."
[SI_GRAPHICS_OPTIONS_VIDEO_FSR_MODE] = "Modo FSR"
[SI_GRAPHICS_OPTIONS_VIDEO_FSR_MODE_TOOLTIP] = "Controla o equilíbrio entre melhoria de qualidade e desempenho quando o Fidelity Fx Super Resolution (FSR) está ativado."
[SI_GRAPHICS_OPTIONS_VIDEO_GAMMA_ADJUSTMENT] = "Ajuste de Gamma"
[SI_GRAPHICS_OPTIONS_VIDEO_GAMMA_ADJUSTMENT_TOOLTIP] = "Ajusta a configuração geral de gamma (brilho) do jogo sem influenciar o desempenho. Altere essa opção se o jogo parece muito claro ou escuro em sua tela."
[SI_GRAPHICS_OPTIONS_VIDEO_GOD_RAYS] = "Raios Solares"
[SI_GRAPHICS_OPTIONS_VIDEO_GOD_RAYS_TOOLTIP] = "Esta opção exibe raios solares com base no ângulo do sol em relação à câmera. Desativar esta opção pode aprimorar o desempenho."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_ENABLED] = "HDR (beta)"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_ENABLED_TOOLTIP] = "Ativa o HDR se o jogo estiver rodando em um monitor compatível com HDR e com HDR ativado."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_MODE] = "Modo HDR"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_MODE_TOOLTIP] = "Define o modo HDR."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_PEAK_BRIGHTNESS] = "Brilho de Pico HDR"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_PEAK_BRIGHTNESS_TOOLTIP] = "Define o brilho do Pico HDR."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_SCENE_BRIGHTNESS] = "Brilho da cena HDR"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_SCENE_BRIGHTNESS_TOOLTIP] = "Define o brilho da cena HDR."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_SCENE_CONTRAST] = "Contraste de cena HDR"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_SCENE_CONTRAST_TOOLTIP] = "Define o contraste da cena HDR."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_UI_BRIGHTNESS] = "Brilho da IU HDR"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_UI_BRIGHTNESS_TOOLTIP] = "Define o brilho da IU HDR."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_UI_CONTRAST] = "Contraste da IU HDR"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_UI_CONTRAST_TOOLTIP] = "Define o contraste da IU HDR."
[SI_GRAPHICS_OPTIONS_VIDEO_MAC_AMBIENT_OCCLUSION_TYPE_TOOLTIP] = "Aumenta a fidelidade das sombras e da iluminação, levando em consideração os objetos que bloqueiam a luz. O HBAO é mais caro do que o SSAO, mas fornece um resultado mais realista. Desativar esta configuração pode ajudar a melhorar o desempenho."
[SI_GRAPHICS_OPTIONS_VIDEO_MAXIMUM_PARTICLE_SYSTEMS] = "Sistema Máximo de Partículas"
[SI_GRAPHICS_OPTIONS_VIDEO_MAXIMUM_PARTICLE_SYSTEMS_RESTRICTION] = "As configurações só serão aplicadas após você sair do jogo ou mudar de área."
[SI_GRAPHICS_OPTIONS_VIDEO_MAXIMUM_PARTICLE_SYSTEMS_TOOLTIP] = "Determina o número total de sistemas de partículas que são mostrados no mundo a qualquer momento. Diminuir esta configuração reduzirá o número de sistemas de partículas mostrados, mas pode aprimorar o desempenho."
[SI_GRAPHICS_OPTIONS_VIDEO_OCCLUSION_CULLING_ENABLED] = "Seleção de oclusão de software"
[SI_GRAPHICS_OPTIONS_VIDEO_OCCLUSION_CULLING_ENABLED_TOOLTIP] = "Controla se a seleção de oclusão está habilitada. A seleção de oclusão usará mais sua CPU para reduzir a carga de trabalho de sua GPU. Use isto se a sua taxa de quadros for limitada pela sua GPU."
[SI_GRAPHICS_OPTIONS_VIDEO_PARTICLE_SUPPRESSION_DISTANCE] = "Distância de Supressão de Partículas"
[SI_GRAPHICS_OPTIONS_VIDEO_PARTICLE_SUPPRESSION_DISTANCE_TOOLTIP] = "Ajusta a distância em que as partículas não essenciais já não são visíveis. Aumentar esta opção acrescentará mais partículas, mas pode afetar o desempenho."
[SI_GRAPHICS_OPTIONS_VIDEO_PLANAR_WATER_REFLECTION_QUALITY] = "Qualidade das reflexões planas"
[SI_GRAPHICS_OPTIONS_VIDEO_PLANAR_WATER_REFLECTION_QUALITY_TOOLTIP] = "Determina a resolução e o detalhe das reflexões planas exibidas na superfície da água. Os reflexos planos são de alta qualidade, mas podem reduzir o desempenho quando ativados. A água que não pode usar reflexos planos usará os reflexos do espaço da tela."
[SI_GRAPHICS_OPTIONS_VIDEO_PRESETS] = "Qualidade Gráfica"
[SI_GRAPHICS_OPTIONS_VIDEO_PRESETS_TOOLTIP] = "Define a qualidade geral dos gráficos do jogo, ajustando todas as opções avançadas abaixo."
[SI_GRAPHICS_OPTIONS_VIDEO_RENDER_THREAD] = "Renderização multithread"
[SI_GRAPHICS_OPTIONS_VIDEO_RENDER_THREAD_TOOLTIP] = "Ativa um thread separado para o processo de renderização, o que pode melhorar o desempenho."
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION] = "Resolução"
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION_FORMAT] = "<<1>>x<<2>>"
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION_FORMAT_WIDE] = "<<1>>x<<2>> (Largo)"
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION_TOOLTIP] = "Especifica a resolução geral na qual o jogo será executado. Aumentar a resolução proporcionará maior fidelidade de imagem às custas de desempenho. A resolução escolhida deve corresponder à proporção de seu monitor."
[SI_GRAPHICS_OPTIONS_VIDEO_SCREENSPACE_WATER_REFLECTION_QUALITY] = "Qualidade das reflexões do espaço da tela"
[SI_GRAPHICS_OPTIONS_VIDEO_SCREENSPACE_WATER_REFLECTION_QUALITY_TOOLTIP] = "Determina a qualidade dos reflexos do espaço da tela mostrados na superfície da água. Aumentar este parâmetro melhora a precisão da reflexão, mas pode diminuir o desempenho."
[SI_GRAPHICS_OPTIONS_VIDEO_SHADOWS] = "Qualidade da Sombra"
[SI_GRAPHICS_OPTIONS_VIDEO_SHADOWS_TOOLTIP] = "Determina a qualidade das sombras que você vê no mundo. Configurações altas aumentam a distância, a opacidade e o número de objetos em que as sombras são mostradas. Diminuir essa qualidade pode ajudar a aumentar sua performance."
[SI_GRAPHICS_OPTIONS_VIDEO_SHOW_ADDITIONAL_ALLY_EFFECTS] = "Mostrar efeitos adicionais de aliado"
[SI_GRAPHICS_OPTIONS_VIDEO_SHOW_ADDITIONAL_ALLY_EFFECTS_TOOLTIP] = "Mostra todas as habilidades ofensivas persistentes de aliados enquanto estiver em áreas abertas e de masmorra. Desabilitar essa opção pode aumentar a performance."
[SI_GRAPHICS_OPTIONS_VIDEO_SUB_SAMPLING] = "Qualidade de Sub-amostragem"
[SI_GRAPHICS_OPTIONS_VIDEO_SUB_SAMPLING_TOOLTIP] = "Determina a resolução em que o jogo renderizará o mundo. A interface não é afetada por esta configuração. Diminuir a qualidade pode ajudar a aprimorar o desempenho."
[SI_GRAPHICS_OPTIONS_VIDEO_TEXTURE_RES] = "Qualidade das texturas"
[SI_GRAPHICS_OPTIONS_VIDEO_TEXTURE_RES_TOOLTIP] = "Controla a qualidade das texturas utilizadas no mundo. Opções mais altas fornecerão mais detalhes dos objetos, modelos de personagens e ambiente, mas exige mais memória de vídeo para executar adequadamente."
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_ENEMY_INTENSITY] = "Intensidade dos Efeitos Visuais de Inimigos"
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_ENEMY_INTENSITY_TOOLTIP] = "Ajusta a visibilidade dos efeitos visuais lançados por todos os jogadores inimigos."
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_FRIENDLY_INTENSITY] = "Intensidade dos Efeitos Visuais de Aliados"
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_FRIENDLY_INTENSITY_TOOLTIP] = "Ajusta a visibilidade dos efeitos visuais lançados por todos os jogadores aliados."
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_SELF_INTENSITY] = "Intensidade dos Efeitos Visuais Pessoais"
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_SELF_INTENSITY_TOOLTIP] = "Ajusta a visibilidade dos efeitos visuais lançados por você."
[SI_GRAPHICS_OPTIONS_VIDEO_VIEW_DISTANCE] = "Distância de exibição"
[SI_GRAPHICS_OPTIONS_VIDEO_VIEW_DISTANCE_TOOLTIP] = "Ajusta a distância em que determinados objetos no jogo não serão mais visíveis. Aumentar essa opção proporcionará um ambiente mais rico e mais realista à custa do desempenho."
[SI_GRAPHICS_OPTIONS_VIDEO_VSYNC] = "Sincronização Vertical"
[SI_GRAPHICS_OPTIONS_VIDEO_VSYNC_TOOLTIP] = "Ajuda a eliminar as imperfeições dos objetos, sincronizando a taxa de quadros com a taxa de atualização do seu monitor."
[SI_GRAPHICS_OPTIONS_VIDEO_WINDOWS_AMBIENT_OCCLUSION_TYPE_TOOLTIP] = "Aumenta a fidelidade das sombras e da iluminação, levando em consideração os objetos que bloqueiam a luz. O LSAO é mais realista e mais caro do que o HBAO, que é mais realista e mais caro do que o SSAO. O Screen Space GI melhora em LSAO, contabilizando reflexos adicionais de luz. Desativar esta configuração pode ajudar a melhorar o desempenho."
