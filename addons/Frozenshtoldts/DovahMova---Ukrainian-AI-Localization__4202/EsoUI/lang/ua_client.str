[SI_GUILD_CLAIM_KEEP_ACCEPT] = "Захопити"
[SI_GUILD_CONCLUSION] = "Членство в гільдії прив'язане до вашого <<1>> і обмежене 5 гільдіями загалом. Усі персонажі під вашим <<1>> матимуть доступ до всіх ваших гільдій.\n\nПриєднуйтесь до існуючої гільдії або створіть власну, щоб запросити інших!"
