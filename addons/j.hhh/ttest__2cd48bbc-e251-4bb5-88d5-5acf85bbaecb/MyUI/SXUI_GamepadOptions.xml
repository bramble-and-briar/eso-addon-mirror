<GuiXml>
    <Controls>
        <!--
            These rows inherit ESO/LibGamepad visuals, but SXUI_LAMBridge.lua
            installs addon-owned input handlers for them. This keeps custom BUI
            settings out of ZO_Options -> SetSettingFromControl -> SetSetting.
        -->
        <Control name="MyUI_OptionsCheckboxRow"
                 inherits="ZO_GamepadOptionsCheckboxRow"
                 virtual="true"/>
        <Control name="MyUI_OptionsFiniteListRow"
                 inherits="ZO_GamepadOptionsHorizontalListRow"
                 virtual="true"/>
        <Control name="MyUI_OptionsSliderRow"
                 inherits="LibGamepad_SliderRow"
                 virtual="true"/>
    </Controls>
</GuiXml>
