<GuiXml>
    <Controls>
        <!-- Group header (zone) -->
        <Control name="MANAAntiquarian_ZoneRow" virtual="true">
            <Dimensions y="32" />
            <Controls>
                <Label name="$(parent)Name" font="ZoFontWinH4" verticalAlignment="CENTER" wrapMode="ELLIPSIS">
                    <Anchor point="LEFT" offsetX="6" />
                    <Anchor point="RIGHT" offsetX="-6" />
                    <Dimensions y="32" />
                </Label>
            </Controls>
        </Control>

        <!-- Lead row. Columns are laid out in Lua (MANAAntiquarian.LayoutColumns). -->
        <Control name="MANAAntiquarian_LeadRow" virtual="true" mouseEnabled="true">
            <Dimensions y="28" />
            <OnMouseEnter>MANAAntiquarian.RowEnter(self)</OnMouseEnter>
            <OnMouseExit>MANAAntiquarian.RowExit(self)</OnMouseExit>
            <OnMouseDoubleClick>MANAAntiquarian.RowDoubleClick(self, button)</OnMouseDoubleClick>
            <Controls>
                <Label name="$(parent)Status" font="ZoFontGame" verticalAlignment="CENTER" wrapMode="ELLIPSIS" />
                <Label name="$(parent)Name" font="ZoFontGame" verticalAlignment="CENTER" wrapMode="ELLIPSIS" />
                <Label name="$(parent)Hint" font="ZoFontGame" verticalAlignment="CENTER" wrapMode="ELLIPSIS" />
                <Label name="$(parent)Lore" font="ZoFontGame" verticalAlignment="CENTER" horizontalAlignment="CENTER" />
                <Label name="$(parent)Expire" font="ZoFontGame" verticalAlignment="CENTER" horizontalAlignment="RIGHT" />
                <Label name="$(parent)Scry" font="ZoFontGameBold" verticalAlignment="CENTER" horizontalAlignment="CENTER" mouseEnabled="true">
                    <OnMouseEnter>MANAAntiquarian.ActionEnter(self)</OnMouseEnter>
                    <OnMouseExit>MANAAntiquarian.ActionExit(self)</OnMouseExit>
                    <OnMouseUp>if upInside and button == MOUSE_BUTTON_INDEX_LEFT then MANAAntiquarian.OnAction(self, "scry") end</OnMouseUp>
                </Label>
                <Label name="$(parent)Map" font="ZoFontGameBold" verticalAlignment="CENTER" horizontalAlignment="CENTER" mouseEnabled="true">
                    <OnMouseEnter>MANAAntiquarian.ActionEnter(self)</OnMouseEnter>
                    <OnMouseExit>MANAAntiquarian.ActionExit(self)</OnMouseExit>
                    <OnMouseUp>if upInside and button == MOUSE_BUTTON_INDEX_LEFT then MANAAntiquarian.OnAction(self, "map") end</OnMouseUp>
                </Label>
            </Controls>
        </Control>

        <TopLevelControl name="MANAAntiquarianWindow" hidden="true" mouseEnabled="true" movable="true"
                         clampedToScreen="true" resizeHandleSize="10">
            <Dimensions x="1100" y="640" />
            <DimensionConstraints minX="860" minY="320" />
            <Anchor point="CENTER" />
            <OnMoveStop>MANAAntiquarian.SaveWindow()</OnMoveStop>
            <OnResizeStop>MANAAntiquarian.SaveWindow() MANAAntiquarian.OnResized()</OnResizeStop>
            <Controls>
                <Backdrop name="$(parent)BG" inherits="ZO_DefaultBackdrop" />

                <Label name="$(parent)Title" font="ZoFontWinH2" text="MANA Antiquarian">
                    <Anchor point="TOPLEFT" offsetX="16" offsetY="10" />
                </Label>
                <Label name="$(parent)Summary" font="ZoFontGame" color="C5C29E">
                    <Anchor point="LEFT" relativeTo="$(parent)Title" relativePoint="RIGHT" offsetX="20" />
                </Label>
                <Button name="$(parent)Close" inherits="ZO_CloseButton">
                    <Anchor point="TOPRIGHT" offsetX="-10" offsetY="10" />
                    <OnClicked>MANAAntiquarian.Hide()</OnClicked>
                </Button>

                <Button name="$(parent)ShowAll" inherits="ZO_CheckButton">
                    <Anchor point="TOPLEFT" offsetX="18" offsetY="54" />
                </Button>

                <Backdrop name="$(parent)Search" inherits="ZO_EditBackdrop">
                    <Dimensions x="260" />
                    <Anchor point="TOPLEFT" offsetX="200" offsetY="48" />
                    <Controls>
                        <EditBox name="$(parent)Box" inherits="ZO_DefaultEditForBackdrop">
                            <OnTextChanged>MANAAntiquarian.OnSearchChanged(self)</OnTextChanged>
                            <OnEscape>self:LoseFocus()</OnEscape>
                        </EditBox>
                    </Controls>
                </Backdrop>

                <Control name="$(parent)Major" inherits="ZO_ComboBox">
                    <Dimensions x="250" y="28" />
                    <Anchor point="TOPLEFT" offsetX="490" offsetY="46" />
                </Control>
                <Control name="$(parent)Type" inherits="ZO_ComboBox">
                    <Dimensions x="220" y="28" />
                    <Anchor point="LEFT" relativeTo="$(parent)Major" relativePoint="RIGHT" offsetX="12" />
                </Control>

                <Control name="$(parent)Headers">
                    <Dimensions y="24" />
                    <Anchor point="TOPLEFT" offsetX="10" offsetY="88" />
                    <Anchor point="TOPRIGHT" offsetX="-26" offsetY="88" />
                    <Controls>
                        <Label name="$(parent)Status" font="ZoFontGameBold" color="C5C29E" verticalAlignment="CENTER" mouseEnabled="true">
                            <OnMouseEnter>MANAAntiquarian.HeaderEnter(self)</OnMouseEnter>
                            <OnMouseExit>MANAAntiquarian.HeaderExit(self)</OnMouseExit>
                            <OnMouseUp>if upInside and button == MOUSE_BUTTON_INDEX_LEFT then MANAAntiquarian.OnHeaderClick(self) end</OnMouseUp>
                        </Label>
                        <Label name="$(parent)Name" font="ZoFontGameBold" color="C5C29E" verticalAlignment="CENTER" mouseEnabled="true">
                            <OnMouseEnter>MANAAntiquarian.HeaderEnter(self)</OnMouseEnter>
                            <OnMouseExit>MANAAntiquarian.HeaderExit(self)</OnMouseExit>
                            <OnMouseUp>if upInside and button == MOUSE_BUTTON_INDEX_LEFT then MANAAntiquarian.OnHeaderClick(self) end</OnMouseUp>
                        </Label>
                        <Label name="$(parent)Hint" font="ZoFontGameBold" color="C5C29E" verticalAlignment="CENTER" mouseEnabled="true">
                            <OnMouseEnter>MANAAntiquarian.HeaderEnter(self)</OnMouseEnter>
                            <OnMouseExit>MANAAntiquarian.HeaderExit(self)</OnMouseExit>
                            <OnMouseUp>if upInside and button == MOUSE_BUTTON_INDEX_LEFT then MANAAntiquarian.OnHeaderClick(self) end</OnMouseUp>
                        </Label>
                        <Label name="$(parent)Lore" font="ZoFontGameBold" color="C5C29E" verticalAlignment="CENTER" horizontalAlignment="CENTER" mouseEnabled="true">
                            <OnMouseEnter>MANAAntiquarian.HeaderEnter(self)</OnMouseEnter>
                            <OnMouseExit>MANAAntiquarian.HeaderExit(self)</OnMouseExit>
                            <OnMouseUp>if upInside and button == MOUSE_BUTTON_INDEX_LEFT then MANAAntiquarian.OnHeaderClick(self) end</OnMouseUp>
                        </Label>
                        <Label name="$(parent)Expire" font="ZoFontGameBold" color="C5C29E" verticalAlignment="CENTER" horizontalAlignment="RIGHT" mouseEnabled="true">
                            <OnMouseEnter>MANAAntiquarian.HeaderEnter(self)</OnMouseEnter>
                            <OnMouseExit>MANAAntiquarian.HeaderExit(self)</OnMouseExit>
                            <OnMouseUp>if upInside and button == MOUSE_BUTTON_INDEX_LEFT then MANAAntiquarian.OnHeaderClick(self) end</OnMouseUp>
                        </Label>
                        <Label name="$(parent)Scry" font="ZoFontGameBold" color="C5C29E" verticalAlignment="CENTER" horizontalAlignment="CENTER" />
                        <Label name="$(parent)Map" font="ZoFontGameBold" color="C5C29E" verticalAlignment="CENTER" horizontalAlignment="CENTER" />
                    </Controls>
                </Control>

                <Control name="$(parent)List" inherits="ZO_ScrollList">
                    <Anchor point="TOPLEFT" offsetX="10" offsetY="116" />
                    <Anchor point="BOTTOMRIGHT" offsetX="-10" offsetY="-14" />
                </Control>

                <Label name="$(parent)Empty" font="ZoFontWinH4" color="8F8F8F" hidden="true" horizontalAlignment="CENTER">
                    <Anchor point="CENTER" relativeTo="$(parent)List" />
                </Label>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
