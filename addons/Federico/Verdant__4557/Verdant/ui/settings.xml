<GuiXml>
  <Controls>

    <TopLevelControl name="VerdantSettingsPanel"
                     tier="MEDIUM"
                     hidden="true"
                     clampedToScreen="true"
                     movable="true"
                     mouseEnabled="true">

      <Dimensions x="600" y="396"/>
      <Anchor point="CENTER" relativeTo="GuiRoot" relativePoint="CENTER"/>

      <OnMoveStop>Verdant.Window.Settings.on_move_stop()</OnMoveStop>

      <Controls>

        <Backdrop name="$(parent)Bg">
          <AnchorFill/>
        </Backdrop>

        <Texture name="$(parent)BrandLogo" textureFile="Verdant/assets/logo.dds">
          <Anchor point="TOPLEFT" offsetX="12" offsetY="8"/>
          <Dimensions x="24" y="24"/>
        </Texture>

        <Label name="$(parent)VersionLabel"
               font="ZoFontGameSmall"
               horizontalAlignment="RIGHT"
               verticalAlignment="CENTER">
          <Anchor point="TOPRIGHT" offsetX="-36" offsetY="12"/>
          <Dimensions x="60" y="14"/>
        </Label>

        <Button name="$(parent)CloseBtn" mouseEnabled="true"
                inherits="ZO_ButtonBehaviorClickSound">
          <Anchor point="TOPRIGHT" offsetX="-8" offsetY="6"/>
          <Dimensions x="22" y="22"/>
          <OnClicked>Verdant.Window.Settings.toggle()</OnClicked>
        </Button>

        <Button name="$(parent)DevBtn" font="ZoFontGameSmall" hidden="true"
                inherits="ZO_DefaultButton">
          <Anchor point="TOPRIGHT" offsetX="-102" offsetY="8"/>
          <Dimensions x="44" y="20"/>
          <OnClicked>Verdant.Window.DevTools.toggle()</OnClicked>
        </Button>

        <Label name="$(parent)SecGraph" font="ZoFontGameSmall"
               horizontalAlignment="LEFT" verticalAlignment="CENTER">
          <Anchor point="TOPLEFT" offsetX="14" offsetY="46"/>
          <Dimensions x="200" y="12"/>
        </Label>
        <Texture name="$(parent)SepGraph">
          <Anchor point="TOPLEFT" offsetX="14" offsetY="60"/>
          <Dimensions x="272" y="1"/>
        </Texture>

        <Label name="$(parent)VPAlphaTitle"
               font="ZoFontGameSmall"
               horizontalAlignment="LEFT"
               verticalAlignment="CENTER">
          <Anchor point="TOPLEFT" offsetX="14" offsetY="68"/>
          <Dimensions x="160" y="12"/>
        </Label>
        <Label name="$(parent)VPAlphaLabel"
               font="ZoFontGameSmall"
               horizontalAlignment="RIGHT"
               verticalAlignment="CENTER">
          <Anchor point="TOPLEFT" offsetX="206" offsetY="68"/>
          <Dimensions x="80" y="12"/>
        </Label>
        <Control name="$(parent)SliderTrackVPAlpha" mouseEnabled="true">
          <Anchor point="TOPLEFT" offsetX="14" offsetY="83"/>
          <Dimensions x="272" y="14"/>
        </Control>

        <Button name="$(parent)SampleBtn"
                mouseEnabled="true"
                font="ZoFontGameSmall"
                inherits="ZO_DefaultButton">
          <Anchor point="TOPLEFT" offsetX="14" offsetY="108"/>
          <Dimensions x="272" y="22"/>
          <OnClicked>Verdant.Window.Settings.on_sample_click()</OnClicked>
        </Button>

        <Button name="$(parent)ZoomScaleBtn"
                mouseEnabled="true"
                font="ZoFontGameSmall"
                inherits="ZO_DefaultButton">
          <Anchor point="TOPLEFT" offsetX="14" offsetY="136"/>
          <Dimensions x="272" y="22"/>
          <OnClicked>Verdant.Window.Settings.on_zoom_scale_click()</OnClicked>
        </Button>

        <Button name="$(parent)AvgBtn"
                mouseEnabled="true"
                font="ZoFontGameSmall"
                inherits="ZO_DefaultButton">
          <Anchor point="TOPLEFT" offsetX="14" offsetY="164"/>
          <Dimensions x="134" y="22"/>
          <OnClicked>Verdant.Window.Settings.on_avg_click()</OnClicked>
        </Button>

        <Button name="$(parent)MedianBtn"
                mouseEnabled="true"
                font="ZoFontGameSmall"
                inherits="ZO_DefaultButton">
          <Anchor point="TOPLEFT" offsetX="152" offsetY="164"/>
          <Dimensions x="134" y="22"/>
          <OnClicked>Verdant.Window.Settings.on_median_click()</OnClicked>
        </Button>

        <Button name="$(parent)UnknownBtn" mouseEnabled="true"
                inherits="ZO_ButtonBehaviorClickSound">
          <Anchor point="TOPLEFT" offsetX="14" offsetY="284"/>
          <Dimensions x="64" y="64"/>
          <OnClicked>Verdant.Window.Settings.on_unknown_click()</OnClicked>
        </Button>

        <Label name="$(parent)UnknownLabel"
               font="ZoFontGame"
               horizontalAlignment="LEFT"
               verticalAlignment="CENTER"
               mouseEnabled="true">
          <Anchor point="LEFT" relativeTo="$(parent)UnknownBtn" relativePoint="RIGHT" offsetX="10" offsetY="0"/>
          <Dimensions x="196" y="64"/>
          <OnMouseUp>Verdant.Window.Settings.on_unknown_click()</OnMouseUp>
        </Label>

        <Label name="$(parent)SecGeneral" font="ZoFontGameSmall"
               horizontalAlignment="LEFT" verticalAlignment="CENTER">
          <Anchor point="TOPLEFT" offsetX="314" offsetY="46"/>
          <Dimensions x="200" y="12"/>
        </Label>
        <Texture name="$(parent)SepGeneral">
          <Anchor point="TOPLEFT" offsetX="314" offsetY="60"/>
          <Dimensions x="272" y="1"/>
        </Texture>

        <Button name="$(parent)LogoBtn"
                mouseEnabled="true"
                font="ZoFontGameSmall"
                inherits="ZO_DefaultButton">
          <Anchor point="TOPLEFT" offsetX="314" offsetY="68"/>
          <Dimensions x="272" y="22"/>
          <OnClicked>Verdant.Window.Settings.on_logo_click()</OnClicked>
        </Button>

        <Button name="$(parent)SoundsBtn"
                mouseEnabled="true"
                font="ZoFontGameSmall"
                inherits="ZO_DefaultButton">
          <Anchor point="TOPLEFT" offsetX="314" offsetY="96"/>
          <Dimensions x="272" y="22"/>
          <OnClicked>Verdant.Window.Settings.on_sounds_click()</OnClicked>
        </Button>

        <Button name="$(parent)LightBtn"
                mouseEnabled="true"
                font="ZoFontGameSmall"
                inherits="ZO_DefaultButton">
          <Anchor point="TOPLEFT" offsetX="314" offsetY="124"/>
          <Dimensions x="272" y="22"/>
          <OnClicked>Verdant.Window.Settings.on_light_click()</OnClicked>
        </Button>

        <Label name="$(parent)LightAlphaTitle"
               font="ZoFontGameSmall"
               horizontalAlignment="LEFT"
               verticalAlignment="CENTER">
          <Anchor point="TOPLEFT" offsetX="314" offsetY="154"/>
          <Dimensions x="160" y="12"/>
        </Label>
        <Label name="$(parent)LightAlphaLabel"
               font="ZoFontGameSmall"
               horizontalAlignment="RIGHT"
               verticalAlignment="CENTER">
          <Anchor point="TOPLEFT" offsetX="506" offsetY="154"/>
          <Dimensions x="80" y="12"/>
        </Label>
        <Control name="$(parent)SliderTrackLightAlpha" mouseEnabled="true">
          <Anchor point="TOPLEFT" offsetX="314" offsetY="169"/>
          <Dimensions x="272" y="14"/>
        </Control>

        <Button name="$(parent)GdmBtn"
                mouseEnabled="true"
                font="ZoFontGameSmall"
                inherits="ZO_DefaultButton">
          <Anchor point="TOPLEFT" offsetX="314" offsetY="194"/>
          <Dimensions x="272" y="22"/>
          <OnClicked>Verdant.Window.Settings.on_gdm_click()</OnClicked>
        </Button>

        <Button name="$(parent)ThemeBtn"
                mouseEnabled="true"
                font="ZoFontGameSmall"
                inherits="ZO_DefaultButton">
          <Anchor point="TOPLEFT" offsetX="314" offsetY="222"/>
          <Dimensions x="272" y="22"/>
          <OnClicked>Verdant.Window.Settings.on_theme_click()</OnClicked>
        </Button>

        <Texture name="$(parent)ThemeCaret" level="5">
          <Anchor point="RIGHT" relativeTo="$(parent)ThemeBtn" relativePoint="RIGHT" offsetX="-6" offsetY="0"/>
          <Dimensions x="14" y="14"/>
        </Texture>

        <Button name="$(parent)LampBtn"
                mouseEnabled="true"
                font="ZoFontGameSmall"
                inherits="ZO_DefaultButton">
          <Anchor point="TOPLEFT" offsetX="314" offsetY="250"/>
          <Dimensions x="272" y="22"/>
          <OnClicked>Verdant.Window.Settings.on_lamp_click()</OnClicked>
        </Button>

        <Texture name="$(parent)SepColumns">
          <Anchor point="TOPLEFT" offsetX="300" offsetY="46"/>
          <Dimensions x="1" y="340"/>
        </Texture>

        <Button name="$(parent)ResetBtn"
                mouseEnabled="true"
                font="ZoFontGameSmall"
                inherits="ZO_DefaultButton">
          <Anchor point="BOTTOMLEFT" offsetX="14" offsetY="-10"/>
          <Dimensions x="272" y="22"/>
          <OnClicked>Verdant.Window.Settings.on_reset_click()</OnClicked>
        </Button>

      </Controls>
    </TopLevelControl>

  </Controls>
</GuiXml>
