lang/strings.lua
lang/$(language).lua

## Listed so the game can load it: a file not named here is inaccessible at runtime and the
## texture draws as a 1x1 pixel (measured on PS5 in PBsJanken 1.0.7). PS5 paths are case sensitive.
assets/compass-frame.dds

Main.lua
Compass.lua
Settings.lua
