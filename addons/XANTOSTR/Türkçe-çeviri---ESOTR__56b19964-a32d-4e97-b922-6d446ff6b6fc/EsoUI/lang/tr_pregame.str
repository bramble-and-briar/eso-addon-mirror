[SI_ZONECOMPLETIONTYPE13] = "Ortak Zindanlar"
[SI_ZONECOMPLETIONTYPE14] = "Set İstasyonları"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION1] = "|cffffffBölge Hikâyesi Görevleri|r, bölgenin ana hikâye akışıdır. Bu görevleri tamamlamak sana Yetenek Puanı, deneyim, altın ve ekipman kazandırabilir."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION2] = "|cffffffİlgi Noktaları|r lore'u, karakterleri ve konumları keşfedebileceğiniz, kendi içinde hikaye barındıran bölgelerdir. Bunlar sizi tecrübe,altın ve ekipman ile ödüllendirir."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION4] = "|cffffffYolgeçitler|r daha önce keşfedilmiş ve açılmış olan diğer yolgeçitler arasında anında ve ücretsiz gerçekleştirebileceğiniz seyahat noktalarıdır. Ayrıca dünyanın her noktasından cüzzi bir miktar altın vererek, açılmış olan Yolgeçitlere seyahat edebilirsiniz."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION5] = "|cffffffMağaralar|r dünya üzerinde bulunan tek başına tamamlanabilen zindanlardır. Mağaralar her zaman bir göktaşı ve set eşyası düşüren bir boss barındırır."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION6] = "|cffffffGrup Mağaraları|r Craglorn'da bulunan, özellikle dört oyuncudan oluşan gruplar için dizayn edilmiş açık dünya zindanlarıdır. Grup mağaraları her zaman bir göktaşı ve set eşyası düşüren bir boss barındırır."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION7] = "|cffffffGöktaşları|r dünyanın dört bir yanına dağılmıştır ve yaydıkları parlak beyaz ışık huzmesiyle fark edilebilir. Üç Göktaşı keşfetmek sana yeni yeteneklerin kilidini açmak veya biçimlendirmek için kullanabileceğin bir Yetenek Puanı kazandırır."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION8] = "|cffffffDünya Etkinlikleri|r Dark Anhorlar gibi dünya üzerinde meydana gelen ve en iyi grupla hareket ederek tamamlanabilen etkinliklerdir. Dünya Etkinliği tamamlamak sizi tecrübe,altın ve yüksek kademe ekipman ile ödüllendirir."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION9] = "|cffffffDünya Bossları|r ancak bir grup maceracı ile tamamlanabilmesi düşünülen zor düşmanlardır. Bir Dünya Boss'unu yenmek sizi yüksek kademe ekipman ile ödüllendirir."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION10] = "|cffffffOlağanüstü Alanlar|r dünya içerisinde görülen ilginç noktalardır. Bölgedeki tüm Olağanüstü Alanlar'ı keşfetmek sizi Pathfinder başarımı ile ödüllendirir."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION11] = "|cffffffShalidor'un Kütüphane Kitapları|r dünyanın her bir yerine dağılmış halde bulunmaktadır. Bu kitapları belirgin derecede görülebilecek mor parlamalarıyla teşhis edebilirsiniz. Bu kitapları keşfetmek Büyücüler Loncası kademenizi geliştirir ve ilgili yetenek ağacında ilerlemenizi sağlar."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION12] = "|cffffffMundus Taşları|r oyuncuya geçici bir etki vererek avantaj sağlayan dünyadaki nesnelerdir. Bu etki başka bir Mundus Taşı ile değiştirilene kadar kalır."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION13] = "|cffffffHalka Açık Zindanlar|r, Tamriel ve ötesinde bulunan açık dünya zindanlarıdır. Bunlar dört oyunculu gruplar için tasarlanmıştır. Halka Açık Zindanların farklı bölümlerini tamamlamak sana bir Yetenek Puanı, deneyim, altın ve ekipman kazandırabilir."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION14] = "|cffffffSet İstasyonları|r dünya üzerinde belirli set bonuslarını taşıyan eşyaları üretebileceğiniz konumlardır."
