[SI_REDEEMCODERESULT0] = "Kodunuz başarıyla alındı!"
[SI_REDEEMCODERESULT1] = "Bu kod daha önce kullanılmış olabilir. Lütfen kodunuzu yeniden kontrol edin ve tekrar deneyin."
[SI_REDEEMCODERESULT2] = "Kısa bir zaman süreci içerisinde çok fazla kod girmeye çalıştınız. Lütfen bekleyin ve sonra tekrar deneyin."
[SI_REDEEMCODERESULT3] = "Kod girme şu anda gerçekleştirilemiyor. Lütfen daha sonra tekrar deneyiniz."
[SI_REDEEMCODERESULT4] = "Kod girme bu platformda mevcut değil."
[SI_REDEEMCODERESULT5] = "Kodunuz kullanılamadı. Kod geçersiz, daha önce kullanılmış veya platformunuzda geçerli olmayabilir. Lütfen The Elder Scrolls® Online tarafından sağlanan bir Ödül Kodu girdiğinizden emin olun. Kodunuz size bir üçüncü tarafça veya üçüncü bir tarafça sağlandıysa, lütfen kod kullanım talimatlarını izleyin. Hâlâ yardıma ihtiyacınız varsa, lütfen Müşteri Desteği ile iletişime geçin."
[SI_REDEEMCODERESULT6] = "Hesabınıza erişimde bir hata oluştu. Lütfen daha sonra tekrar deneyin ya da Müşteri Desteği ile iletişime geçin."
[SI_REDEEMCODERESULT7] = "Girilen kod başarısız oldu. Kodunuz hesabınıza uygun olmayabilir ya da ESO web sitesinden girilmesi gerekebilir. Eğer kod üçüncü şahıslar ile ilişkiliyse ya da size onlar tarafından sağlanmışsa onların kod kullanım talimatlarını takip edin. Hala yardıma ihtiyaç duyuyorsanız lütfen Müşteri Desteği ile iletişime geçin."
[SI_REDEEMCODERESULT8] = "Girilen kod başarısız oldu. Kodunuz önceden kullanışmış, aktive edilmemiş ya da bulunduğunuz platforma uygun olmayabilir. Eğer kod üçüncü şahıslar ile ilişkiliyse ya da size onlar tarafından sağlanmışsa onların kod kullanım talimatlarını takip edin ya da Müşteri Desteği ile iletişime geçin."
[SI_REDEEMCODERESULT9] = "Kod kullanımı işlemi başarısız oldu. Lütfen geçerli bir kod girdiğinizden emin olun veya Müşteri Desteği ile iletişime geçin."
[SI_REDEEMCODERESULT10] = "Kodunuz kullanılamadı. Kod geçersiz veya mevcut olmayabilir. Lütfen The Elder Scrolls® Online tarafından sağlanan bir Ödül Kodu girdiğinizden emin olun. Kodunuz size üçüncü bir tarafça veya üçüncü bir tarafça sağlandıysa, lütfen kod kullanım talimatlarını izleyin. Hâlâ yardıma ihtiyacınız varsa, lütfen Müşteri Desteği ile iletişime geçin."
