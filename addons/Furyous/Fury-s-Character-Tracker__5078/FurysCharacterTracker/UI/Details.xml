<GuiXml>
    <Controls>
        <!-- Everything saved for one character. Left-click a character on the board. Filled in by Details.lua. -->
        <TopLevelControl name="FurysCharacterTracker_Details" hidden="true" mouseEnabled="true" movable="true" clampedToScreen="true">
            <Dimensions x="1000" y="720" />
            <Anchor point="CENTER" />
            <OnMouseDown>FurysCharacterTracker.Raise(self)</OnMouseDown>
            <OnMoveStop>FurysCharacterTracker.Details.SavePosition()</OnMoveStop>
            <Controls>
                <Backdrop name="$(parent)BG" centerColor="0F0E1F" edgeColor="4A3D99" alpha="1">
                    <AnchorFill />
                    <Edge edgeSize="2" />
                </Backdrop>
                <Label name="$(parent)Title" font="ZoFontWinH2" color="ECEAF8">
                    <Anchor point="TOPLEFT" offsetX="22" offsetY="14" />
                </Label>
                <Label name="$(parent)Subtitle" font="ZoFontGameSmall" color="B4B0D8">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Title" relativePoint="BOTTOMLEFT" offsetY="2" />
                </Label>
                <Button name="$(parent)Close" inherits="ZO_CloseButton">
                    <Anchor point="TOPRIGHT" offsetX="-12" offsetY="12" />
                    <OnClicked>FurysCharacterTracker.Details:Hide()</OnClicked>
                </Button>
                <Control name="$(parent)Scroll" inherits="ZO_ScrollContainer">
                    <Anchor point="TOPLEFT" offsetX="22" offsetY="76" />
                    <Anchor point="BOTTOMRIGHT" offsetX="-14" offsetY="-16" />
                </Control>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
