                </StatusBar>
                <Label name="$(parent)Label" parentKey="label" font="ZoFontGameSmall" color="FFFFFF" horizontalAlignment="CENTER" verticalAlignment="CENTER">
                    <Anchor point="CENTER" relativeTo="$(parent)TrackBG" relativePoint="CENTER" offsetX="0" offsetY="0"/>
                </Label>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
