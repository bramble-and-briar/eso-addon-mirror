<GuiXml>
    <Animations>
        <!-- HarvestMap Console's CompassPins.xml (+ drawLevelOffsetBase like the stock compass.xml). The engine plays the
             addedAnimation when it creates a HARVEST_NODE compass pin and stops it when the pin is removed. -->
        <AnimationTimeline name="DevSandbox3_CompassPinAddedAnimation" playbackType="LOOP" loopCount="LOOP_INDEFINITELY">
            <Animations>
                <CustomAnimation delay="0" duration="1">
                </CustomAnimation>
            </Animations>
            <OnPlay>
                DevSandbox3_CompassPinAdded(self:GetFirstAnimation():GetAnimatedControl())
            </OnPlay>
            <OnStop>
                DevSandbox3_CompassPinRemoved(self:GetFirstAnimation():GetAnimatedControl())
            </OnStop>
        </AnimationTimeline>
    </Animations>
    <Controls>
        <Compass name="ZO_CompassContainer" override="true">
            <CompassPinType name="HARVEST_NODE"
                pinTexture="$(COMPASS_PATH)groupMember.dds"
                pinSize="24"
                layer="OVERLAY"
                addedAnimation="DevSandbox3_CompassPinAddedAnimation"
                farAlpha="0"
                closeAlpha="0"
                farScale="0.0"
                farScaleDistanceM="200.0"
                closeScale="2.0"
                closeScaleDistanceM="0.0"
                maxDistanceM="200.0"
                allowUpdatesWhenAnimating="true"
                drawLevelOffsetBase="120"
            />
        </Compass>
    </Controls>
</GuiXml>
