<GuiXml>
    <Controls>
        <TopLevelControl name="GroupBuildsBrowser" clampedToScreen="true" movable="true" mouseEnabled="true" resizeHandleSize="8" hidden="true">
            <Dimensions x="780" y="780" />
            <Anchor point="CENTER" relativeTo="GuiRoot" relativePoint="CENTER" />
            <OnMoveStop>GroupBuilds:OnBrowserMoved()</OnMoveStop>
            <OnResizeStop>GroupBuilds:OnBrowserResized()</OnResizeStop>
            <Controls>
                <Backdrop name="$(parent)BG" inherits="ZO_DefaultBackdrop">
                    <AnchorFill />
                </Backdrop>
                <Label name="$(parent)Title" font="ZoFontGameLargeBold" horizontalAlignment="CENTER" text="Saved Builds">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="14" offsetY="12" />
                    <Anchor point="TOPRIGHT" relativeTo="$(parent)" relativePoint="TOPRIGHT" offsetX="-44" offsetY="12" />
                </Label>
                <Button name="$(parent)Close">
                    <Dimensions x="28" y="28" />
                    <Anchor point="TOPRIGHT" relativeTo="$(parent)" relativePoint="TOPRIGHT" offsetX="-10" offsetY="10" />
                    <Textures normal="EsoUI/Art/Buttons/decline_up.dds" pressed="EsoUI/Art/Buttons/decline_down.dds" mouseOver="EsoUI/Art/Buttons/decline_over.dds" />
                    <OnClicked>GroupBuilds:ToggleBrowser()</OnClicked>
                </Button>
                <Control name="$(parent)Filters">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="14" offsetY="48" />
                    <Anchor point="TOPRIGHT" relativeTo="$(parent)" relativePoint="TOPRIGHT" offsetX="-14" offsetY="48" />
                    <Dimensions y="40" />
                    <Controls>
                        <Backdrop name="$(parent)Search" inherits="ZO_EditBackdrop">
                            <Anchor point="RIGHT" relativeTo="$(parent)" relativePoint="RIGHT" />
                            <Dimensions x="180" y="28" />
                            <Controls>
                                <EditBox name="$(parent)Box" inherits="ZO_DefaultEditForBackdrop ZO_EditDefaultText">
                                    <OnTextChanged>GroupBuilds.browser:RefreshFilters()</OnTextChanged>
                                </EditBox>
                            </Controls>
                        </Backdrop>
                    </Controls>
                </Control>
                <Control name="$(parent)Headers">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Filters" relativePoint="BOTTOMLEFT" offsetY="8" />
                    <Anchor point="TOPRIGHT" relativeTo="$(parent)Filters" relativePoint="BOTTOMRIGHT" offsetY="8" />
                    <Dimensions y="32" />
                    <Controls>
                        <Control name="$(parent)Name" inherits="ZO_SortHeader">
                            <OnInitialized>ZO_SortHeader_Initialize(self, 'Name', 'name', ZO_SORT_ORDER_UP, TEXT_ALIGN_LEFT, 'ZoFontGameLargeBold')</OnInitialized>
                            <Anchor point="LEFT" relativeTo="$(parent)" relativePoint="LEFT" offsetX="74" />
                            <Anchor point="RIGHT" relativeTo="$(parent)" relativePoint="RIGHT" offsetX="-216" />
                            <Dimensions y="40" />
                        </Control>
                        <Control name="$(parent)Date" inherits="ZO_SortHeader">
                            <OnInitialized>ZO_SortHeader_Initialize(self, 'Saved', 'timestamp', ZO_SORT_ORDER_DOWN, TEXT_ALIGN_RIGHT, 'ZoFontGameLargeBold')</OnInitialized>
                            <Anchor point="RIGHT" relativeTo="$(parent)" relativePoint="RIGHT" offsetX="-52" />
                            <Dimensions x="160" y="40" />
                        </Control>
                    </Controls>
                </Control>
                <Control name="$(parent)List" inherits="ZO_ScrollList">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Headers" relativePoint="BOTTOMLEFT" offsetY="4" />
                    <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)" relativePoint="BOTTOMRIGHT" offsetX="-12" offsetY="-12" />
                </Control>
            </Controls>
        </TopLevelControl>

        <Button name="GroupBuildsBrowserRow" virtual="true">
            <Dimensions y="40" />
            <OnMouseEnter>GroupBuilds:OnBrowserRowMouse(self, true)</OnMouseEnter>
            <OnMouseExit>GroupBuilds:OnBrowserRowMouse(self, false)</OnMouseExit>
            <OnMouseUp>GroupBuilds:OnBrowserRowClicked(self, button, upInside)</OnMouseUp>
            <Controls>
                <Texture name="$(parent)Role" textureFile="/esoui/art/lfg/lfg_icon_dps.dds">
                    <Dimensions x="32" y="32" />
                    <Anchor point="LEFT" relativeTo="$(parent)" relativePoint="LEFT" offsetX="4" />
                </Texture>
                <Texture name="$(parent)Class">
                    <Dimensions x="32" y="32" />
                    <Anchor point="LEFT" relativeTo="$(parent)Role" relativePoint="RIGHT" offsetX="2" />
                </Texture>
                <Label name="$(parent)Name" font="ZoFontWinH3" verticalAlignment="CENTER" wrapMode="TRUNCATE" maxLineCount="1">
                    <Anchor point="LEFT" relativeTo="$(parent)" relativePoint="LEFT" offsetX="74" />
                    <Anchor point="RIGHT" relativeTo="$(parent)" relativePoint="RIGHT" offsetX="-216" />
                    <Dimensions y="40" />
                </Label>
                <Label name="$(parent)Date" font="ZoFontWinH3" verticalAlignment="CENTER" horizontalAlignment="RIGHT" wrapMode="TRUNCATE" maxLineCount="1">
                    <Anchor point="RIGHT" relativeTo="$(parent)" relativePoint="RIGHT" offsetX="-52" />
                    <Dimensions x="160" y="40" />
                </Label>
                <Button name="$(parent)Note" mouseEnabled="true" hidden="true">
                    <Dimensions x="28" y="28" />
                    <Anchor point="RIGHT" relativeTo="$(parent)" relativePoint="RIGHT" offsetX="-14" />
                    <Textures normal="EsoUI/Art/Contacts/social_note_up.dds" />
                    <OnMouseEnter>GroupBuilds:OnNoteEnter(self)</OnMouseEnter>
                    <OnMouseExit>GroupBuilds:OnNoteExit(self)</OnMouseExit>
                </Button>
            </Controls>
        </Button>
    </Controls>
</GuiXml>
