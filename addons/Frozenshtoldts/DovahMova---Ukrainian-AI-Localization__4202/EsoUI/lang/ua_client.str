[SI_GUILD_HISTORY_NO_ENTRIES] = "У цьому списку немає записів."
[SI_GUILD_HISTORY_REQUEST_COOLDOWN_ALERT] = "Запити історії гільдії можна робити раз на <<X:1>>."
[SI_GUILD_HISTORY_RETRIEVING] = "Отримання історії..."
