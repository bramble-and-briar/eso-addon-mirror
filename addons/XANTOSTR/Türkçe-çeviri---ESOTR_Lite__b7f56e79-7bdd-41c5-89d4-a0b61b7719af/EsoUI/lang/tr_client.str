[SI_GRAPHICS_OPTIONS_VIDEO_GOD_RAYS] = "Güneş Işığı"
[SI_GRAPHICS_OPTIONS_VIDEO_GOD_RAYS_TOOLTIP] = "Güneşin kameraya göre açısına bağlı olarak ışık efektlerini ayarlar.Seçeneği kapatmak oyun performansını iyileştirebilir."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_ENABLED] = "HDR (Beta)"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_ENABLED_TOOLTIP] = "Oyun, HDR destekli ve HDR etkin bir monitörde çalışıyorsa HDR’ı etkinleştirir."
