<Bindings>
    <Layer name="SI_KEYBINDINGS_LAYER_GENERAL">
        <Category name="SI_BINDING_NAME_ESO_PROGRESSION_COACH_CATEGORY">
            <Action name="ESO_PROGRESSION_COACH_TOGGLE">
                <Down>ESOProgressionCoach_Toggle()</Down>
            </Action>
            <Action name="ESO_ADVENTURER_SUITE_GAME_MODE_REPORT">
                <Down>ESOAdventurerSuite_ToggleGameModeReport()</Down>
            </Action>
            <Action name="ESO_ADVENTURER_SUITE_MAP_TELEPORTER_TOGGLE">
                <Down>ESOAdventurerSuite_ToggleMapTeleporterOverlay()</Down>
            </Action>
            <Action name="ESO_ADVENTURER_SUITE_POTION_MAKER">
                <Down>return ESOAdventurerSuite_OpenPotionMakerHotkey()</Down>
            </Action>
            <Action name="ESO_ADVENTURER_SUITE_TURBO_LEARNER">
                <Down>return ESOAdventurerSuite_OpenTurboLearnerHotkey()</Down>
            </Action>
            <Action name="ESO_ADVENTURER_SUITE_LOADOUT_SAVER">
                <Down>return ESOAdventurerSuite_ToggleLoadoutSaverHotkey()</Down>
            </Action>
            <Action name="ESO_ADVENTURER_SUITE_PREBUFF_ACCELERATION">
                <Down>return ESOAdventurerSuite_LoadoutPrebuffAcceleration()</Down>
            </Action>
            <Action name="ESO_ADVENTURER_SUITE_PREBUFF_DESTRO_ULT">
                <Down>return ESOAdventurerSuite_LoadoutPrebuffDestroUlt()</Down>
            </Action>
            <Action name="ESO_ADVENTURER_SUITE_PREBUFF_MANEUVER">
                <Down>return ESOAdventurerSuite_LoadoutPrebuffManeuver()</Down>
            </Action>
            <Action name="ESO_ADVENTURER_SUITE_PREBUFF_SIEGE_SHIELD">
                <Down>return ESOAdventurerSuite_LoadoutPrebuffSiegeShield()</Down>
            </Action>
            <Action name="ESO_ADVENTURER_SUITE_MASTER_ACHIEVEMENT_TRACKER">
                <Down>ESOAdventurerSuite_ToggleMasterAchievementTracker()</Down>
            </Action>
            <Action name="ESO_ADVENTURER_SUITE_SKILL_POINT_FINDER">
                <Down>ESOAdventurerSuite_ToggleSkillPointFinder()</Down>
            </Action>
            <Action name="ESO_ADVENTURER_SUITE_GF_OVERLAY">
                <Down>ESOAdventurerSuite_GroupFinderPlusToggleOverlay()</Down>
            </Action>
            <Action name="ESO_ADVENTURER_SUITE_GF_CATEGORY">
                <Down>ESOAdventurerSuite_GroupFinderPlusCycleCategory()</Down>
            </Action>
            <Action name="ESO_ADVENTURER_SUITE_GF_MODE">
                <Down>ESOAdventurerSuite_GroupFinderPlusSwitchMode()</Down>
            </Action>
            <Action name="ESO_ADVENTURER_SUITE_GF_RECREATE">
                <Down>ESOAdventurerSuite_GroupFinderPlusRecreate()</Down>
            </Action>
        </Category>
        <Category name="SI_BINDING_NAME_ESO_ADVENTURER_SUITE_ANTIQUITIES_CATEGORY">
            <Action name="ESO_ADVENTURER_SUITE_ANTIQUITY_LEAD_FINDER">
                <Down>ESOAdventurerSuite_ToggleAntiquityLeadFinder()</Down>
            </Action>
        </Category>
    </Layer>

    <Layer name="ESOAdventurerSuiteCodexLayer" allowFallthrough="true">
        <Category name="SI_KEYBINDINGS_CATEGORY_GENERAL">
            <Action name="ESO_PROGRESSION_COACH_TOGGLE_CODEX" hideAction="true" inheritsBindFrom="ESO_PROGRESSION_COACH_TOGGLE">
                <Down>ESOProgressionCoach_Toggle()</Down>
            </Action>
        </Category>
    </Layer>

    <Layer name="ESOAdventurerSuiteSettingsLayer" allowFallthrough="true">
        <Category name="SI_KEYBINDINGS_CATEGORY_GENERAL">
            <Action name="ESO_PROGRESSION_COACH_TOGGLE_SETTINGS" hideAction="true" inheritsBindFrom="ESO_PROGRESSION_COACH_TOGGLE">
                <Down>ESOProgressionCoach_Toggle()</Down>
            </Action>
        </Category>
    </Layer>

    <Layer name="ESOAdventurerSuiteLoadoutLayer" allowFallthrough="true">
        <Category name="SI_KEYBINDINGS_CATEGORY_GENERAL">
            <Action name="ESO_ADVENTURER_SUITE_LOADOUT_SAVER_CLOSE" hideAction="true" inheritsBindFrom="ESO_ADVENTURER_SUITE_LOADOUT_SAVER">
                <Down>return ESOAdventurerSuite_CloseLoadoutSaverHotkey()</Down>
            </Action>
            <Action name="ESO_PROGRESSION_COACH_FROM_LOADOUT_SAVER" hideAction="true" inheritsBindFrom="ESO_PROGRESSION_COACH_TOGGLE">
                <Down>ESOProgressionCoach_Toggle()</Down>
            </Action>
        </Category>
    </Layer>

    <Layer name="ESOAdventurerSuiteAntiquityLeadFinderLayer" allowFallthrough="true">
        <Category name="SI_KEYBINDINGS_CATEGORY_GENERAL">
            <Action name="ESO_ADVENTURER_SUITE_ANTIQUITY_LEAD_FINDER_CLOSE" hideAction="true" inheritsBindFrom="ESO_ADVENTURER_SUITE_ANTIQUITY_LEAD_FINDER">
                <Down>ESOAdventurerSuite_ToggleAntiquityLeadFinder()</Down>
            </Action>
        </Category>
    </Layer>

    <Layer name="ESOAdventurerSuiteGameModeReportLayer" allowFallthrough="true">
        <Category name="SI_KEYBINDINGS_CATEGORY_GENERAL">
            <Action name="ESO_ADVENTURER_SUITE_GAME_MODE_REPORT_CLOSE" hideAction="true" inheritsBindFrom="ESO_ADVENTURER_SUITE_GAME_MODE_REPORT">
                <Down>ESOAdventurerSuite_ToggleGameModeReport()</Down>
            </Action>
        </Category>
    </Layer>

    <Layer name="ESOAdventurerSuiteMapTeleporterLayer" allowFallthrough="true">
        <Category name="SI_KEYBINDINGS_CATEGORY_GENERAL">
            <Action name="ESO_ADVENTURER_SUITE_MAP_TELEPORTER_TOGGLE_CLOSE" hideAction="true" inheritsBindFrom="ESO_ADVENTURER_SUITE_MAP_TELEPORTER_TOGGLE">
                <Down>ESOAdventurerSuite_ToggleMapTeleporterOverlay()</Down>
            </Action>
        </Category>
    </Layer>

    <Layer name="ESOAdventurerSuitePotionMakerLayer" allowFallthrough="true">
        <Category name="SI_KEYBINDINGS_CATEGORY_GENERAL">
            <Action name="ESO_ADVENTURER_SUITE_POTION_MAKER_CLOSE" hideAction="true" inheritsBindFrom="ESO_ADVENTURER_SUITE_POTION_MAKER">
                <Down>return ESOAdventurerSuite_ClosePotionMakerHotkey()</Down>
            </Action>
            <Action name="ESO_ADVENTURER_SUITE_TURBO_LEARNER_FROM_POTION" hideAction="true" inheritsBindFrom="ESO_ADVENTURER_SUITE_TURBO_LEARNER">
                <Down>return ESOAdventurerSuite_OpenTurboLearnerHotkey()</Down>
            </Action>
        </Category>
    </Layer>

    <Layer name="ESOAdventurerSuiteTurboLearnerLayer" allowFallthrough="true">
        <Category name="SI_KEYBINDINGS_CATEGORY_GENERAL">
            <Action name="ESO_ADVENTURER_SUITE_TURBO_LEARNER_CLOSE" hideAction="true" inheritsBindFrom="ESO_ADVENTURER_SUITE_TURBO_LEARNER">
                <Down>return ESOAdventurerSuite_CloseTurboLearnerHotkey()</Down>
            </Action>
            <Action name="ESO_ADVENTURER_SUITE_POTION_MAKER_FROM_TURBO" hideAction="true" inheritsBindFrom="ESO_ADVENTURER_SUITE_POTION_MAKER">
                <Down>return ESOAdventurerSuite_OpenPotionMakerHotkey()</Down>
            </Action>
        </Category>
    </Layer>
</Bindings>
