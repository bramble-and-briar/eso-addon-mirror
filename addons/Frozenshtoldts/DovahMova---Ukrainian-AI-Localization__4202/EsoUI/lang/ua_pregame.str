[SI_GRAPHICSMODE0] = "Якість"
[SI_GRAPHICSMODE1] = "Продуктивність"
[SI_GRAPHICSPRESETS0] = "Мінімум"
[SI_GRAPHICSPRESETS1] = "Низькі"
