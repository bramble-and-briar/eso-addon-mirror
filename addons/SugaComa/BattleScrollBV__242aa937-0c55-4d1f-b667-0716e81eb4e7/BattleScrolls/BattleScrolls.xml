<GuiXml>
    <Controls>
        <Control name="BattleScrolls_OverviewSectionHeader" virtual="true">
            <Dimensions y="50" />
            <Controls>
                <Label name="$(parent)Title" font="ZoFontGamepadBold34" modifyTextType="UPPERCASE" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED" verticalAlignment="BOTTOM">
                    <Anchor point="BOTTOMLEFT" offsetY="-5" />
                </Label>
            </Controls>
        </Control>
        <Control name="BattleScrolls_ChampionDisciplineHeader" virtual="true">
            <Dimensions y="30" />
            <Controls>
                <Label name="$(parent)Label" font="ZoFontGamepad27" modifyTextType="UPPERCASE" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL" maxLineCount="1" wrapMode="ELLIPSIS" verticalAlignment="BOTTOM">
                    <Anchor point="BOTTOMLEFT" offsetY="-2" />
                </Label>
            </Controls>
        </Control>
        <TopLevelControl name="BattleScrollsBuildViewerRoot" hidden="true">
            <OnInitialized>
                BattleScrolls_BuildViewer_OnInitialized(self)
            </OnInitialized>
            <Controls>
                <Control name="$(parent)OverviewPane" inherits="ZO_GamepadGrid_NavQuadrant_2_3_4_Anchors" hidden="true">
                    <Controls>
                        <Control name="$(parent)NestedBg" inherits="ZO_SharedGamepadNavQuadrant_2_3_4_Background_Template" />
                        <Control name="$(parent)Q2Container" inherits="ZO_ScrollContainer_Gamepad">
                            <Dimensions x="700" />
                            <Anchor point="TOPLEFT" offsetX="50" offsetY="54" />
                            <Anchor point="BOTTOMLEFT" offsetX="50" offsetY="-10" />
                            <Controls>
                                <Control name="$(parent)ScrollChild" override="true" resizeToFitConstrains="Y">
                                    <Dimensions x="100%" />
                                </Control>
                            </Controls>
                        </Control>
                        <Control name="$(parent)Q3Container" inherits="ZO_ScrollContainer_Gamepad">
                            <Anchor point="TOPLEFT" relativeTo="$(parent)Q2Container" relativePoint="TOPRIGHT" offsetX="50" />
                            <Anchor point="BOTTOMRIGHT" offsetX="-40" offsetY="-10" />
                            <Controls>
                                <Control name="$(parent)ScrollChild" override="true" resizeToFitConstrains="Y">
                                    <Dimensions x="100%" />
                                </Control>
                            </Controls>
                        </Control>
                        <Label name="$(parent)LoadingLabel" font="ZoFontGamepadBold34" color="GAMEPAD_NAV_QUADRANT_TEXT_DISABLED" horizontalAlignment="CENTER" verticalAlignment="CENTER" hidden="true">
                            <Anchor point="CENTER" />
                        </Label>
                    </Controls>
                </Control>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>