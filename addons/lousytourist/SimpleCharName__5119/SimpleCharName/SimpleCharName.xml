<GuiXml>
    <Controls>
        <TopLevelControl name="SimpleCharNameWindow" mouseEnabled="true" movable="true" clampedToScreen="true">
            <Dimensions x="220" y="36" />
            <Anchor point="CENTER" relativeTo="GuiRoot" relativePoint="CENTER" offsetX="0" offsetY="-300" />
            
            <OnMoveStop>
                SimpleCharName.OnMoveStop()
            </OnMoveStop>

            <Controls>
                <Backdrop name="$(parent)BG" inherits="ZO_DefaultBackdrop" alpha="0.6">
                    <AnchorFill />
                </Backdrop>
                
                <Label name="$(parent)Label" font="ZoFontWinH3" color="FFFFFF" horizontalAlignment="CENTER" verticalAlignment="CENTER">
                    <AnchorFill />
                </Label>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
