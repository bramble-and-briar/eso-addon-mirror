[SI_ZONECOMPLETIONTYPE1] = "Missões de História da Zona"
[SI_ZONECOMPLETIONTYPE10] = "Locais Marcantes"
[SI_ZONECOMPLETIONTYPE11] = "Livros da Biblioteca de Shalidor"
[SI_ZONECOMPLETIONTYPE12] = "Pedras de Mundus"
