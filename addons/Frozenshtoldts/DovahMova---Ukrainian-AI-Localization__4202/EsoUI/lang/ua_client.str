[SI_GAMEPAD_ALCHEMY_MATCHING_TRAIT_NARRATION] = "Відповідність"
[SI_GAMEPAD_ALCHEMY_MISSING_OR_UNKNOWN_MESSAGE] = "Відсутні предмети/Властивості \n\nВам бракує матеріалів або ви не розкрили властивості, щоб створити це. Експериментуйте з наявними матеріалами, щоб відкрити нові властивості. Ви також можете придбати додаткові матеріали, відвідавши гільдійські крамниці або збираючи те, що росте по всьому Тамріелю."
