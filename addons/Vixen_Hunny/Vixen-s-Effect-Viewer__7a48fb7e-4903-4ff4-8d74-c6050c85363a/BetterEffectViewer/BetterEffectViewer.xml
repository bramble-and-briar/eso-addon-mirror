<GuiXml>
    <Controls>

        <!-- Effect slot: thin coloured frame, cropped icon, radial duration sweep,
             stack count (top right) and timer (bottom centre). Colours, fonts and
             insets are applied from Lua so they follow the settings. -->
        <Control name="BetterEffectViewer_SlotTemplate" virtual="true" hidden="true">
            <Dimensions x="32" y="32" />
            <Controls>
                <Backdrop name="$(parent)Border">
                    <AnchorFill />
                    <Edge edgeSize="1" />
                </Backdrop>

                <Texture name="$(parent)Icon" level="1">
                    <Anchor point="TOPLEFT" offsetX="1" offsetY="1" />
                    <Anchor point="BOTTOMRIGHT" offsetX="-1" offsetY="-1" />
                    <TextureCoords left="0.07" right="0.93" top="0.07" bottom="0.93" />
                </Texture>

                <Cooldown name="$(parent)Sweep" level="2" hidden="true">
                    <Anchor point="TOPLEFT" offsetX="1" offsetY="1" />
                    <Anchor point="BOTTOMRIGHT" offsetX="-1" offsetY="-1" />
                </Cooldown>

                <Label name="$(parent)Count" font="ZoFontGameSmall" layer="OVERLAY"
                       horizontalAlignment="RIGHT" verticalAlignment="TOP">
                    <Anchor point="TOPRIGHT" offsetX="-1" offsetY="-2" />
                </Label>

                <Label name="$(parent)Timer" font="ZoFontGameSmall" layer="OVERLAY"
                       horizontalAlignment="CENTER" verticalAlignment="BOTTOM">
                    <Anchor point="BOTTOM" offsetY="2" />
                </Label>
            </Controls>
        </Control>

        <!-- Main window. Shown/hidden with the HUD by a scene fragment; the Content
             child is what fades in and out with the reticle target. -->
        <TopLevelControl name="BetterEffectViewer_Window" hidden="true" clampedToScreen="true"
                         mouseEnabled="false" movable="false">
            <Dimensions x="340" y="80" />
            <Anchor point="TOP" relativeTo="GuiRoot" relativePoint="CENTER" offsetY="-290" />
            <Controls>

                <!-- Visible only while unlocked -->
                <Backdrop name="$(parent)EditOverlay" hidden="true">
                    <Anchor point="TOPLEFT" offsetX="-8" offsetY="-8" />
                    <Anchor point="BOTTOMRIGHT" offsetX="8" offsetY="8" />
                    <Edge edgeSize="1" />
                </Backdrop>

                <Label name="$(parent)EditHint" hidden="true" font="ZoFontGameSmall"
                       horizontalAlignment="CENTER"
                       text="Drag to move  -  /bev lock when done">
                    <Anchor point="TOP" relativePoint="BOTTOM" offsetY="12" />
                </Label>

                <Control name="$(parent)Content" hidden="true">
                    <Anchor point="TOPLEFT" />
                    <Dimensions x="340" y="80" />
                    <Controls>

                        <!-- Target name plate with a reaction-coloured accent line -->
                        <Control name="$(parent)Header">
                            <Dimensions x="160" y="26" />
                            <Anchor point="TOP" />
                            <Controls>
                                <Backdrop name="$(parent)Bg">
                                    <AnchorFill />
                                    <Edge edgeSize="1" />
                                </Backdrop>

                                <Texture name="$(parent)Accent" level="1">
                                    <Anchor point="BOTTOMLEFT" offsetX="1" offsetY="-1" />
                                    <Anchor point="BOTTOMRIGHT" offsetX="-1" offsetY="-1" />
                                    <Dimensions y="2" />
                                </Texture>

                                <Label name="$(parent)Name" font="ZoFontGameBold" level="2"
                                       horizontalAlignment="CENTER" verticalAlignment="CENTER">
                                    <Anchor point="TOPLEFT" offsetX="12" />
                                    <Anchor point="BOTTOMRIGHT" offsetX="-12" offsetY="-2" />
                                </Label>
                            </Controls>
                        </Control>

                        <Control name="$(parent)Buffs" />
                        <Control name="$(parent)Debuffs" />
                    </Controls>
                </Control>
            </Controls>
        </TopLevelControl>

    </Controls>
</GuiXml>
