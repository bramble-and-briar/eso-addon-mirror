[SI_GUILD_LEAVE_WARNING_LEADER] = "Ви — Гільдмайстер. Вихід передасть звання Гільдмайстра гравцеві з найвищим рангом, який найдовше перебував у гільдії.\n\nВи впевнені, що хочете покинути: <<X:1>>|cffffff<<2>>|r?"
