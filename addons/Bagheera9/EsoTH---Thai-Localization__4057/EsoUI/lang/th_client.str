[SI_INTERFACE_OPTIONS_BATTLE_LEVEL_RESTRICTION] = "This setting may only be changed in locations that do not use Battle Levels."
[SI_INTERFACE_OPTIONS_BATTLE_LEVEL_TOOLTIP] = "Automatically adjusts the stats of your character to be competitive with other players in the Alliance War."
[SI_INTERFACE_OPTIONS_CAMERA_ASSASSINATION_CAMERA] = "Assassination Camera"
[SI_INTERFACE_OPTIONS_CAMERA_ASSASSINATION_CAMERA_TOOLTIP] = "Enables usage of cinematic kill camera during assassinations."
