[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION102] = ".ﺔﻴﻟﺍﺭﺪﻴﻔﻟﺍ ﺕﺎﻄﻠﺴﻟﺍ ﻞﺧﺪﺗ ﺐﻠﻄﺘﺗ ﺪﻗ ﺔﻟﺎﺣ ﺔﻈﺣﻣ ﺪﻨﻋ ﺭﺎﻴﺨﻟﺍ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION103] = ".ﺔﻃﺮﺸﻟﺍ ﻭﺃ ﺕﺎﻄﻠﺴﻟﺍ ﺐﻧﺎﺟ ﻦﻣ ﺔﻣﺳ ﺺﺤﻓ ﺀﺍﺮﺟ ﻪﻨﻋ ﻍﺑﺍ ﺐﺠﻳ ﺎﻛًﻮﻠﺳ ﺖﻈﺣ ﺍﺫﺇ ﺭﺎﻴﺨﻟﺍ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION104] = ".ﻍﺒﻟﺍ ﺍﺬﻫ ﻝﺎﺳﺭﺇ ﻰﻟﺇ ﺔﻓﺎﺿﺎﺑ ،ﺔﻴﻠﺤﻤﻟﺍ ﺉﺭﺍﻮﻄﻟﺍ ﺕﺎﻣﺪﺧ ﻊﻣ ﻞﺻﺍﻮﺘﻟﺍ ﻰﺟﺮﻳُ ،ﻚﻴﺷﻭ ﺮﻄﺧ ﺩﻮﺟﻭ ﺔﻟﺎﺣ ﻲﻓ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION201] = ".ﻲﺴﻨﺠﻟﺍ ﻪﺟﻮﺘﻟﺍ ﻭﺃ ﻦﻳﺪﻟﺍ ﻭﺃ ﺔﻴﺴﻨﺠﻟﺍ ﻭﺃ ﻕﺮﻌِﻟﺍ ﺱﺎﺳﺃ ﻰﻠﻋ ﺎﻤﻴﺳ ﻭ ،ﺔﻨﻴﻌﻣ ﺔﻋﻮﻤﺠﻣ ﺪﺿ ﺰﻴﺤﺗ ﻰﻠﻋ ﻱﻮﻄﻨﺗ ﺔﺌﻴﺴﻣ ﺕﺎﺑﺎﺘﻛ ﻭﺃ ﻡﻛ ﻦﻋ ﻍﺑﻟ ﺭﺎﻴﺨﻟﺍ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION202] = ".ﻊﻤﺘﺠﻤﻟﺍ ﺔﺑﺮﺠﺗ ﻭﺃ ﺔﺒﻌﻠﻟﺍ ﺔﺌﻴﺑ ﺩﺎﺴﻓﺇ ﺪﻤﻌﺘﻳ ﺺﺨﺷ ﻦﻋ ﻍﺑﻟ ﺭﺎﻴﺨﻟﺍ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION203] = ".ﺔﺷﺩﺭﺪﻟﺍ ﺓﺎﻨﻗ ﻲﻓ ﻞﺻﺍﻮﺘﻣ ﻞﻜﺸﺑ ﺎﻬﺴﻔﻧ ﺔﻟﺎﺳﺮﻟﺍ ﺭﺮﻜﻳ ﺐﻋ ﻦﻋ ﻍﺑﻟ ﺭﺎﻴﺨﻟﺍ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ"
