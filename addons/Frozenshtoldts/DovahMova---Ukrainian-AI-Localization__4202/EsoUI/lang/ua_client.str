[SI_GAMEPAD_DYEING_COMPANION_COLLECTIBLE_TAB] = "Костюм супутника"
[SI_GAMEPAD_DYEING_COMPANION_COLLECTIBLE_TAB_DESCRIPTION_LOCKED] = "Застосування барвників до костюма вашого активного супутника наразі недоступне. Ця функція вимагає активного супутника і може бути розблокована за допомогою членства ESO Plus."
[SI_GAMEPAD_DYEING_COMPANION_COLLECTIBLE_TAB_DESCRIPTION_UNLOCKED] = "Ви можете отримати доступ до вкладки зовнішнього вигляду колекції та застосовувати барвники до костюма вашого активного супутника, поки ви є учасником ESO Plus.\n\nФарбування костюма супутника також пофарбує цей костюм для вашого гравця."
[SI_GAMEPAD_DYEING_COMPANION_EQUIPMENT_TAB] = "Спорядження супутника"
[SI_GAMEPAD_DYEING_COMPANION_EQUIPMENT_TAB_DESCRIPTION] = "Налаштуйте вигляд спорядження вашого активного супутника за допомогою розблокованих барвників та стилів вбрання.\n\nЦя функція вимагає активного супутника.\n\nВбрання супутників є спільними для всього облікового запису."
[SI_GAMEPAD_DYEING_DISCARD_CHANGES_BODY] = "Ви впевнені, що хочете вийти?\n\nУсі ваші зміни буде скасовано."
