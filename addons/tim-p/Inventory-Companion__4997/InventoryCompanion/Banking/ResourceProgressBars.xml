                <Texture name="$(parent)Icon" parentKey="icon" mouseEnabled="false">
                    <Dimensions x="22" y="22"/>
                    <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="0" offsetY="0"/>
                </Texture>
                <Texture name="$(parent)TrackBG" parentKey="trackBG" mouseEnabled="false">
                    <Dimensions x="206" y="22"/>
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Icon" relativePoint="TOPRIGHT" offsetX="6" offsetY="0"/>
                </Texture>
                <StatusBar name="$(parent)Bar" parentKey="bar">
                    <Dimensions x="200" y="22"/>
