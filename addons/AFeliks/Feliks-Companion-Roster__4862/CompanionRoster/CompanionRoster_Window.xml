<GuiXml>
    <Controls>
        <!-- One companion row: Companion name, Level, Rapport (raw value/max).
             Instantiated MAX_COMPANION_ROWS times below as fixed, permanent
             controls - no scroll list, no pooling. Unused rows are just hidden. -->
        <Control name="CompanionRoster_CompanionRow" virtual="true">
            <Dimensions x="350" y="26" />

            <Controls>
                <Backdrop name="$(parent)Stripe" centerColor="00000000" edgeColor="00000000">
                    <AnchorFill />
                </Backdrop>
                <Label name="$(parent)Companion" font="ZoFontWinH5" horizontalAlignment="LEFT" verticalAlignment="CENTER" mouseEnabled="true">
                    <Dimensions x="136" />
                    <Anchor point="LEFT" offsetX="16" />
                    <OnMouseUp>
                        if button == MOUSE_BUTTON_INDEX_LEFT and upInside then
                            CompanionRoster.OnCompanionMouseUp(self)
                        end
                    </OnMouseUp>
                    <OnMouseEnter>
                        CompanionRoster.OnCompanionMouseEnter(self)
                    </OnMouseEnter>
                    <OnMouseExit>
                        ZO_Tooltips_HideTextTooltip()
                    </OnMouseExit>
                </Label>
                <Control name="$(parent)Role" mouseEnabled="true">
                    <Dimensions x="34" y="20" />
                    <Anchor point="LEFT" relativeTo="$(parent)Companion" relativePoint="RIGHT" offsetX="4" />
                    <OnMouseUp>
                        if button == MOUSE_BUTTON_INDEX_RIGHT and upInside then
                            CompanionRoster.OnRoleMouseUp(self)
                        end
                    </OnMouseUp>
                    <OnMouseEnter>
                        CompanionRoster.OnRoleMouseEnter(self)
                    </OnMouseEnter>
                    <OnMouseExit>
                        ZO_Tooltips_HideTextTooltip()
                    </OnMouseExit>
                    <Controls>
                        <Texture name="$(parent)Icon">
                            <Dimensions x="20" y="20" />
                            <Anchor point="CENTER" />
                        </Texture>
                        <Texture name="$(parent)Icon2" hidden="true">
                            <Dimensions x="16" y="16" />
                            <Anchor point="LEFT" relativeTo="$(parent)Icon" relativePoint="RIGHT" offsetX="2" />
                        </Texture>
                    </Controls>
                </Control>
                <Label name="$(parent)Level" font="ZoFontWinH5" horizontalAlignment="CENTER" verticalAlignment="CENTER" mouseEnabled="true">
                    <Dimensions x="55" />
                    <Anchor point="LEFT" relativeTo="$(parent)Role" relativePoint="RIGHT" offsetX="4" />
                    <OnMouseEnter>
                        CompanionRoster.OnLevelMouseEnter(self)
                    </OnMouseEnter>
                    <OnMouseExit>
                        ZO_Tooltips_HideTextTooltip()
                    </OnMouseExit>
                </Label>
                <Label name="$(parent)Rapport" font="ZoFontWinH5" horizontalAlignment="CENTER" verticalAlignment="CENTER" mouseEnabled="true">
                    <Dimensions x="90" />
                    <Anchor point="LEFT" relativeTo="$(parent)Level" relativePoint="RIGHT" offsetX="2" />
                    <OnMouseEnter>
                        CompanionRoster.OnRapportMouseEnter(self)
                    </OnMouseEnter>
                    <OnMouseExit>
                        ZO_Tooltips_HideTextTooltip()
                    </OnMouseExit>
                </Label>
            </Controls>
        </Control>

        <TopLevelControl name="CompanionRosterWindow" movable="true" mouseEnabled="true" clampedToScreen="true" hidden="true">
            <Dimensions x="360" y="350" />
            <Anchor point="CENTER" />

            <OnMoveStop>
                CompanionRoster.OnWindowMoveStop(self)
            </OnMoveStop>

            <Controls>
                <Backdrop name="$(parent)Bg" inherits="ZO_DefaultBackdrop">
                    <AnchorFill />
                </Backdrop>

                <Control name="$(parent)Header" mouseEnabled="true">
                    <Dimensions y="32" />
                    <Anchor point="TOPLEFT" />
                    <Anchor point="TOPRIGHT" />

                    <OnMouseDown>
                        if button == MOUSE_BUTTON_INDEX_LEFT then
                            CompanionRosterWindow:StartMoving()
                        end
                    </OnMouseDown>
                    <OnMouseUp>
                        CompanionRosterWindow:StopMovingOrResizing()
                    </OnMouseUp>

                    <Controls>
                        <Label name="$(parent)Title" font="ZoFontWinH3" text="Feliks' Companion Roster" horizontalAlignment="CENTER" verticalAlignment="CENTER">
                            <AnchorFill />
                        </Label>
                    </Controls>
                </Control>

                <Button name="$(parent)CloseButton" inherits="ZO_CloseButton">
                    <OnClicked>
                        CompanionRosterWindow:SetHidden(true)
                    </OnClicked>
                </Button>

                <Control name="$(parent)CharacterDropdown" inherits="ZO_ComboBox" mouseEnabled="true">
                    <Dimensions x="280" y="30" />
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Header" relativePoint="BOTTOMLEFT" offsetX="20" offsetY="10" />
                </Control>

                <Label name="$(parent)ColumnCompanion" font="ZoFontWinH5" text="Companion" horizontalAlignment="LEFT" verticalAlignment="CENTER">
                    <Dimensions x="150" />
                    <Anchor point="TOPLEFT" relativeTo="$(parent)CharacterDropdown" relativePoint="BOTTOMLEFT" offsetX="0" offsetY="14" />
                </Label>
                <Label name="$(parent)ColumnLevel" font="ZoFontWinH5" text="Level" horizontalAlignment="CENTER" verticalAlignment="CENTER">
                    <Dimensions x="55" />
                    <Anchor point="LEFT" relativeTo="$(parent)ColumnCompanion" relativePoint="RIGHT" offsetX="28" />
                </Label>
                <Label name="$(parent)ColumnRapport" font="ZoFontWinH5" text="Rapport" horizontalAlignment="CENTER" verticalAlignment="CENTER">
                    <Dimensions x="90" />
                    <Anchor point="LEFT" relativeTo="$(parent)ColumnLevel" relativePoint="RIGHT" offsetX="2" />
                </Label>

                <Backdrop name="$(parent)HeaderDivider" centerColor="FFFFFF40" edgeColor="00000000">
                    <Dimensions y="1" />
                    <Anchor point="TOPLEFT" relativeTo="$(parent)ColumnCompanion" relativePoint="BOTTOMLEFT" offsetX="-16" offsetY="6" />
                    <Anchor point="TOPRIGHT" relativeTo="$(parent)ColumnRapport" relativePoint="BOTTOMRIGHT" offsetX="12" offsetY="6" />
                </Backdrop>

                <Control name="$(parent)Row1" inherits="CompanionRoster_CompanionRow">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)ColumnCompanion" relativePoint="BOTTOMLEFT" offsetX="-16" offsetY="10" />
                </Control>
                <Control name="$(parent)Row2" inherits="CompanionRoster_CompanionRow">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Row1" relativePoint="BOTTOMLEFT" />
                </Control>
                <Control name="$(parent)Row3" inherits="CompanionRoster_CompanionRow">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Row2" relativePoint="BOTTOMLEFT" />
                </Control>
                <Control name="$(parent)Row4" inherits="CompanionRoster_CompanionRow">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Row3" relativePoint="BOTTOMLEFT" />
                </Control>
                <Control name="$(parent)Row5" inherits="CompanionRoster_CompanionRow">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Row4" relativePoint="BOTTOMLEFT" />
                </Control>
                <Control name="$(parent)Row6" inherits="CompanionRoster_CompanionRow">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Row5" relativePoint="BOTTOMLEFT" />
                </Control>
                <Control name="$(parent)Row7" inherits="CompanionRoster_CompanionRow">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Row6" relativePoint="BOTTOMLEFT" />
                </Control>
                <Control name="$(parent)Row8" inherits="CompanionRoster_CompanionRow">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Row7" relativePoint="BOTTOMLEFT" />
                </Control>

                <Label name="$(parent)Footer" font="ZoFontGameSmall" horizontalAlignment="RIGHT" verticalAlignment="CENTER" mouseEnabled="true">
                    <Anchor point="BOTTOMRIGHT" offsetX="-10" offsetY="-8" />
                    <OnMouseUp>
                        if button == MOUSE_BUTTON_INDEX_LEFT and upInside then
                            CompanionRoster.OnFooterClicked()
                        end
                    </OnMouseUp>
                    <OnMouseEnter>
                        CompanionRoster.OnFooterMouseEnter(self)
                    </OnMouseEnter>
                    <OnMouseExit>
                        CompanionRoster.OnFooterMouseExit(self)
                    </OnMouseExit>
                </Label>
            </Controls>
        </TopLevelControl>

        <!-- Results popup for /fcr s and /fcr c. The pieces below are built at
             runtime from these two templates and parented to the scroll
             container's own ScrollChild (see CompanionRoster.ShowResults). -->

        <!-- A plain wrapped line of text: a heading, a like/dislike line, a note. -->
        <Label name="CompanionRoster_ResultText" font="ZoFontGame" virtual="true">
            <Dimensions x="500" />
        </Label>

        <!-- One /fcr s result: companion name (hover for their Guild skill lines),
             their rapport and Guild rank beside it, and the rapport action
             wrapped underneath. -->
        <Control name="CompanionRoster_ResultRow" resizeToFitDescendents="true" virtual="true">
            <Controls>
                <Label name="$(parent)Name" font="ZoFontGameBold" mouseEnabled="true">
                    <Anchor point="TOPLEFT" />
                    <OnMouseEnter>
                        CompanionRoster.OnResultNameMouseEnter(self)
                    </OnMouseEnter>
                    <OnMouseExit>
                        ZO_Tooltips_HideTextTooltip()
                    </OnMouseExit>
                </Label>
                <Label name="$(parent)Info" font="ZoFontGame">
                    <Anchor point="LEFT" relativeTo="$(parent)Name" relativePoint="RIGHT" offsetX="8" />
                </Label>
                <Label name="$(parent)Detail" font="ZoFontGame">
                    <Dimensions x="480" />
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Name" relativePoint="BOTTOMLEFT" offsetX="16" offsetY="2" />
                </Label>
            </Controls>
        </Control>

        <TopLevelControl name="CompanionRosterResults" movable="true" resizeHandleSize="8" mouseEnabled="true" clampedToScreen="true" hidden="true">
            <Dimensions x="560" y="420" />
            <DimensionConstraints minX="360" minY="220" />
            <Anchor point="CENTER" />

            <OnMoveStop>
                CompanionRoster.OnResultsMoveStop(self)
            </OnMoveStop>
            <OnResizeStop>
                CompanionRoster.OnResultsResizeStop(self)
            </OnResizeStop>

            <Controls>
                <Backdrop name="$(parent)Bg" inherits="ZO_DefaultBackdrop">
                    <AnchorFill />
                </Backdrop>

                <Control name="$(parent)Header" mouseEnabled="true">
                    <Dimensions y="32" />
                    <Anchor point="TOPLEFT" />
                    <Anchor point="TOPRIGHT" />

                    <OnMouseDown>
                        if button == MOUSE_BUTTON_INDEX_LEFT then
                            CompanionRosterResults:StartMoving()
                        end
                    </OnMouseDown>
                    <OnMouseUp>
                        CompanionRosterResults:StopMovingOrResizing()
                    </OnMouseUp>

                    <Controls>
                        <Label name="$(parent)Title" font="ZoFontWinH3" horizontalAlignment="CENTER" verticalAlignment="CENTER">
                            <AnchorFill />
                        </Label>
                    </Controls>
                </Control>

                <Button name="$(parent)CloseButton" inherits="ZO_CloseButton">
                    <OnClicked>
                        CompanionRosterResults:SetHidden(true)
                    </OnClicked>
                </Button>

                <Control name="$(parent)Container" inherits="ZO_ScrollContainer">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Header" relativePoint="BOTTOMLEFT" offsetX="16" offsetY="8" />
                    <Anchor point="BOTTOMRIGHT" offsetX="-16" offsetY="-32" />
                </Control>

                <!-- Same footer as the roster window: addon name, version, and
                     a click-through to the ESOUI page. -->
                <Label name="$(parent)Footer" font="ZoFontGameSmall" horizontalAlignment="RIGHT" verticalAlignment="CENTER" mouseEnabled="true">
                    <Anchor point="BOTTOMRIGHT" offsetX="-10" offsetY="-8" />
                    <OnMouseUp>
                        if button == MOUSE_BUTTON_INDEX_LEFT and upInside then
                            CompanionRoster.OnFooterClicked()
                        end
                    </OnMouseUp>
                    <OnMouseEnter>
                        CompanionRoster.OnFooterMouseEnter(self)
                    </OnMouseEnter>
                    <OnMouseExit>
                        CompanionRoster.OnFooterMouseExit(self)
                    </OnMouseExit>
                </Label>
            </Controls>
        </TopLevelControl>

        <!-- The always-visible Companion Info line (see CompanionRoster_HUD.lua).
             Inherits ZO_HUDManager_Element so the base game's Edit HUD can move
             it: the control needs exactly ONE anchor, and the inherited
             $(parent)HUDElementRef child is what sizes its box in the editor.
             The default position is set in Lua (config.defaultAnchor) and the
             width is set to fit the text, so none is given here. -->
        <TopLevelControl name="CompanionRosterHUD" inherits="ZO_HUDManager_Element" hidden="true">
            <Dimensions x="200" y="24" />
            <Anchor point="TOPLEFT" relativeTo="GuiRoot" relativePoint="TOPLEFT" offsetX="9" offsetY="6" />
            <Controls>
                <Backdrop name="$(parent)BG" centerColor="66000000" edgeColor="00000000">
                    <AnchorFill />
                </Backdrop>
                <Label name="$(parent)Text" font="ZoFontGame" horizontalAlignment="LEFT" verticalAlignment="CENTER">
                    <Anchor point="LEFT" offsetX="6" />
                </Label>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
