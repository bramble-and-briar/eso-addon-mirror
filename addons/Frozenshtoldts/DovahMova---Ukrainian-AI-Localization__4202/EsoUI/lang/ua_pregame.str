[SI_GREGORIANCALENDARMONTHS4] = "Квітень"
[SI_GREGORIANCALENDARMONTHS5] = "Травень"
[SI_GREGORIANCALENDARMONTHS6] = "Червень"
[SI_GREGORIANCALENDARMONTHS7] = "Липень"
