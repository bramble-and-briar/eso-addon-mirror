<GuiXml>
    <Controls>
        <!--
                        Recycled material-list controls. Lua builds the window shell, applies
                        shared styling, and overrides column layout for the active mode.
                        Keep text-column names in sync with DetailWindow's ROW_COLUMNS.
                        Row heights are set by UI.RowHeight for the selected density.
        -->
        <Control name="BureauOfMaterialWorth_DetailList" inherits="ZO_ScrollList" virtual="true" />

        <Control name="BureauOfMaterialWorth_DetailRow" virtual="true" mouseEnabled="true">
            <Dimensions y="26" />
            <Controls>
                <Backdrop name="$(parent)Hover" hidden="true">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" />
                    <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)" relativePoint="BOTTOMRIGHT" />
                </Backdrop>

                <Texture name="$(parent)CumThresholdMarker" hidden="true">
                    <Dimensions x="3" y="20" />
                    <Anchor point="LEFT" relativeTo="$(parent)" relativePoint="LEFT" />
                </Texture>

                <Texture name="$(parent)Icon">
                    <Dimensions x="24" y="24" />
                    <Anchor point="LEFT" relativeTo="$(parent)" relativePoint="LEFT" offsetX="6" />
                </Texture>

                <Button name="$(parent)Withdraw" hidden="true">
                    <Dimensions x="22" y="22" />
                    <Anchor point="RIGHT" relativeTo="$(parent)" relativePoint="RIGHT" offsetX="-2" />
                </Button>

                <Button name="$(parent)Queue" hidden="true">
                    <Dimensions x="22" y="22" />
                    <Anchor point="RIGHT" relativeTo="$(parent)Withdraw" relativePoint="LEFT" offsetX="-4" />
                </Button>

                <Label name="$(parent)Impact" hidden="true" horizontalAlignment="RIGHT" verticalAlignment="CENTER">
                    <Dimensions x="130" />
                    <Anchor point="RIGHT" relativeTo="$(parent)" relativePoint="RIGHT" offsetX="-2" />
                </Label>

                <Label name="$(parent)Change" horizontalAlignment="RIGHT" verticalAlignment="CENTER">
                    <Dimensions x="90" />
                    <Anchor point="RIGHT" relativeTo="$(parent)Queue" relativePoint="LEFT" offsetX="-6" />
                </Label>

                <Label name="$(parent)Cum" horizontalAlignment="RIGHT" verticalAlignment="CENTER">
                    <Dimensions x="70" />
                    <Anchor point="RIGHT" relativeTo="$(parent)Change" relativePoint="LEFT" offsetX="-6" />
                </Label>

                <Label name="$(parent)Value" horizontalAlignment="RIGHT" verticalAlignment="CENTER">
                    <Dimensions x="150" />
                    <Anchor point="RIGHT" relativeTo="$(parent)Cum" relativePoint="LEFT" offsetX="-6" />
                </Label>

                <Label name="$(parent)Qty" horizontalAlignment="RIGHT" verticalAlignment="CENTER">
                    <Dimensions x="70" />
                    <Anchor point="RIGHT" relativeTo="$(parent)Value" relativePoint="LEFT" offsetX="-6" />
                </Label>

                <Backdrop name="$(parent)SourceBg">
                    <Dimensions x="40" y="18" />
                    <Anchor point="RIGHT" relativeTo="$(parent)Qty" relativePoint="LEFT" offsetX="-6" />
                </Backdrop>

                <Label name="$(parent)Source" horizontalAlignment="CENTER" verticalAlignment="CENTER">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)SourceBg" relativePoint="TOPLEFT" />
                    <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)SourceBg" relativePoint="BOTTOMRIGHT" />
                </Label>

                <Label name="$(parent)Name" horizontalAlignment="LEFT" verticalAlignment="CENTER">
                    <Anchor point="LEFT" relativeTo="$(parent)Icon" relativePoint="RIGHT" offsetX="6" />
                    <Anchor point="RIGHT" relativeTo="$(parent)SourceBg" relativePoint="LEFT" offsetX="-6" />
                </Label>
            </Controls>
        </Control>

        <!--
                        Recycled queue rows with editable quantity and a remove action.
                        WithdrawDialog applies styling and density-dependent row height.
        -->
        <Control name="BureauOfMaterialWorth_WithdrawQueueList" inherits="ZO_ScrollList" virtual="true" />

        <Control name="BureauOfMaterialWorth_WithdrawQueueRow" virtual="true" mouseEnabled="true">
            <Dimensions y="28" />
            <Controls>
                <Backdrop name="$(parent)Hover" hidden="true">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" />
                    <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)" relativePoint="BOTTOMRIGHT" />
                </Backdrop>

                <Texture name="$(parent)Icon">
                    <Dimensions x="24" y="24" />
                    <Anchor point="LEFT" relativeTo="$(parent)" relativePoint="LEFT" offsetX="2" />
                </Texture>

                <Button name="$(parent)Remove" inherits="ZO_CloseButton">
                    <Anchor point="RIGHT" relativeTo="$(parent)" relativePoint="RIGHT" offsetX="-4" />
                </Button>

                <Label name="$(parent)Value" horizontalAlignment="RIGHT" verticalAlignment="CENTER">
                    <Dimensions x="120" />
                    <Anchor point="RIGHT" relativeTo="$(parent)Remove" relativePoint="LEFT" offsetX="-8" />
                </Label>

                <Backdrop name="$(parent)QtyBg" inherits="ZO_DefaultBackdrop">
                    <Dimensions x="64" y="24" />
                    <Anchor point="RIGHT" relativeTo="$(parent)Value" relativePoint="LEFT" offsetX="-8" />
                    <Controls>
                        <EditBox name="$(parent)Edit" inherits="ZO_DefaultEditForBackdrop">
                            <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="4" offsetY="1" />
                            <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)" relativePoint="BOTTOMRIGHT" offsetX="-4" offsetY="-1" />
                        </EditBox>
                    </Controls>
                </Backdrop>

                <Label name="$(parent)Name" horizontalAlignment="LEFT" verticalAlignment="CENTER">
                    <Anchor point="LEFT" relativeTo="$(parent)Icon" relativePoint="RIGHT" offsetX="6" />
                    <Anchor point="RIGHT" relativeTo="$(parent)QtyBg" relativePoint="LEFT" offsetX="-6" />
                </Label>
            </Controls>
        </Control>
    </Controls>
</GuiXml>
