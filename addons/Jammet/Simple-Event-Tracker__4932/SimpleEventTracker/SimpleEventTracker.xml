<GuiXml>
	<Controls>
		<TopLevelControl name="SimpleEventTrackerFrame" resizeToFitDescendents="true" mouseEnabled="true" movable="true" clampedToScreen="true" hidden="true">
			<OnMouseUp>SimpleEventTracker.OnMouseUp(button, upInside)</OnMouseUp>
			<OnMoveStop>SimpleEventTracker.OnMoveStop()</OnMoveStop>
			<Controls>
				<Texture name="$(parent)Icon">
					<Anchor point="TOPLEFT" />
				</Texture>
				<Label name="$(parent)Label" font="ZoFontGameSmall" horizontalAlignment="LEFT" verticalAlignment="TOP">
					<Anchor point="TOPLEFT" relativeTo="$(parent)Icon" relativePoint="TOPRIGHT" offsetX="4" />
				</Label>
				<Button name="$(parent)Start" inherits="ZO_DefaultButton" hidden="true" mouseEnabled="true">
					<Dimensions x="190" y="28" />
					<Anchor point="TOPLEFT" relativeTo="$(parent)Label" relativePoint="BOTTOMLEFT" offsetY="6" />
					<OnClicked>SimpleEventTracker.StartTracking()</OnClicked>
				</Button>
			</Controls>
		</TopLevelControl>
		<TopLevelControl name="SimpleEventTrackerEdit" mouseEnabled="true" clampedToScreen="true" hidden="true">
			<Dimensions x="380" y="236" />
			<Anchor point="CENTER" />
			<Controls>
				<Backdrop name="$(parent)Bg" inherits="ZO_DefaultBackdrop" />
				<Label name="$(parent)Title" font="ZoFontWinH3"><Anchor point="TOPLEFT" offsetX="20" offsetY="16" /></Label>
				<Label name="$(parent)NameLabel" font="ZoFontGame"><Anchor point="TOPLEFT" offsetX="20" offsetY="54" /></Label>
				<Backdrop name="$(parent)Name" inherits="ZO_SingleLineEditBackdrop_Keyboard">
					<Anchor point="TOPLEFT" offsetX="20" offsetY="78" />
					<Dimensions x="340" />
					<Controls>
						<EditBox name="$(parent)Edit" inherits="ZO_DefaultEditForBackdrop" maxInputCharacters="60" />
					</Controls>
				</Backdrop>
				<Label name="$(parent)TimeLabel" font="ZoFontGame"><Anchor point="TOPLEFT" offsetX="20" offsetY="122" /></Label>
				<Backdrop name="$(parent)Days" inherits="ZO_SingleLineEditBackdrop_Keyboard">
					<Anchor point="TOPLEFT" offsetX="20" offsetY="148" />
					<Dimensions x="50" />
					<Controls>
						<EditBox name="$(parent)Edit" inherits="ZO_DefaultEditForBackdrop" maxInputCharacters="3" textType="NUMERIC_UNSIGNED_INT" />
					</Controls>
				</Backdrop>
				<Label name="$(parent)DaysLabel" font="ZoFontGame"><Anchor point="TOPLEFT" offsetX="76" offsetY="150" /></Label>
				<Backdrop name="$(parent)Hours" inherits="ZO_SingleLineEditBackdrop_Keyboard">
					<Anchor point="TOPLEFT" offsetX="130" offsetY="148" />
					<Dimensions x="50" />
					<Controls>
						<EditBox name="$(parent)Edit" inherits="ZO_DefaultEditForBackdrop" maxInputCharacters="3" textType="NUMERIC_UNSIGNED_INT" />
					</Controls>
				</Backdrop>
				<Label name="$(parent)HoursLabel" font="ZoFontGame"><Anchor point="TOPLEFT" offsetX="186" offsetY="150" /></Label>
				<Backdrop name="$(parent)Minutes" inherits="ZO_SingleLineEditBackdrop_Keyboard">
					<Anchor point="TOPLEFT" offsetX="240" offsetY="148" />
					<Dimensions x="50" />
					<Controls>
						<EditBox name="$(parent)Edit" inherits="ZO_DefaultEditForBackdrop" maxInputCharacters="3" textType="NUMERIC_UNSIGNED_INT" />
					</Controls>
				</Backdrop>
				<Label name="$(parent)MinutesLabel" font="ZoFontGameSmall"><Anchor point="TOPLEFT" offsetX="296" offsetY="150" /></Label>
				<Button name="$(parent)Save" inherits="ZO_DefaultButton">
					<Dimensions x="100" y="28" />
					<Anchor point="TOPLEFT" offsetX="150" offsetY="194" />
					<OnClicked>SimpleEventTracker.EditSave()</OnClicked>
				</Button>
				<Button name="$(parent)Cancel" inherits="ZO_DefaultButton">
					<Dimensions x="100" y="28" />
					<Anchor point="TOPLEFT" offsetX="260" offsetY="194" />
					<OnClicked>SimpleEventTracker.EditCancel()</OnClicked>
				</Button>
			</Controls>
		</TopLevelControl>
	</Controls>
</GuiXml>
