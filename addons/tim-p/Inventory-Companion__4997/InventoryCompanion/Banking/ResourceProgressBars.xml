<GuiXml>
    <Controls>
        <TopLevelControl name="InventoryCompanion_ProgressBar_Template" virtual="true" clampedToScreen="true" mouseEnabled="true" movable="true" hidden="true">
            <Dimensions x="228" y="22"/>
