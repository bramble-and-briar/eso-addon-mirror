[SI_REDEEMCODERESULT0] = "Twój kod został pomyślnie wykorzystany!"
[SI_REDEEMCODERESULT1] = "Ten kod mógł zostać już wykorzystany. Sprawdź dwukrotnie swój kod i spróbuj ponownie."
[SI_REDEEMCODERESULT10] = "Twój kod nie mógł zostać wykorzystany. Kod może być nieprawidłowy lub niedostępny. Upewnij się, że wprowadzasz kod nagrody dostarczony przez The Elder Scrolls® Online. Jeśli twój kod został ci przekazany przez osobę trzecią lub w związku z nią, postępuj zgodnie z jej instrukcjami wykorzystania. Jeśli nadal potrzebujesz pomocy, skontaktuj się z obsługą klienta."
[SI_REDEEMCODERESULT2] = "Próbowałeś/aś wykorzystać zbyt wiele kodów w krótkim czasie. Poczekaj i spróbuj ponownie później."
[SI_REDEEMCODERESULT3] = "W tej chwili nie można było zrealizować kodu. Spróbuj ponownie później."
[SI_REDEEMCODERESULT4] = "Wykorzystanie kodu nie jest dostępne na tej platformie."
[SI_REDEEMCODERESULT5] = "Twój kod nie mógł zostać wykorzystany. Kod może być nieprawidłowy lub niedostępny na wybranej platformie. Upewnij się, że wprowadzasz kod nagrody dostarczony przez The Elder Scrolls® Online. Jeśli twój kod został ci przekazany przez osobę trzecią lub w związku z nią, postępuj zgodnie z jej instrukcjami wykorzystania. Jeśli nadal potrzebujesz pomocy, skontaktuj się z obsługą klienta."
[SI_REDEEMCODERESULT6] = "Wystąpił problem z dostępem do twojego konta. Spróbuj ponownie później lub skontaktuj się z obsługą klienta."
[SI_REDEEMCODERESULT7] = "Twój kod nie mógł zostać wykorzystany. Kod może nie kwalifikować się do twojego konta lub wymagać wprowadzenia na stronie internetowej ESO. Jeśli twój kod dotyczył zakupu lub został dostarczony przez osobę trzecią, postępuj zgodnie z instrukcjami dotyczącymi wykorzystania dołączonymi do kodu. Jeśli nadal potrzebujesz pomocy, skontaktuj się z obsługą klienta."
[SI_REDEEMCODERESULT8] = "Twój kod nie mógł zostać wykorzystany. Kod może nie kwalifikować się na twoją platformę, został już wykorzystany lub jest nieaktywny. Jeśli twój kod został ci przekazany przez osobę trzecią lub w związku z nią, postępuj zgodnie z instrukcjami dotyczącymi wykorzystania dołączonymi do kodu lub skontaktuj się z obsługą klienta."
[SI_REDEEMCODERESULT9] = "Realizacja kodu nie powiodła się. Upewnij się, że wprowadzasz prawidłowy kod lub skontaktuj się z obsługą klienta."
