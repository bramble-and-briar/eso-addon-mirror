[SI_TRIBUTERESOURCE_TOOLTIP0] = "Används för att skada motståndarens agenter. Makt som inte spenderas omvandlas till prestige i slutet av din tur."
[SI_TRIBUTERESOURCE_TOOLTIP1] = "Används för att köpa kort från tavernan. Mynt som inte spenderas går förlorade i slutet av din tur."
[SI_TRIBUTERESOURCE_TOOLTIP2] = "Nå 40 prestige för att gå in i slutspelet. I slutspelet tävlar spelarna om att ha mest prestige i slutet av motståndarens tur. Den spelare som behåller ledningen i slutet av motståndarens tur vinner spelet. En spelare som når 80 prestige vinner spelet i slutet av sin tur."
