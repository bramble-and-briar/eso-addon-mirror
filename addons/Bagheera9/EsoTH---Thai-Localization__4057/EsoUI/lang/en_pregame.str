[SI_GRAPHICS_OPTIONS_BACKGROUND_FPS_LIMIT] = "FPS Limit"
[SI_GRAPHICS_OPTIONS_BACKGROUND_FPS_LIMIT_TOOLTIP] = "Sets the maximum FPS the game is limited to when the Limit Background FPS option is enabled and the game is running in the background."
[SI_GRAPHICS_OPTIONS_CAP_CONSOLE_FRAMERATE_IN_MENUS] = "Menu FPS Limit"
[SI_GRAPHICS_OPTIONS_CAP_CONSOLE_FRAMERATE_IN_MENUS_TOOLTIP] = "Limits your frame rate while in most menus in order to reduce power consumption. Only applicable while using Performance graphics."
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY] = "Graphics"
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY_TOOLTIP] = "Controls the quality of rendering."
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY_TOOLTIP_PS5] = "Fidelity - Prioritizes resolution over frame rate.\n\nPerformance - Prioritizes frame rate over resolution."
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY_TOOLTIP_XBSS] = "Fidelity - Prioritizes resolution and graphics features over frame rate.\n\nPerformance—Prioritizes frame rate over resolution and graphics features."
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY_TOOLTIP_XBSX] = "Fidelity—Prioritizes resolution over frame rate.\n\nPerformance—Prioritizes frame rate over resolution."
[SI_GRAPHICS_OPTIONS_ENERGY_SUSTAINABILITY_SCREEN_DIM_AND_RESOLUTION] = "Idle Power Reduction"
[SI_GRAPHICS_OPTIONS_ENERGY_SUSTAINABILITY_SCREEN_DIM_AND_RESOLUTION_CONSOLE_TOOLTIP] = "Lowers the resolution after being idle."
[SI_GRAPHICS_OPTIONS_ENERGY_SUSTAINABILITY_SCREEN_DIM_AND_RESOLUTION_PC_TOOLTIP] = "Dims the screen and lowers the resolution after being idle."
[SI_GRAPHICS_OPTIONS_USE_BACKGROUND_FPS_LIMIT] = "Limit Background FPS"
[SI_GRAPHICS_OPTIONS_USE_BACKGROUND_FPS_LIMIT_TOOLTIP] = "Enables a limit on FPS when the game is running in the background to conserve CPU and GPU resources."
[SI_GRAPHICS_OPTIONS_VIDEO_ACTIVE_DISPLAY] = "Active Display"
[SI_GRAPHICS_OPTIONS_VIDEO_ACTIVE_DISPLAY_FORMAT] = "Display <<1>>"
[SI_GRAPHICS_OPTIONS_VIDEO_ACTIVE_DISPLAY_TOOLTIP] = "Sets the display device on which to run the game."
[SI_GRAPHICS_OPTIONS_VIDEO_AMBIENT_OCCLUSION_TYPE] = "Ambient Occlusion"
[SI_GRAPHICS_OPTIONS_VIDEO_ANTI_ALIASING] = "Anti-Aliasing"
[SI_GRAPHICS_OPTIONS_VIDEO_ANTI_ALIASING_TOOLTIP] = "Smoothens the edges of objects in the world. Disabling this option may increase performance at the expense of displaying a harsher edge to objects."
[SI_GRAPHICS_OPTIONS_VIDEO_BLOOM] = "Bloom"
[SI_GRAPHICS_OPTIONS_VIDEO_BLOOM_TOOLTIP] = "Increases the intensity of the glow surrounding light sources. Toggling this off will increase performance."
[SI_GRAPHICS_OPTIONS_VIDEO_CATEGORY_ABILITY] = "Ability"
[SI_GRAPHICS_OPTIONS_VIDEO_CATEGORY_DISPLAY] = "Display"
[SI_GRAPHICS_OPTIONS_VIDEO_CATEGORY_GRAPHICS] = "Graphics"
[SI_GRAPHICS_OPTIONS_VIDEO_CHARACTER_RESOLUTION] = "Character Resolution"
[SI_GRAPHICS_OPTIONS_VIDEO_CHARACTER_RESOLUTION_TOOLTIP] = "Determines the number of high resolution characters near the player and distance at which they appear."
[SI_GRAPHICS_OPTIONS_VIDEO_CLUTTER_2D_QUALITY] = "Grass"
[SI_GRAPHICS_OPTIONS_VIDEO_CLUTTER_2D_QUALITY_TOOLTIP] = "Determines the amount of grass and ground clutter in the world. Higher settings increase the distance at which grass is visible. Decreasing this setting may increase performance."
[SI_GRAPHICS_OPTIONS_VIDEO_DEPTH_OF_FIELD_MODE] = "Depth of Field"
[SI_GRAPHICS_OPTIONS_VIDEO_DEPTH_OF_FIELD_MODE_TOOLTIP] = "Determines the appearance of depth of field which simulates the photographic effect that causes distant objects to appear out of focus based on the distance they are from objects in the foreground."
[SI_GRAPHICS_OPTIONS_VIDEO_DISPLAY_MODE] = "Display Mode"
[SI_GRAPHICS_OPTIONS_VIDEO_DISPLAY_MODE_TOOLTIP] = "Sets the game's primary display mode."
[SI_GRAPHICS_OPTIONS_VIDEO_DISTORTION] = "Distortion"
[SI_GRAPHICS_OPTIONS_VIDEO_DISTORTION_TOOLTIP] = "Causes certain objects in the world to display distortion effects in their vicinity. Disabling this may improve performance."
[SI_GRAPHICS_OPTIONS_VIDEO_DLSS_MODE] = "DLSS Mode"
[SI_GRAPHICS_OPTIONS_VIDEO_DLSS_MODE_TOOLTIP] = "Controls the balance between quality and performance improvement when NVIDIA DLSS is enabled."
[SI_GRAPHICS_OPTIONS_VIDEO_FSR_MODE] = "FSR Mode"
[SI_GRAPHICS_OPTIONS_VIDEO_FSR_MODE_TOOLTIP] = "Controls the balance between quality and performance improvement when Fidelity Fx Super Resolution (FSR) is enabled."
[SI_GRAPHICS_OPTIONS_VIDEO_GAMMA_ADJUSTMENT] = "Gamma Adjustment"
[SI_GRAPHICS_OPTIONS_VIDEO_GAMMA_ADJUSTMENT_TOOLTIP] = "Adjusts the overall gamma (brightness) setting of the game with no impact to performance. Change this setting if the game appears too bright or dark on your display."
[SI_GRAPHICS_OPTIONS_VIDEO_GOD_RAYS] = "Sunlight Rays"
[SI_GRAPHICS_OPTIONS_VIDEO_GOD_RAYS_TOOLTIP] = "Causes the sun to display rays of light depending on its angle relative to the camera. Disabling this may improve performance."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_ENABLED] = "HDR (Beta)"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_ENABLED_TOOLTIP] = "Enables HDR if the game is running on a HDR supported monitor with HDR enabled."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_MODE] = "HDR Mode"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_MODE_TOOLTIP] = "Sets the HDR mode."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_PEAK_BRIGHTNESS] = "HDR Peak Brightness"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_PEAK_BRIGHTNESS_TOOLTIP] = "Sets the Peak HDR brightness."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_SCENE_BRIGHTNESS] = "HDR Scene Brightness"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_SCENE_BRIGHTNESS_TOOLTIP] = "Sets the HDR Scene brightness."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_SCENE_CONTRAST] = "HDR Scene Contrast"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_SCENE_CONTRAST_TOOLTIP] = "Sets the HDR Scene Contrast."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_UI_BRIGHTNESS] = "HDR UI Brightness"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_UI_BRIGHTNESS_TOOLTIP] = "Sets the HDR UI brightness."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_UI_CONTRAST] = "HDR UI Contrast"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_UI_CONTRAST_TOOLTIP] = "Sets the HDR UI Contrast."
[SI_GRAPHICS_OPTIONS_VIDEO_MAC_AMBIENT_OCCLUSION_TYPE_TOOLTIP] = "Enhances the fidelity of shadows and lighting by taking into account objects blocking light. HBAO is more expensive than SSAO but provides a more realistic result. Disabling this setting may help improve performance."
[SI_GRAPHICS_OPTIONS_VIDEO_MAXIMUM_PARTICLE_SYSTEMS] = "Maximum Particle Systems"
[SI_GRAPHICS_OPTIONS_VIDEO_MAXIMUM_PARTICLE_SYSTEMS_RESTRICTION] = "This setting will only be applied after you logout or change locations."
[SI_GRAPHICS_OPTIONS_VIDEO_MAXIMUM_PARTICLE_SYSTEMS_TOOLTIP] = "Determines the total number of particle systems that are shown in the world at any given time. Decreasing this setting will reduce the number of particle systems shown, but may improve performance."
[SI_GRAPHICS_OPTIONS_VIDEO_OCCLUSION_CULLING_ENABLED] = "Software Occlusion Culling"
[SI_GRAPHICS_OPTIONS_VIDEO_OCCLUSION_CULLING_ENABLED_TOOLTIP] = "Controls if the occlusion culling is enabled. The occlusion culling will use more of your CPU to reduce the workload of your GPU. Use this if your framerate is limited by your GPU."
[SI_GRAPHICS_OPTIONS_VIDEO_PARTICLE_SUPPRESSION_DISTANCE] = "Particle Suppression Distance"
[SI_GRAPHICS_OPTIONS_VIDEO_PARTICLE_SUPPRESSION_DISTANCE_TOOLTIP] = "Adjusts the distance at which non critical particles are no longer visible. Increasing this will show more of these types of particles, further out in the world at the expense of performance."
[SI_GRAPHICS_OPTIONS_VIDEO_PLANAR_WATER_REFLECTION_QUALITY] = "Planar Reflection Quality"
[SI_GRAPHICS_OPTIONS_VIDEO_PLANAR_WATER_REFLECTION_QUALITY_TOOLTIP] = "Determines the resolution and detail of planar reflections shown on the surface of water. Planar reflections are high quality but may reduce performance when enabled. Water that can't use planar reflections will fall back to screen space reflections."
[SI_GRAPHICS_OPTIONS_VIDEO_PRESETS] = "Graphics Quality"
[SI_GRAPHICS_OPTIONS_VIDEO_PRESETS_TOOLTIP] = "Sets the overall graphics quality of the game, adjusting all advanced options below. "
[SI_GRAPHICS_OPTIONS_VIDEO_RENDER_THREAD] = "Multithreaded Rendering"
[SI_GRAPHICS_OPTIONS_VIDEO_RENDER_THREAD_TOOLTIP] = "Enables a separate thread for the render process, which can improve performance."
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION] = "Resolution"
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION_FORMAT] = "<<1>>x<<2>>"
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION_FORMAT_WIDE] = "<<1>>x<<2>> (Wide)"
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION_TOOLTIP] = "Specifies the overall resolution in which the game will run. Increasing the resolution will provide a higher fidelity image at the expense of performance. The resolution chosen should match the aspect ratio of your monitor."
[SI_GRAPHICS_OPTIONS_VIDEO_SCREENSPACE_WATER_REFLECTION_QUALITY] = "Screen Space Reflection Quality"
[SI_GRAPHICS_OPTIONS_VIDEO_SCREENSPACE_WATER_REFLECTION_QUALITY_TOOLTIP] = "Determines the quality of screen space reflections shown on the surface of water. Increasing this setting will improve the accuracy of the reflection but may decrease performance."
[SI_GRAPHICS_OPTIONS_VIDEO_SHADOWS] = "Shadow Quality"
[SI_GRAPHICS_OPTIONS_VIDEO_SHADOWS_TOOLTIP] = "Determines the quality of shadows seen in the world. Higher settings increase the shadow's draw distance, sharpness and the number of objects in the world that cast shadows. Decreasing this quality may help  improve performance."
[SI_GRAPHICS_OPTIONS_VIDEO_SHOW_ADDITIONAL_ALLY_EFFECTS] = "Show Additional Ally Effects"
[SI_GRAPHICS_OPTIONS_VIDEO_SHOW_ADDITIONAL_ALLY_EFFECTS_TOOLTIP] = "Displays all persistent ally offensive abilities when in dungeon and overland zones. Disabling this may increase performance."
[SI_GRAPHICS_OPTIONS_VIDEO_SUB_SAMPLING] = "SubSampling Quality"
[SI_GRAPHICS_OPTIONS_VIDEO_SUB_SAMPLING_TOOLTIP] = "Determines the resolution in which the game will render the world. The interface is not affected by this setting. Decreasing the quality may help improve performance."
[SI_GRAPHICS_OPTIONS_VIDEO_TEXTURE_RES] = "Texture Quality"
[SI_GRAPHICS_OPTIONS_VIDEO_TEXTURE_RES_TOOLTIP] = "Controls the quality of textures used in the world by changing the size of textures used. Higher settings will provide more detail on objects, character models and the environment, but require more video memory to run smoothly. "
[SI_GRAPHICS_OPTIONS_VIDEO_VIEW_DISTANCE] = "View Distance"
[SI_GRAPHICS_OPTIONS_VIDEO_VIEW_DISTANCE_TOOLTIP] = "Adjusts the distance at which certain objects in the game will no longer be visible. Increasing this will provide a richer and more realistic environment at the expense of performance."
[SI_GRAPHICS_OPTIONS_VIDEO_VSYNC] = "Vertical Sync"
[SI_GRAPHICS_OPTIONS_VIDEO_VSYNC_TOOLTIP] = "Helps to eliminate tearing artifacts by synchronizing the framerate with the refresh rate of your monitor."
[SI_GRAPHICS_OPTIONS_VIDEO_WINDOWS_AMBIENT_OCCLUSION_TYPE_TOOLTIP] = "Enhances the fidelity of shadows and lighting by taking into account objects blocking light. LSAO is more realistic and more expensive than HBAO, which is more realistic and more expensive than SSAO. Screen Space GI improves on LSAO by accounting for additional bounces of light. Disabling this setting may help improve performance."
