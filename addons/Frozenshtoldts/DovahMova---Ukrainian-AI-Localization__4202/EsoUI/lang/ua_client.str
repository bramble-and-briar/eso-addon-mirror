[SI_CUSTOMER_SERVICE_ENTER_NAME] = "Введіть ім'я"
[SI_CUSTOMER_SERVICE_ESO_FORUMS_LINK_TEXT] = "Форуми The Elder Scrolls Online"
[SI_CUSTOMER_SERVICE_ESO_HELP_LINK_TEXT] = "Підтримка The Elder Scrolls Online"
[SI_CUSTOMER_SERVICE_FEEDBACK_IMPACT_DESCRIPTION] = "Використовуйте відгуки, коли хочете повідомити про помилку або надати відгук безпосередньо команді розробників. Запити на допомогу НЕ будуть розглянуті, якщо їх подано через відгуки. Будь ласка, оберіть ВІДПОВІДНУ категорію, якщо вам потрібна допомога з чимось іншим."
