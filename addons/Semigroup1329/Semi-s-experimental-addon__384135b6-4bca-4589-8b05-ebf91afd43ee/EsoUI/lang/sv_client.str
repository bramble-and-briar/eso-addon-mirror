[SI_GAMEPAD_FAST_TRAVEL_DIALOG_CANT_AFFORD] = "Du har inte råd att resa till <<1>>.\n\n|cffffff|t32:32:EsoUI/Art/Miscellaneous/new_icon.dds|t Snabbresor är gratis när du använder ett vägaltare ute i världen.|r"
[SI_GAMEPAD_FAST_TRAVEL_DIALOG_CANT_AFFORD_PREMIUM] = "En förhöjd avgift gäller i ytterligare |cffffff<<2>>|r efter en förflyttning.\n\nDu har dock inte råd med tilläggsavgiften för att resa till <<1>>.\n\n|cffffff|t32:32:EsoUI/Art/Miscellaneous/new_icon.dds|t Snabbresor är gratis när du använder ett vägaltare ute i världen.|r"
