[SI_STAT_TOOLTIP_DIMINISHING_RETURNS] = "|t16:16:EsoUI/Art/Stats/diminishingReturns_icon.dds|tWhen a stat is overcharged it becomes increasingly difficult to raise it further. Consider changing your equipment, skills or attributes to distribute your stats more evenly."
[SI_STAT_TOOLTIP_HEALTH_MAX] = "Affects the amount of damage you can take before dying. Increases the potency of some of your damage, healing, and shield abilities."
[SI_STAT_TOOLTIP_HEALTH_REGENERATION_COMBAT] = "When in combat, you recover <<1>> Health every two seconds."
[SI_STAT_TOOLTIP_HEALTH_REGENERATION_IDLE] = "When not in combat, you recover <<1>> Health every two seconds."
[SI_STAT_TOOLTIP_MAGICKA_MAX] = "Affects how many Magicka Abilities you can cast. Increases the potency of many of your damaging, healing, and shield abilities if this resource is higher than your Max Stamina."
[SI_STAT_TOOLTIP_MAGICKA_REGENERATION_COMBAT] = "When in combat, you recover <<1>> Magicka every two seconds."
