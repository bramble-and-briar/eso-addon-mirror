[SI_GUILD_HERALDRY_DIALOG_ACCEPT] = "Godkänn"
[SI_GUILD_HERALDRY_DIALOG_APPLY_CHANGES_DESCRIPTION] = "Om du verkställer ändringarna i gillets heraldik uppdateras designen på gillets vapenrock. Ändringen syns direkt och kan inte ångras.\n\nVill du verkställa ändringarna?"
[SI_GUILD_HERALDRY_DIALOG_APPLY_CHANGES_PENDING_EXIT_DESCRIPTION] = "Du försöker stänga utan att verkställa dina ändringar.\n\nOm du verkställer ändringarna i gillets heraldik uppdateras designen på gillets vapenrock. Ändringen syns direkt och kan inte ångras.\n\nVill du verkställa ändringarna?"
