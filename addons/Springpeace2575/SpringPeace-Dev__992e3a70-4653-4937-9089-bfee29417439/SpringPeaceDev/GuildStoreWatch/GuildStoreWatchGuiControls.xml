                <Label name="$(parent)ZoneLabel" font="ZoFontGamepad22" wrapMode="ELLIPSIS" verticalAlignment="TOP" horizontalAlignment="LEFT">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="676" offsetY="14" />
                    <Dimensions x="290" y="22" />
                </Label>

                <Label name="$(parent)TraderGuildLabel" font="ZoFontGamepad22" wrapMode="ELLIPSIS" verticalAlignment="TOP" horizontalAlignment="LEFT">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)ZoneLabel" relativePoint="BOTTOMLEFT" offsetX="0" offsetY="0" />
                    <Dimensions x="250" y="22" />
                </Label>
            </Controls>
        </Control>

        <TopLevelControl name="GSWMenuRoot" hidden="true" mouseEnabled="false" clampedToScreen="true">
            <AnchorFill />
            <Controls>
                <Backdrop name="$(parent)HeaderArea">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="64" offsetY="34" />
                    <Dimensions x="1772" y="98" />
                    <Controls>
                        <Label name="$(parent)Title" font="ZoFontGamepad42" color="FFFFFF" text="Guild Store Watch">
                            <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="24" offsetY="14" />
                        </Label>
                        <Label name="$(parent)Subtitle" font="ZoFontGamepad22" color="BFC7D6" text="Stored rows">
                            <Anchor point="TOPLEFT" relativeTo="$(parent)Title" relativePoint="BOTTOMLEFT" offsetX="0" offsetY="4" />
                        </Label>

                        <Texture name="$(parent)DonateQr" textureFile="SpringPeaceDev/springpeacedev_paypal_qr.dds">
                            <Anchor point="TOPRIGHT" relativeTo="$(parent)" relativePoint="TOPRIGHT" offsetX="-24" offsetY="12" />
                            <Dimensions x="72" y="72" />
                        </Texture>
                        <Label name="$(parent)DonateTitle" font="ZoFontGamepad22" color="FFFFFF" text="Donate">
                            <Anchor point="TOPRIGHT" relativeTo="$(parent)DonateQr" relativePoint="TOPLEFT" offsetX="-12" offsetY="0" />
                        </Label>
                        <Label name="$(parent)DonateValue" font="ZoFontGamepad20" color="BFC7D6" text="paypal.me/SpringPeace">
                            <Anchor point="TOPRIGHT" relativeTo="$(parent)DonateTitle" relativePoint="BOTTOMRIGHT" offsetX="0" offsetY="4" />
                        </Label>
                    </Controls>
                </Backdrop>

                <Backdrop name="$(parent)LeftPaneBg">
