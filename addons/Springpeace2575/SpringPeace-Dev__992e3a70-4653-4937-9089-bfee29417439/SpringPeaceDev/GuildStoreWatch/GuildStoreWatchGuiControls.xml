                        <Label name="$(parent)Header" font="ZoFontGamepad27" color="FFFFFF" text="Filters">
                            <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="24" offsetY="16" />
                        </Label>
                        <Control name="$(parent)List" inherits="ZO_VerticalParametricScrollListTemplate">
                            <Anchor point="TOPLEFT" relativeTo="$(parent)Header" relativePoint="BOTTOMLEFT" offsetX="0" offsetY="12" />
                            <Dimensions x="328" y="680" />
                        </Control>
                    </Controls>
