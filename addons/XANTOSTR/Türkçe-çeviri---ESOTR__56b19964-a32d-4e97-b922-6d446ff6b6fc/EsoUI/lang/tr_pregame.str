[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY303] = "Hile / Oyun Açığı Kullanma"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY304] = "Taciz / Zorbalık"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION101] = "Çocuklarla ilgili tehlike arz eden durumlarda bunu kullanın. Bu bir yetkili (polis) soruşturmasına yol açabilir."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION102] = "Federal yetkilileri gerektirebilecek düzeyde bir durum gördüğünüzde bunu kullanın."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION103] = "Bir yetkilinin (polis) sağlık kontrolü için rapor edilmesi gereken bir davranışı gözlemliyorsanız bunu kullanın."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION104] = "Acil bir tehlike durumunda, lütfen bu raporu doldurmanın yanı sıra bulunduğunuz bölgedeki acil servislerinizle iletişime geçin."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION201] = "Özellikle Irk, Milliyet, Dini veya Cinsel Yönelim hakkında olmak üzere belirli bir gruba karşı önyargıyı ifade eden saldırgan ve nefret dili kullanan konuşma veya yazıları bildirmek için kullanın."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION202] = "Oyun ortamını veya topluluk deneyimini kasten bozan birini bildirmek için kullanın."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION203] = "Sohbet kanalında aynı mesajı sürekli üst üste yazan oyuncuyu rapor etmek için bunu kullanın."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION204] = "Sesli sohbeti rapor etmek için bunu kullanın."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION205] = "Karakter adı ya da <<1>> müstehcen ya da uygunsuz olan durumlarda bunu kullanın."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION301] = "CSR'ler, gerçekleşen alışveriş ayrıntılarını doğrulamak ve bunları oyun günlükleriyle karşılaştırmak için oyun içi sohbet günlüklerini değerlendirecektir."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION302] = "Bir oyuncunun başka bir oyuncunun kişisel bilgilerini paylaşması durumunda bunu kullanın."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION303] = "Bu, üçüncü parti programların (botlar), hacklenen silahların, duvar hacklerinin, arazi hatası kullanımını, Scroll trolleme vb. kullanımını içerir lakin bunlarla sınırlı değildir."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION304] = "Durması talep edildiği halde yazı ya da oyun mekanikleri yoluyla istenmeyen davranışları tekrarlayan oyuncular için bu seçeneği kullanın."
