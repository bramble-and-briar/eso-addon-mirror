[SI_GOODBYE] = "Adeus."
[SI_GRAPHICSMODE0] = "Fidelidade"
[SI_GRAPHICSMODE1] = "Desempenho"
[SI_GRAPHICSPRESETS0] = "Mínimo"
[SI_GRAPHICSPRESETS1] = "Baixo"
