[SI_CUSTOMERSERVICEASKFORHELPCHARACTERISSUECATEGORY_DESCRIPTION1] = "Użyj tej opcji, jeśli twoja postać została usunięta przez przypadek i chcesz ją odzyskać."
[SI_CUSTOMERSERVICEASKFORHELPCHARACTERISSUECATEGORY_DESCRIPTION2] = "Użyj tej opcji, jeśli nie możesz znaleźć, dołączyć lub opuścić grupy."
[SI_CUSTOMERSERVICEASKFORHELPCHARACTERISSUECATEGORY_DESCRIPTION3] = "Użyj tej opcji, jeśli nie możesz komunikować się z innymi graczami lub wchodzić w interakcje ze sprzedawcami."
[SI_CUSTOMERSERVICEASKFORHELPCHARACTERISSUECATEGORY_DESCRIPTION4] = "Użyj tej opcji, jeśli uważasz, że twoje umiejętności, zdolności lub osiągnięcia nie są prawidłowe."
