[SI_GRAPHICS_OPTIONS_BACKGROUND_FPS_LIMIT] = "Обмеження FPS"
[SI_GRAPHICS_OPTIONS_BACKGROUND_FPS_LIMIT_TOOLTIP] = "Встановлює максимальну кількість кадрів на секунду, до якої гра обмежена, коли увімкнено опцію «Обмежити FPS у фоновому режимі» і гра працює у фоновому режимі."
[SI_GRAPHICS_OPTIONS_CAP_CONSOLE_FRAMERATE_IN_MENUS] = "Обмеження FPS у меню"
[SI_GRAPHICS_OPTIONS_CAP_CONSOLE_FRAMERATE_IN_MENUS_TOOLTIP] = "Обмежує частоту кадрів у більшості меню для зменшення споживання енергії. Застосовується лише при використанні графіки «Продуктивність»."
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY] = "Графіка"
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY_TOOLTIP] = "Керує якістю рендерингу."
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY_TOOLTIP_PS5] = "Якість – надає пріоритет роздільній здатності над частотою кадрів.\n\nПродуктивність – надає пріоритет частоті кадрів над роздільною здатністю."
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY_TOOLTIP_XBSS] = "Якість – надає пріоритет роздільній здатності та графічним функціям над частотою кадрів.\n\nПродуктивність – надає пріоритет частоті кадрів над роздільною здатністю та графічними функціями."
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY_TOOLTIP_XBSX] = "Якість – надає пріоритет роздільній здатності над частотою кадрів.\n\nПродуктивність – надає пріоритет частоті кадрів над роздільною здатністю."
[SI_GRAPHICS_OPTIONS_ENERGY_SUSTAINABILITY_SCREEN_DIM_AND_RESOLUTION] = "Економія енергії в режимі простою"
[SI_GRAPHICS_OPTIONS_ENERGY_SUSTAINABILITY_SCREEN_DIM_AND_RESOLUTION_CONSOLE_TOOLTIP] = "Знижує роздільну здатність після простою."
[SI_GRAPHICS_OPTIONS_ENERGY_SUSTAINABILITY_SCREEN_DIM_AND_RESOLUTION_PC_TOOLTIP] = "Затемнює екран і знижує роздільну здатність після бездіяльності."
[SI_GRAPHICS_OPTIONS_USE_BACKGROUND_FPS_LIMIT] = "Обмежити фоновий FPS"
[SI_GRAPHICS_OPTIONS_USE_BACKGROUND_FPS_LIMIT_TOOLTIP] = "Встановлює обмеження на FPS, коли гра працює у фоновому режимі, щоб заощадити ресурси ЦП та ГП."
[SI_GRAPHICS_OPTIONS_VIDEO_ACTIVE_DISPLAY] = "Активний дисплей"
[SI_GRAPHICS_OPTIONS_VIDEO_ACTIVE_DISPLAY_FORMAT] = "Дисплей <<1>>"
[SI_GRAPHICS_OPTIONS_VIDEO_ACTIVE_DISPLAY_TOOLTIP] = "Встановлює пристрій відображення, на якому запускатиметься гра."
[SI_GRAPHICS_OPTIONS_VIDEO_AMBIENT_OCCLUSION_TYPE] = "Затінення навколишнього середовища"
[SI_GRAPHICS_OPTIONS_VIDEO_ANTI_ALIASING] = "Згладжування"
[SI_GRAPHICS_OPTIONS_VIDEO_ANTI_ALIASING_TOOLTIP] = "Згладжує краї об'єктів у світі. Вимкнення цієї опції може підвищити продуктивність за рахунок відображення більш різких країв об'єктів."
[SI_GRAPHICS_OPTIONS_VIDEO_BLOOM] = "Сяйво"
[SI_GRAPHICS_OPTIONS_VIDEO_BLOOM_TOOLTIP] = "Збільшує інтенсивність світіння навколо джерел світла. Вимкнення цієї опції підвищить продуктивність."
[SI_GRAPHICS_OPTIONS_VIDEO_CATEGORY_ABILITY] = "Здібності"
[SI_GRAPHICS_OPTIONS_VIDEO_CATEGORY_DISPLAY] = "Дисплей"
[SI_GRAPHICS_OPTIONS_VIDEO_CATEGORY_GRAPHICS] = "Графіка"
[SI_GRAPHICS_OPTIONS_VIDEO_CHARACTER_RESOLUTION] = "Роздільна здатність персонажів"
[SI_GRAPHICS_OPTIONS_VIDEO_CHARACTER_RESOLUTION_TOOLTIP] = "Визначає кількість персонажів високої роздільної здатності поблизу гравця та відстань, на якій вони з'являються."
[SI_GRAPHICS_OPTIONS_VIDEO_CLUTTER_2D_QUALITY] = "Трава"
[SI_GRAPHICS_OPTIONS_VIDEO_CLUTTER_2D_QUALITY_TOOLTIP] = "Визначає кількість трави та наземного сміття у світі. Вищі налаштування збільшують відстань, на якій видно траву. Зменшення цього налаштування може підвищити продуктивність."
[SI_GRAPHICS_OPTIONS_VIDEO_DEPTH_OF_FIELD_MODE] = "Глибина різкості"
[SI_GRAPHICS_OPTIONS_VIDEO_DEPTH_OF_FIELD_MODE_TOOLTIP] = "Визначає вигляд глибини різкості, яка імітує фотографічний ефект, що призводить до розмиття віддалених об'єктів залежно від їхньої відстані до об'єктів на передньому плані."
[SI_GRAPHICS_OPTIONS_VIDEO_DISPLAY_MODE] = "Режим відображення"
[SI_GRAPHICS_OPTIONS_VIDEO_DISPLAY_MODE_TOOLTIP] = "Встановлює основний режим відображення гри."
[SI_GRAPHICS_OPTIONS_VIDEO_DISTORTION] = "Викривлення"
[SI_GRAPHICS_OPTIONS_VIDEO_DISTORTION_TOOLTIP] = "Призводить до того, що певні об'єкти у світі відображають ефекти викривлення поблизу них. Вимкнення цієї функції може покращити продуктивність."
[SI_GRAPHICS_OPTIONS_VIDEO_DLSS_MODE] = "Режим DLSS"
[SI_GRAPHICS_OPTIONS_VIDEO_DLSS_MODE_TOOLTIP] = "Контролює баланс між якістю та покращенням продуктивності, коли увімкнено NVIDIA DLSS."
[SI_GRAPHICS_OPTIONS_VIDEO_FSR_MODE] = "Режим FSR"
[SI_GRAPHICS_OPTIONS_VIDEO_FSR_MODE_TOOLTIP] = "Контролює баланс між якістю та покращенням продуктивності, коли увімкнено FidelityFX Super Resolution (FSR)."
[SI_GRAPHICS_OPTIONS_VIDEO_GAMMA_ADJUSTMENT] = "Налаштування гамми"
[SI_GRAPHICS_OPTIONS_VIDEO_GAMMA_ADJUSTMENT_TOOLTIP] = "Налаштовує загальне значення гамми (яскравості) гри без впливу на продуктивність. Змініть це налаштування, якщо гра здається занадто яскравою або темною на вашому екрані."
[SI_GRAPHICS_OPTIONS_VIDEO_GOD_RAYS] = "Сонячні промені"
[SI_GRAPHICS_OPTIONS_VIDEO_GOD_RAYS_TOOLTIP] = "Змушує сонце відображати промені світла залежно від його кута відносно камери. Вимкнення цієї опції може покращити продуктивність."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_ENABLED] = "HDR (Бета)"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_ENABLED_TOOLTIP] = "Увімкнення HDR, якщо гра запущена на моніторі з підтримкою HDR та увімкненим HDR."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_MODE] = "Режим HDR"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_MODE_TOOLTIP] = "Встановлює режим HDR."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_PEAK_BRIGHTNESS] = "Пікова яскравість HDR"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_PEAK_BRIGHTNESS_TOOLTIP] = "Встановлює пікову яскравість HDR."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_SCENE_BRIGHTNESS] = "Яскравість HDR-сцени"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_SCENE_BRIGHTNESS_TOOLTIP] = "Встановлює яскравість HDR-сцени."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_SCENE_CONTRAST] = "Контрастність HDR-сцени"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_SCENE_CONTRAST_TOOLTIP] = "Встановлює контрастність HDR-сцени."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_UI_BRIGHTNESS] = "Яскравість HDR-інтерфейсу"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_UI_BRIGHTNESS_TOOLTIP] = "Встановлює яскравість HDR-інтерфейсу."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_UI_CONTRAST] = "Контрастність HDR-інтерфейсу"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_UI_CONTRAST_TOOLTIP] = "Встановлює контрастність HDR-інтерфейсу."
[SI_GRAPHICS_OPTIONS_VIDEO_MAC_AMBIENT_OCCLUSION_TYPE_TOOLTIP] = "Покращує точність тіней та освітлення, враховуючи об'єкти, що блокують світло. HBAO є більш ресурсоємним, ніж SSAO, але забезпечує більш реалістичний результат. Вимкнення цього параметра може допомогти покращити продуктивність."
[SI_GRAPHICS_OPTIONS_VIDEO_MAXIMUM_PARTICLE_SYSTEMS] = "Максимальна кількість систем частинок"
[SI_GRAPHICS_OPTIONS_VIDEO_MAXIMUM_PARTICLE_SYSTEMS_RESTRICTION] = "Цей параметр буде застосовано лише після виходу з облікового запису або зміни локації."
[SI_GRAPHICS_OPTIONS_VIDEO_MAXIMUM_PARTICLE_SYSTEMS_TOOLTIP] = "Визначає загальну кількість систем частинок, що відображаються у світі в будь-який момент часу. Зменшення цього параметра зменшить кількість відображуваних систем частинок, але може покращити продуктивність."
[SI_GRAPHICS_OPTIONS_VIDEO_OCCLUSION_CULLING_ENABLED] = "Програмне відсікання оклюзії"
[SI_GRAPHICS_OPTIONS_VIDEO_OCCLUSION_CULLING_ENABLED_TOOLTIP] = "Визначає, чи ввімкнено відсікання оклюзії. Відсікання оклюзії використовуватиме більше вашого ЦП для зменшення навантаження на ваш ГП. Використовуйте це, якщо ваша частота кадрів обмежена вашим ГП."
[SI_GRAPHICS_OPTIONS_VIDEO_PARTICLE_SUPPRESSION_DISTANCE] = "Відстань приглушення частинок"
[SI_GRAPHICS_OPTIONS_VIDEO_PARTICLE_SUPPRESSION_DISTANCE_TOOLTIP] = "Регулює відстань, на якій некритичні частинки більше не відображаються. Збільшення цього параметра покаже більше таких типів частинок, далі у світі, за рахунок продуктивності."
[SI_GRAPHICS_OPTIONS_VIDEO_PLANAR_WATER_REFLECTION_QUALITY] = "Якість планарних віддзеркалень"
[SI_GRAPHICS_OPTIONS_VIDEO_PLANAR_WATER_REFLECTION_QUALITY_TOOLTIP] = "Визначає роздільну здатність та деталізацію планарних віддзеркалень, що відображаються на поверхні води. Планарні віддзеркалення мають високу якість, але можуть знизити продуктивність при ввімкненні. Вода, яка не може використовувати планарні віддзеркалення, повернеться до віддзеркалень екранного простору."
[SI_GRAPHICS_OPTIONS_VIDEO_PRESETS] = "Якість графіки"
[SI_GRAPHICS_OPTIONS_VIDEO_PRESETS_TOOLTIP] = "Встановлює загальну якість графіки гри, налаштовуючи всі розширені параметри нижче."
[SI_GRAPHICS_OPTIONS_VIDEO_RENDER_THREAD] = "Багатопотоковий рендеринг"
[SI_GRAPHICS_OPTIONS_VIDEO_RENDER_THREAD_TOOLTIP] = "Увімкнення окремого потоку для процесу рендерингу, що може покращити продуктивність."
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION] = "Роздільна здатність"
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION_FORMAT] = "<<1>>x<<2>>"
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION_FORMAT_WIDE] = "<<1>>x<<2>> (Широкий)"
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION_TOOLTIP] = "Визначає загальну роздільну здатність, у якій працюватиме гра. Збільшення роздільної здатності забезпечить вищу якість зображення за рахунок продуктивності. Обрана роздільна здатність повинна відповідати співвідношенню сторін вашого монітора."
[SI_GRAPHICS_OPTIONS_VIDEO_SCREENSPACE_WATER_REFLECTION_QUALITY] = "Якість екранних віддзеркалень"
[SI_GRAPHICS_OPTIONS_VIDEO_SCREENSPACE_WATER_REFLECTION_QUALITY_TOOLTIP] = "Визначає якість екранних віддзеркалень, що відображаються на поверхні води. Збільшення цього параметра покращить точність віддзеркалення, але може знизити продуктивність."
[SI_GRAPHICS_OPTIONS_VIDEO_SHADOWS] = "Якість тіней"
[SI_GRAPHICS_OPTIONS_VIDEO_SHADOWS_TOOLTIP] = "Визначає якість тіней, що відображаються у світі. Вищі налаштування збільшують відстань промальовування тіней, їх чіткість та кількість об'єктів у світі, що відкидають тіні. Зниження цієї якості може допомогти покращити продуктивність."
[SI_GRAPHICS_OPTIONS_VIDEO_SHOW_ADDITIONAL_ALLY_EFFECTS] = "Показувати додаткові ефекти союзників"
[SI_GRAPHICS_OPTIONS_VIDEO_SHOW_ADDITIONAL_ALLY_EFFECTS_TOOLTIP] = "Відображає всі постійні наступальні здібності союзників у підземеллях та наземних зонах. Вимкнення цієї опції може підвищити продуктивність."
[SI_GRAPHICS_OPTIONS_VIDEO_SUB_SAMPLING] = "Якість субдискретизації"
[SI_GRAPHICS_OPTIONS_VIDEO_SUB_SAMPLING_TOOLTIP] = "Визначає роздільну здатність, у якій гра відтворюватиме світ. Інтерфейс не залежить від цього налаштування. Зниження якості може допомогти покращити продуктивність."
[SI_GRAPHICS_OPTIONS_VIDEO_TEXTURE_RES] = "Якість текстур"
[SI_GRAPHICS_OPTIONS_VIDEO_TEXTURE_RES_TOOLTIP] = "Контролює якість текстур, що використовуються у світі, змінюючи їх розмір. Вищі налаштування забезпечують більшу деталізацію об'єктів, моделей персонажів та оточення, але вимагають більше відеопам'яті для плавної роботи."
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_ENEMY_INTENSITY] = "Інтенсивність візуальних ефектів ворогів"
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_ENEMY_INTENSITY_TOOLTIP] = "Налаштовує видимість візуальних ефектів, що створюються всіма ворожими гравцями."
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_FRIENDLY_INTENSITY] = "Інтенсивність дружніх візуальних ефектів"
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_FRIENDLY_INTENSITY_TOOLTIP] = "Налаштовує видимість візуальних ефектів, що створюються всіма дружніми гравцями."
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_SELF_INTENSITY] = "Інтенсивність власних візуальних ефектів"
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_SELF_INTENSITY_TOOLTIP] = "Налаштовує видимість візуальних ефектів, що створюються вами."
[SI_GRAPHICS_OPTIONS_VIDEO_VIEW_DISTANCE] = "Відстань огляду"
[SI_GRAPHICS_OPTIONS_VIDEO_VIEW_DISTANCE_TOOLTIP] = "Регулює відстань, на якій певні об'єкти в грі перестають бути видимими. Збільшення цієї відстані забезпечить багатше та реалістичніше оточення за рахунок продуктивності."
[SI_GRAPHICS_OPTIONS_VIDEO_VSYNC] = "Вертикальна синхронізація"
[SI_GRAPHICS_OPTIONS_VIDEO_VSYNC_TOOLTIP] = "Допомагає усунути артефакти розривів, синхронізуючи частоту кадрів із частотою оновлення монітора."
[SI_GRAPHICS_OPTIONS_VIDEO_WINDOWS_AMBIENT_OCCLUSION_TYPE_TOOLTIP] = "Покращує якість тіней та освітлення, враховуючи об'єкти, що блокують світло. LSAO є більш реалістичним і дорожчим, ніж HBAO, який є більш реалістичним і дорожчим, ніж SSAO. Screen Space GI покращує LSAO, враховуючи додаткові відбиття світла. Вимкнення цієї настройки може допомогти покращити продуктивність."
