[SI_CRAFT_ADVISOR_ALCHEMY_REQUIRES_THIRD_SLOT_TOOLTIP] = "Mistrzowskie zlecenia wymagają pasywnej zdolności, która pozwala na używanie 3 odczynników."
[SI_CRAFT_ADVISOR_ENCHANTING_MISSING_ITEMS_TOOLTIP] = "Musisz zdobyć brakujące runy, zanim spróbujesz wytworzyć glif. Większość przedmiotów można zakupić w sklepach gildii lub u handlarzy, możesz również spróbować znaleźć je samodzielnie, szukając w całym Tamriel."
[SI_CRAFT_ADVISOR_PROVISIONING_MISSING_RECIPE_TOOLTIP] = "Musisz poznać przepis, zanim spróbujesz to wytworzyć. Przepisy możesz znaleźć w skrzyniach, kufrach, biurkach oraz otrzymać od innych podróżników, czasami można je znaleźć nawet u poległych wrogów."
[SI_CRAFT_ADVISOR_TOOLTIP_EQUIP_TAB] = "Wyposażone przedmioty"
[SI_CRAFT_ADVISOR_TOOLTIP_WRIT_TAB] = "Zadania rzemieślnicze"
[SI_CRAFT_ADVISOR_TOOLTIP_WRIT_TAB_DISABLED_SUBTEXT] = "Włącza się, gdy masz zadanie, które można ukończyć przy tym stanowisku rzemieślniczym."
[SI_CRAFT_ADVISOR_UNKNOWN_RUNES_TOOLTIP] = "Wszystkie runy zapisane są w tajemniczym języku i mogą zostać przetłumaczone poprzez łączenie i wytwarzanie."
[SI_CRAFT_ADVISOR_WRITS_TITLE] = "Zadania"
[SI_CRAFT_BAG_STATUS_ESO_PLUS_UNLOCKED_DESCRIPTION] = "Materiały rzemieślnicze mogą być swobodnie wyciągane oraz chowane, gdy jesteś subskrybentem ESO Plus."
[SI_CRAFT_BAG_STATUS_LOCKED_DESCRIPTION] = "Materiały rzemieślnicze mogą być wyciągane, ale nie zdeponowane. Torbę rzemieślniczą możesz odblokować zostając subskrybentem ESO Plus."
