[SI_ZONECOMPLETIONTYPE_DESCRIPTION4] = ".ﺐﻫﺬﻟﺍ ﻦﻣ ﻂﻴﺴﺑ ﻎﻠﺒﻣ ﻞﺑﺎﻘﻣ ﺡﻮﺘﻔﻣ ﺭﺍﺰﻣ ﻰﻟﺇ ﻢﻟﺎﻌﻟﺍ ﻲﻓ ﻥﺎﻜﻣ ﻱﺃ ﻦﻣ ﻝﺎﻘﺘﻧﺍ ﺎﻀًﻳﺃ ﻚﻨﻜﻤﻳﻭ .ﺎﻬﺘﺤﺘﻓﻭ ﺎﻬﺘﻔﺸﺘﻛﺍ ﻲﺘﻟﺍ ﺕﺍﺭﺍﺰﻤﻟﺍ ﻦﻴﺑ ﻲﻧﺎﺠﻤﻟﺍﻭ ﻱﺭﻮﻔﻟﺍ ﺮﻔﺴﻟﺍ |cffffffﻕﺮﻄﻟﺍ ﺕﺍﺭﺍﺰﻣ|r ﻚﻟ ﺢﻴﺘﺗ"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION5] = ".ﺔﻋﻮﻤﺠﻣ ﻦﻣ ﺍﺮًﺼﻨﻋ ﻂﻘﺴﻳُ ﻢﻴﻋﺯﻭ ﺔﻳﻭﺎﻤﺳ ﺔﻴﻈﺷ ﻰﻠﻋ ﺓﺭﺎﻐﻣ ﻞﻛ ﻱﻮﺘﺤﺗ .ﻙﺩﺮﻔﻤﺑ ﺎﻬﻟﺎﻤﻛﺇ ﻚﻨﻜﻤﻳ ﺡﻮﺘﻔﻤﻟﺍ ﻢﻟﺎﻌﻟﺍ ﻲﻓ ﺕﺎﻧﺍﺰﻧﺯ |cffffffﺕﺍﺭﺎﻐﻤﻟﺍ|r"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION6] = ".ﺔﻋﻮﻤﺠﻣ ﻦﻣ ﺍﺮًﺼﻨﻋ ﻂﻘﺴﻳُ ﻢﻴﻋﺯﻭ ﺔﻳﻭﺎﻤﺳ ﺔﻴﻈﺷ ﻰﻠﻋ ﺎﻬﻨﻣ ﻞﻛ ﻱﻮﺘﺤﺗ .ﻦﻴﺒﻋ ﺔﻌﺑﺭﺃ ﻦﻣ ﺕﺎﻋﻮﻤﺠﻤﻟ ﺔﻤﻤﺼﻣﻭ ،ﻥﺭﻮﻠﻏﺍﺮﻛ ﻲﻓ ﻊﻘﺗ ﺡﻮﺘﻔﻤﻟﺍ ﻢﻟﺎﻌﻟﺍ ﻲﻓ ﺕﺎﻧﺍﺰﻧﺯ |cffffffﺔﻴﻋﺎﻤﺠﻟﺍ ﺕﺍﺭﺎﻐﻤﻟﺍ|r"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION7] = ".ﺎﻬﻠﻳﻮﺤﺗ ﻭﺃ ﺓﺪﻳﺪﺟ ﺕﺍﺭﺪﻗ ﺢﺘﻔﻟ ﺎﻬﻣﺪﺨﺘﺴﺗ ﺓﺭﺎﻬﻣ ﺔﻄﻘﻧ ﺎﻬﻨﻣ ﺙﺛ ﻑﺎﺸﺘﻛﺍ ﻚﺤﻨﻤﻳ .ﻊﻃﺎﺴﻟﺍ ﺾﻴﺑﺍ ﺎﻬﻋﺎﻌﺸﺑ ﺎﻫﺰﻴﻴﻤﺗ ﻦﻜﻤﻳﻭ ،ﻢﻟﺎﻌﻟﺍ ﺀﺎﺤﻧﺃ ﻲﻓ |cffffffﺔﻳﻭﺎﻤﺴﻟﺍ ﺎﻳﺎﻈﺸﻟﺍ|r ﺮﺸﺘﻨﺗ"
