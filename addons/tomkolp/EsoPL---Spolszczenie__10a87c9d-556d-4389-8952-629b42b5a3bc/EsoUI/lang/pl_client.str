[SI_GRAPHICS_OPTIONS_VIDEO_CLUTTER_2D_QUALITY_TOOLTIP] = "Określa odległość renderowania trawy i ziemi w świecie. Wyższe ustawienia zwiększają odległość, z której widoczna jest trawa. Zmniejszenie tego ustawienia może zwiększyć wydajność."
[SI_GRAPHICS_OPTIONS_VIDEO_DEPTH_OF_FIELD_MODE] = "Głębia ostrości"
[SI_GRAPHICS_OPTIONS_VIDEO_DEPTH_OF_FIELD_MODE_TOOLTIP] = "Określa wygląd głębi ostrości symulującej efekt fotograficzny, który powoduje, że odległe obiekty wydają się nieostre na podstawie odległości, w jakiej znajdują się od obiektów na pierwszym planie."
[SI_GRAPHICS_OPTIONS_VIDEO_DISPLAY_MODE] = "Tryb wyświetlania"
[SI_GRAPHICS_OPTIONS_VIDEO_DISPLAY_MODE_TOOLTIP] = "Ustawia główny tryb wyświetlania gry."
[SI_GRAPHICS_OPTIONS_VIDEO_DISTORTION] = "Zniekształcenie"
[SI_GRAPHICS_OPTIONS_VIDEO_DISTORTION_TOOLTIP] = "Powoduje, że niektóre obiekty w świecie wyświetlają efekty zniekształceń w ich pobliżu. Wyłączenie tej opcji może poprawić wydajność."
[SI_GRAPHICS_OPTIONS_VIDEO_DLSS_MODE] = "Tryb DLSS"
[SI_GRAPHICS_OPTIONS_VIDEO_DLSS_MODE_TOOLTIP] = "Reguluje równowagę pomiędzy jakością a poprawą wydajności, gdy włączony jest moduł NVIDIA DLSS."
[SI_GRAPHICS_OPTIONS_VIDEO_FSR_MODE] = "Tryb FSR"
[SI_GRAPHICS_OPTIONS_VIDEO_FSR_MODE_TOOLTIP] = "Reguluje równowagę pomiędzy jakością a poprawą wydajności, gdy włączona jest funkcja Fidelity Fx Super Resolution (FSR)."
[SI_GRAPHICS_OPTIONS_VIDEO_GAMMA_ADJUSTMENT] = "Korekcja gamma"
[SI_GRAPHICS_OPTIONS_VIDEO_GAMMA_ADJUSTMENT_TOOLTIP] = "Dostosowuje ogólne ustawienia gamma (jasności) gry bez wpływu na wydajność. Zmień to ustawienie, jeśli gra na ekranie wydaje się zbyt jasna lub ciemna."
[SI_GRAPHICS_OPTIONS_VIDEO_GOD_RAYS] = "Promienie słoneczne"
[SI_GRAPHICS_OPTIONS_VIDEO_GOD_RAYS_TOOLTIP] = "Powoduje, że słońce wyświetla promienie światła w zależności od kąta w stosunku do kamery. Wyłączenie tego może poprawić wydajność."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_ENABLED] = "HDR (Beta)"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_ENABLED_TOOLTIP] = "Włącza HDR, jeśli gra jest uruchomiona na monitorze obsługującym HDR z włączoną funkcją HDR."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_MODE] = "Tryb HDR"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_MODE_TOOLTIP] = "Ustawia tryb HDR."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_PEAK_BRIGHTNESS] = "Szczytowa jasność HDR"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_PEAK_BRIGHTNESS_TOOLTIP] = "Ustawia szczytową jasność efektu HDR."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_SCENE_BRIGHTNESS] = "Jasność scen HDR"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_SCENE_BRIGHTNESS_TOOLTIP] = "Ustawia jasność scen z efektem HDR."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_SCENE_CONTRAST] = "Kontrast scen HDR"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_SCENE_CONTRAST_TOOLTIP] = "Ustawia kontrast scen z efektem HDR."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_UI_BRIGHTNESS] = "Jasność interfejsu HDR"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_UI_BRIGHTNESS_TOOLTIP] = "Ustawia jasność interfejsu z efektem HDR."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_UI_CONTRAST] = "Kontrast interfejsu HDR"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_UI_CONTRAST_TOOLTIP] = "Ustawia kontrast interfejsu z efektem HDR."
[SI_GRAPHICS_OPTIONS_VIDEO_MAC_AMBIENT_OCCLUSION_TYPE_TOOLTIP] = "Poprawia dokładność cieni i oświetlenia, biorąc pod uwagę obiekty blokujące światło. HBAO jest bardziej obciążające niż SSAO, ale zapewnia bardziej realistyczny efekt. Wyłączenie tego ustawienia może poprawić wydajność."
[SI_GRAPHICS_OPTIONS_VIDEO_MAXIMUM_PARTICLE_SYSTEMS] = "Maksymalny efekt cząsteczek"
[SI_GRAPHICS_OPTIONS_VIDEO_MAXIMUM_PARTICLE_SYSTEMS_RESTRICTION] = "To ustawienie zostanie zastosowane tylko po wylogowaniu lub zmianie lokacji."
[SI_GRAPHICS_OPTIONS_VIDEO_MAXIMUM_PARTICLE_SYSTEMS_TOOLTIP] = "Określa całkowitą ilość cząsteczek, które są wyświetlane w świecie w danym momencie. Zmniejszenie tego ustawienia zredukuje ilość wyświetlanych cząsteczek, ale poprawi wydajność."
[SI_GRAPHICS_OPTIONS_VIDEO_OCCLUSION_CULLING_ENABLED] = "Usuwanie niewidocznych obiektów"
[SI_GRAPHICS_OPTIONS_VIDEO_OCCLUSION_CULLING_ENABLED_TOOLTIP] = "Określa, czy włączone jest usuwanie powierzchni niewidocznych. Okluzja będzie bardziej obciążać procesor, aby zmniejszyć obciążenie karty graficznej. Użyj tej opcji, jeśli liczba klatek na sekundę jest ograniczona przez procesor graficzny."
[SI_GRAPHICS_OPTIONS_VIDEO_PARTICLE_SUPPRESSION_DISTANCE] = "Odległość tłumienia cząsteczek"
[SI_GRAPHICS_OPTIONS_VIDEO_PARTICLE_SUPPRESSION_DISTANCE_TOOLTIP] = "Dostosowuje odległość z jakiej są widzialne cząsteczki. Zwiększenie tego pokaże więcej odległych cząsteczek w świecie, kosztem wydajności."
[SI_GRAPHICS_OPTIONS_VIDEO_PLANAR_WATER_REFLECTION_QUALITY] = "Jakość płaskich odbić"
[SI_GRAPHICS_OPTIONS_VIDEO_PLANAR_WATER_REFLECTION_QUALITY_TOOLTIP] = "Określa rozdzielczość i szczegółowość płaskich odbić na powierzchni wody. Płaskie odbicia są wysokiej jakości, ale po włączeniu mogą zmniejszyć wydajność. Woda, która nie może używać płaskich odbić, powróci do odbić na ekranie."
[SI_GRAPHICS_OPTIONS_VIDEO_PRESETS] = "Jakość grafiki"
[SI_GRAPHICS_OPTIONS_VIDEO_PRESETS_TOOLTIP] = "Ustawia ogólną jakość grafiki gry, dostosowując wszystkie zaawansowane opcje poniżej. "
[SI_GRAPHICS_OPTIONS_VIDEO_RENDER_THREAD] = "Renderowanie wielowątkowe"
[SI_GRAPHICS_OPTIONS_VIDEO_RENDER_THREAD_TOOLTIP] = "Włącza osobny wątek dla procesu renderowania, który może poprawić wydajność."
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION] = "Rozdzielczość"
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION_FORMAT] = "<<1>>x<<2>>"
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION_FORMAT_WIDE] = "<<1>>x<<2>> (Szeroki)"
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION_TOOLTIP] = "Określa ogólną rozdzielczość, w jakiej gra będzie działać. Zwiększenie rozdzielczości zapewni większą wierność obrazu kosztem wydajności. Wybrana rozdzielczość powinna pasować do proporcji ekranu."
[SI_GRAPHICS_OPTIONS_VIDEO_SCREENSPACE_WATER_REFLECTION_QUALITY] = "Jakość odbić na ekranie"
[SI_GRAPHICS_OPTIONS_VIDEO_SCREENSPACE_WATER_REFLECTION_QUALITY_TOOLTIP] = "Określa jakość odbić w przestrzeni ekranu wyświetlanych na powierzchni wody. Zwiększenie tego ustawienia poprawi dokładność odbicia, ale może zmniejszyć wydajność."
[SI_GRAPHICS_OPTIONS_VIDEO_SHADOWS] = "Jakość cieni"
[SI_GRAPHICS_OPTIONS_VIDEO_SHADOWS_TOOLTIP] = "Określa jakość cieni widocznych w świecie. Wyższe ustawienia zwiększają odległość rysowania cieni, ostrość i liczbę obiektów rzucających cienie. Zmniejszenie jakości może poprawić wydajność."
[SI_GRAPHICS_OPTIONS_VIDEO_SHOW_ADDITIONAL_ALLY_EFFECTS] = "Dodatkowe efekty sojuszników"
[SI_GRAPHICS_OPTIONS_VIDEO_SHOW_ADDITIONAL_ALLY_EFFECTS_TOOLTIP] = "Wyświetla wszystkie trwałe zdolności ofensywne w lochach i regionach lądowych. Wyłączenie tej opcji może poprawić wydajność."
[SI_GRAPHICS_OPTIONS_VIDEO_SUB_SAMPLING] = "Jakość próbkowania"
[SI_GRAPHICS_OPTIONS_VIDEO_SUB_SAMPLING_TOOLTIP] = "Określa rozdzielczość, w której gra będzie renderować świat. Interfejs nie ma wpływu na to ustawienie. Zmniejszenie jakości może pomóc poprawić wydajność."
[SI_GRAPHICS_OPTIONS_VIDEO_TEXTURE_RES] = "Jakość tekstur"
[SI_GRAPHICS_OPTIONS_VIDEO_TEXTURE_RES_TOOLTIP] = "Kontroluje jakość tekstur używanych w świecie, zmieniając ich rozmiar. Wyższe ustawienia dostarczą więcej szczegółów obiektom, modelom postaci i środowisku, lecz wymagają więcej pamięci wideo do płynnego działania. "
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_ENEMY_INTENSITY] = "Intensywność VFX wrogów"
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_ENEMY_INTENSITY_TOOLTIP] = "Dostosowuje widoczność efektów wizualnych wywoływanych przez wszystkich wrogich graczy."
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_FRIENDLY_INTENSITY] = "Intensywność VFX sojuszników"
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_FRIENDLY_INTENSITY_TOOLTIP] = "Dostosowuje widoczność efektów wizualnych wywoływanych przez wszystkich przyjaznych graczy."
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_SELF_INTENSITY] = "Intensywność własnych VFX"
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_SELF_INTENSITY_TOOLTIP] = "Dostosowuje widoczność efektów wizualnych wywoływanych przez ciebie."
[SI_GRAPHICS_OPTIONS_VIDEO_VIEW_DISTANCE] = "Zasięg widzenia"
[SI_GRAPHICS_OPTIONS_VIDEO_VIEW_DISTANCE_TOOLTIP] = "Dostosowuje odległość, z jaką niektóre obiekty w grze przestaną być widoczne. Zwiększenie tej opcji dostarczy bogatsze i bardziej realistyczne środowisko kosztem wydajności."
[SI_GRAPHICS_OPTIONS_VIDEO_VSYNC] = "Synchronizacja pionowa"
[SI_GRAPHICS_OPTIONS_VIDEO_VSYNC_TOOLTIP] = "Pomaga wyeliminować rozrywanie klatek, synchronizując szybkość klatek z częstotliwością odświeżania monitora."
[SI_GRAPHICS_OPTIONS_VIDEO_WINDOWS_AMBIENT_OCCLUSION_TYPE_TOOLTIP] = "Poprawia dokładność cieni i oświetlenia, biorąc pod uwagę obiekty blokujące światło. LSAO jest bardziej realistyczne i obciążające niż HBAO, które jest bardziej realistyczne i obciążające od SSAO. Screen Space GI poprawia LSAO, uwzględniając dodatkowe odbicia światła. Wyłączenie tego ustawienia może poprawić wydajność."
