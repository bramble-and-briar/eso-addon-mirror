[SI_GRAPHICS_OPTIONS_VIDEO_PARTICLE_SUPPRESSION_DISTANCE] = "Avstånd för partikeldämpning"
[SI_GRAPHICS_OPTIONS_VIDEO_PARTICLE_SUPPRESSION_DISTANCE_TOOLTIP] = "Justerar avståndet där mindre viktiga partiklar inte längre syns. Att öka detta visar fler sådana partiklar längre bort i världen, på bekostnad av prestandan."
[SI_GRAPHICS_OPTIONS_VIDEO_PLANAR_WATER_REFLECTION_QUALITY] = "Kvalitet på plana reflektioner"
[SI_GRAPHICS_OPTIONS_VIDEO_PLANAR_WATER_REFLECTION_QUALITY_TOOLTIP] = "Avgör upplösningen och detaljnivån för plana reflektioner på vattenytor. Plana reflektioner håller hög kvalitet men kan sänka prestandan när de är aktiverade. Vatten som inte kan använda plana reflektioner använder i stället skärmrymdsreflektioner."
[SI_GRAPHICS_OPTIONS_VIDEO_PRESETS] = "Grafikkvalitet"
[SI_GRAPHICS_OPTIONS_VIDEO_PRESETS_TOOLTIP] = "Anger spelets övergripande grafikkvalitet och justerar alla avancerade alternativ nedan. "
[SI_GRAPHICS_OPTIONS_VIDEO_RENDER_THREAD] = "Flertrådad rendering"
[SI_GRAPHICS_OPTIONS_VIDEO_RENDER_THREAD_TOOLTIP] = "Aktiverar en separat tråd för renderingsprocessen, vilket kan förbättra prestandan."
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION] = "Upplösning"
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION_FORMAT_WIDE] = "<<1>>x<<2>> (bred)"
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION_TOOLTIP] = "Anger den övergripande upplösning som spelet körs i. En högre upplösning ger en skarpare bild på bekostnad av prestandan. Den valda upplösningen bör motsvara bildskärmens bildförhållande."
[SI_GRAPHICS_OPTIONS_VIDEO_SCREENSPACE_WATER_REFLECTION_QUALITY] = "Kvalitet på skärmrymdsreflektioner"
[SI_GRAPHICS_OPTIONS_VIDEO_SCREENSPACE_WATER_REFLECTION_QUALITY_TOOLTIP] = "Avgör kvaliteten på skärmrymdsreflektioner på vattenytor. Att höja denna inställning gör reflektionerna mer exakta men kan sänka prestandan."
[SI_GRAPHICS_OPTIONS_VIDEO_SHADOWS] = "Skuggkvalitet"
[SI_GRAPHICS_OPTIONS_VIDEO_SHADOWS_TOOLTIP] = "Avgör kvaliteten på skuggorna i världen. Högre inställningar ökar skuggornas ritavstånd, skärpa och antalet objekt i världen som kastar skuggor. Att sänka kvaliteten kan förbättra prestandan."
[SI_GRAPHICS_OPTIONS_VIDEO_SHOW_ADDITIONAL_ALLY_EFFECTS] = "Visa fler effekter från allierade"
[SI_GRAPHICS_OPTIONS_VIDEO_SHOW_ADDITIONAL_ALLY_EFFECTS_TOOLTIP] = "Visar alla allierades varaktiga offensiva förmågor i fängelsehålor och i den öppna världen. Om du stänger av detta kan prestandan öka."
[SI_GRAPHICS_OPTIONS_VIDEO_SUB_SAMPLING] = "Kvalitet på undersampling"
[SI_GRAPHICS_OPTIONS_VIDEO_SUB_SAMPLING_TOOLTIP] = "Avgör upplösningen som spelet renderar världen i. Gränssnittet påverkas inte av denna inställning. Att sänka kvaliteten kan förbättra prestandan."
[SI_GRAPHICS_OPTIONS_VIDEO_TEXTURE_RES] = "Texturkvalitet"
[SI_GRAPHICS_OPTIONS_VIDEO_TEXTURE_RES_TOOLTIP] = "Styr kvaliteten på texturerna i världen genom att ändra texturernas storlek. Högre inställningar ger mer detaljer på objekt, figurmodeller och omgivningar, men kräver mer grafikminne för att spelet ska flyta smidigt. "
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_ENEMY_INTENSITY] = "Intensitet för fienders visuella effekter"
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_ENEMY_INTENSITY_TOOLTIP] = "Justerar synligheten för visuella effekter från alla fientliga spelare."
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_FRIENDLY_INTENSITY] = "Intensitet för allierades visuella effekter"
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_FRIENDLY_INTENSITY_TOOLTIP] = "Justerar synligheten för visuella effekter från alla allierade spelare."
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_SELF_INTENSITY] = "Intensitet för egna visuella effekter"
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_SELF_INTENSITY_TOOLTIP] = "Justerar synligheten för dina egna visuella effekter."
[SI_GRAPHICS_OPTIONS_VIDEO_VIEW_DISTANCE] = "Siktavstånd"
[SI_GRAPHICS_OPTIONS_VIDEO_VIEW_DISTANCE_TOOLTIP] = "Justerar avståndet där vissa objekt i spelet inte längre syns. Att öka detta ger en rikare och mer realistisk miljö på bekostnad av prestandan."
[SI_GRAPHICS_OPTIONS_VIDEO_VSYNC] = "Vertikal synkronisering"
[SI_GRAPHICS_OPTIONS_VIDEO_VSYNC_TOOLTIP] = "Hjälper till att förhindra bildrivning genom att synkronisera bildfrekvensen med bildskärmens uppdateringsfrekvens."
[SI_GRAPHICS_OPTIONS_VIDEO_WINDOWS_AMBIENT_OCCLUSION_TYPE_TOOLTIP] = "Förbättrar kvaliteten på skuggor och ljussättning genom att ta hänsyn till objekt som blockerar ljuset. LSAO är mer realistiskt och mer krävande än HBAO, som i sin tur är mer realistiskt och mer krävande än SSAO. Screen Space GI förbättrar LSAO genom att ta hänsyn till ytterligare ljusstudsar. Om du stänger av denna inställning kan prestandan förbättras."
