[SI_ZONECOMPLETIONTYPE3] = "Prestationer"
[SI_ZONECOMPLETIONTYPE4] = "Vägaltare"
[SI_ZONECOMPLETIONTYPE5] = "Grottor"
[SI_ZONECOMPLETIONTYPE6] = "Gruppgrottor"
[SI_ZONECOMPLETIONTYPE7] = "Himmelsskärvor"
[SI_ZONECOMPLETIONTYPE8] = "Världshändelser"
[SI_ZONECOMPLETIONTYPE9] = "Världsbossar"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION1] = "|cffffffZonberättelsens uppdrag|r utgör zonens huvudberättelse. Genom att slutföra dessa uppdrag kan du belönas med färdighetspoäng, erfarenhet, guld och utrustning."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION10] = "|cffffffAnmärkningsvärda platser|r är sevärda platser i världen. Om du upptäcker alla anmärkningsvärda platser i en zon får du zonens Pathfinder-prestation."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION11] = "|cffffffBöcker från Shalidors bibliotek|r finns utspridda över hela världen. De känns igen på sitt karakteristiska lila sken. Om du hittar dessa böcker höjer du din rang i Magikergillet och avancerar i dess färdighetslinje."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION12] = "|cffffffMundusstenar|r är föremål i världen som ger en gåva i form av en tillfällig positiv effekt. Effekten varar tills den ersätts av gåvan från en annan Mundussten."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION13] = "|cffffffOffentliga fängelsehålor|r är fängelsehålor i den öppna världen som finns runt om i Tamriel och bortom. De är utformade för grupper om fyra spelare. Genom att slutföra olika delar av offentliga fängelsehålor kan du belönas med en färdighetspoäng, erfarenhet, guld och utrustning."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION14] = "|cffffffSetstationer|r är platser i världen där du kan tillverka föremål med specifika setbonusar."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION2] = "|cffffffIntressanta platser|r är fristående berättelser som utforskar historien, personerna och platserna i en zon. De kan ge dig erfarenhet, guld och utrustning."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION4] = "|cffffffVägaltare|r låter dig resa gratis och omedelbart mellan vägaltare som du har upptäckt och låst upp. Du kan också resa direkt till valfritt upplåst vägaltare från var som helst i världen mot en liten summa guld."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION5] = "|cffffffGrottor|r är fängelsehålor i världen som går att klara på egen hand. Grottor innehåller alltid en himmelsskärva och en boss som släpper setutrustning."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION6] = "|cffffffGruppgrottor|r är fängelsehålor i den öppna världen i Craglorn, särskilt utformade för grupper om fyra spelare. Gruppgrottor har alltid en himmelsskärva och en boss som släpper setutrustning."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION7] = "|cffffffHimmelsskärvor|r finns utspridda över hela världen och känns igen på den starka vita ljusstråle de sänder ut. Om du hittar tre himmelsskärvor får du en färdighetspoäng, som du kan använda för att låsa upp nya förmågor eller morfa dem."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION8] = "|cffffffVärldshändelser|r, som Mörka ankare, är aktiviteter i världen som bäst tas an av en grupp äventyrare. Om du slutför en världshändelse kan du belönas med erfarenhet, guld och utrustning av högre kvalitet."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION9] = "|cffffffVärldsbossar|r är svåra fiender som är tänkta att bekämpas av en grupp äventyrare. Om du besegrar en världsboss kan du belönas med utrustning av högre kvalitet."
[SI_ZONECOMPLETIONTYPE_PROGRESSDESCRIPTION10] = "<<1>> anmärkningsvärda platser upptäckta i <<2>>"
