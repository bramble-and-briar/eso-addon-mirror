<GuiXml>
    <Controls>
        <TopLevelControl name="TrueShotMarkersRoot" mouseEnabled="false">
            <Controls>
                <Control name="TrueShotMarkersCamera" hidden="true"/>
            </Controls>
        </TopLevelControl>
        <Control name="TrueShotMarkersWorld" virtual="true" space="WORLD" hidden="true" mouseEnabled="false">
            <Dimensions x="150" y="115"/>
            <Anchor point="CENTER" relativeTo="GuiRoot" relativePoint="CENTER"/>
            <Controls>
                <Label name="$(parent)Timer" font="$(BOLD_FONT)|48|thick-outline" horizontalAlignment="CENTER" verticalAlignment="CENTER">
                    <Dimensions x="150" y="65"/>
                    <Anchor point="TOP" relativePoint="TOP"/>
                </Label>
                <Texture name="$(parent)Arrow" textureFile="TrueShotMarkers/assets/arrow.dds">
                    <Dimensions x="46" y="46"/>
                    <Anchor point="BOTTOM" relativePoint="BOTTOM"/>
                </Texture>
            </Controls>
        </Control>
    </Controls>
</GuiXml>
