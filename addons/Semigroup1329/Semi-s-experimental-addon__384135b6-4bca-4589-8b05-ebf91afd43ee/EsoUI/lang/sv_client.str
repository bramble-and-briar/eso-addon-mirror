[SI_GUILD_DESCRIPTION_HEADER] = "Om oss"
[SI_GUILD_DISBAND] = "Du är den sista medlemmen i gillet. Om du lämnar upplöses gillet och andra kan använda dess namn. Alla föremål i gillesbanken förstörs också.\n\nVill du verkligen lämna <<X:1>>|cffffff<<2>>|r?"
