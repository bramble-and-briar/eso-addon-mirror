[SI_DELETE_CHARACTER] = "Sil <<X:1>>"
[SI_DELETE_CHARACTER_CONFIRMATION_BUTTON] = "Karakteri Sil"
[SI_DELETE_CHARACTER_CONFIRMATION_TEXT] = "SİL"
[SI_DELETE_CHARACTER_DIALOG_GAMEPAD_CONTINUE] = "Devam et"
[SI_DELETE_CHARACTER_DIALOG_GAMEPAD_TEXT] = "<<1>> <<1[/karakter/karakter]>> daha silebilirsin.\n\n|cff9633Karakterde Taç Mağazasından ve ya redemption kodlar ile alınmış eşyalar varsa bu eşyalar silinecek.|r\n\nEğer bu eşyaların silinmesini istemiyorsan oyun içinde en yakın bankada eşyalarını depolayabilirsin.\n\nBinek, Evcil Hayvan, Kostüm ve Hesap Yükseltmeleri gibi koleksiyonlar kaybolmayacak.\n\nKarakter üzerinde kuşanılan normal eşyalar ve envanterdekiler imha edilecek."
[SI_DELETE_CHARACTER_DIALOG_GAMEPAD_TITLE] = "Karakteri Sil"
[SI_DELETE_CHARACTER_DIALOG_TEXT] = "|cff0000Deleting a character with items from the Crown Store or items gained via redemption codes in its inventory will cause those items to be lost from your account.|r \n\nCollectibles such as Mounts, Pets, Costumes and Account Upgrades will not be lost. Normal items equipped on the character and in the character's inventory will also be destroyed. If you wish to keep these items, please visit the nearest bank vendor to store the items.\n\nYou can currently delete |cFFFFFF<<4>>|r <<4[/character/characters]>>.  Additional deletions will become available over time.\n\nAre you sure you want to delete |cFFFFFF<<1>>|r? To confirm, type |cFFFFFF<<2>>|r below and click the <<3>> button."
[SI_DELETE_CHARACTER_DISABLED_GAMEPAD_TEXT] = "Şu anda karakter silemezsin.\n\nSilme işlemi gerçekleştirmek zaman içerisinde tekrar mevcut olacak. Lütfen daha sonra tekrar deneyin."
[SI_DELETE_CHARACTER_DISABLED_GAMEPAD_TITLE] = "Karakter Silinemiyor"
[SI_DELETE_CHARACTER_DISABLED_TOOLTIP] = "Şu anda karakter silemezsin.\n\nSilme işlemi gerçekleştirmek zaman içerisinde tekrar mevcut olacak. Lütfen daha sonra tekrar deneyin."
[SI_DELETE_CHARACTER_ENABLED_TOOLTIP] = "|cFFFFFF<<1>>|r <<1[/karakter/karakter]>> daha silebilirsin.\n\nFazladan silme hakkı belirli bir vakit geçtikten sonra tanınacaktır."
[SI_DELETE_CHARACTER_GAMEPAD_DELETING] = "Siliniyor"
[SI_DELETE_CHARACTER_GAMEPAD_DELETING_CHARACTER] = "Karakter Siliniyor..."
