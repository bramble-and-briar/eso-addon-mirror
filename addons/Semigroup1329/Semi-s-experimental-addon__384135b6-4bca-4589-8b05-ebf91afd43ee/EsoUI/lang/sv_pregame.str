[SI_DEFAULTSOULGEMCHOICE0] = "|t16:16:EsoUI/Art/currency/currency_gold.dds|t Köpta för guld"
[SI_DEFAULTSOULGEMCHOICE1] = "|t16:16:EsoUI/Art/currency/currency_crown.dds|t Köpta för kronor"
[SI_DELETE_CHARACTER] = "Radera <<X:1>>"
[SI_DELETE_CHARACTER_CONFIRMATION_BUTTON] = "Radera"
[SI_DELETE_CHARACTER_CONFIRMATION_TEXT] = "RADERA"
[SI_DELETE_CHARACTER_DIALOG_GAMEPAD_CONTINUE] = "Fortsätt"
[SI_DELETE_CHARACTER_DIALOG_GAMEPAD_TEXT] = "Du kan radera ytterligare <<1>> <<1[/karaktär/karaktärer]>>.\n\n|cff9633Om du raderar en karaktär som har föremål från Kronbutiken eller föremål som erhållits via inlösningskoder förloras dessa föremål från ditt konto.|r\n\nOm du vill behålla dessa föremål, besök närmaste bankir för att förvara dem.\n\nSamlarobjekt som riddjur, husdjur, dräkter och kontouppgraderingar förloras inte.\n\nVanliga föremål som karaktären har utrustade eller i sin packning förstörs."
[SI_DELETE_CHARACTER_DIALOG_GAMEPAD_TITLE] = "Radera karaktär"
[SI_DELETE_CHARACTER_DIALOG_TEXT] = "|cff0000Om du raderar en karaktär som har digitala förbeställningsbonusar eller Imperial Edition-bonusar i sin packning förloras dessa föremål från ditt konto.|r\n\nVanliga föremål som karaktären har utrustade eller i sin packning förstörs också. Om du vill behålla dessa föremål, besök närmaste bankir och förvara dem åt någon av dina andra karaktärer.\n\nDu kan just nu radera |cFFFFFF<<2>>|r <<2[/karaktär/karaktärer]>>. Fler raderingar blir tillgängliga med tiden.\n\nÄr du säker på att du vill radera |cFFFFFF<<1>>|r?"
[SI_DELETE_CHARACTER_DISABLED_GAMEPAD_TEXT] = "Du kan inte radera några karaktärer just nu.\n\nRaderingar blir tillgängliga med tiden. Försök igen senare."
