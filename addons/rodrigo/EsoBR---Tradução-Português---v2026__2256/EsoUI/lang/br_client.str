[SI_CUSTOMERSERVICEASKFORHELPREPORTHOUSETOURLISTINGCATEGORY1] = "Nickname Inapropriado"
[SI_CUSTOMERSERVICEASKFORHELPREPORTHOUSETOURLISTINGCATEGORY2] = "Arranjo Ofensivo"
[SI_CUSTOMERSERVICEASKFORHELPREPORTHOUSETOURLISTINGCATEGORY_DESCRIPTION1] = "Use isto para denunciar um apelido de listagem de Visita de Casas que seja profano ou ofensivo."
[SI_CUSTOMERSERVICEASKFORHELPREPORTHOUSETOURLISTINGCATEGORY_DESCRIPTION2] = "Use isto para denunciar uma listagem de Visita de Casas que tenha um arranjo de mobiliário ofensivo."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERCATEGORY0] = "Selecione a Categoria"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERCATEGORY1] = "Ameaças no Mundo Real"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERCATEGORY2] = "Linguagem Imprópria/Toxicidade"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERCATEGORY3] = "Ações Inadequadas/Trapaça/Exploração"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY0] = "Selecionar Subcategoria"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY101] = "Exploração e abuso sexual infantil"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY102] = "Terrorismo ou extremismo violento"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY103] = "Auto-mutilação/suicídio"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY104] = "Dano iminente a pessoas ou propriedade"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY201] = "Discurso de ódio"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY202] = "Trollagem"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY203] = "Spam"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY204] = "Bate-papo por voz profano"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY205] = "Nome grosseiro/<<1>>"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY301] = "Trapaça"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY302] = "Exposição Indevida/compartilhamento de informações pessoais"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY303] = "Trapacear/explorar"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY304] = "Assédio/intimidação"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION101] = "Use isso para relatar qualquer problema de perigo relacionado a crianças. Isso pode levar à apresentação de um boletim de ocorrência."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION102] = "Use-o quando vir uma situação que atinge o nível que pode exigir a notificação das autoridades policiais federais."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION103] = "Use-o se estiver observando um comportamento que acredita que pode resultar na notificação da polícia para realizar uma verificação de bem-estar."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION104] = "Para perigo imediato, entre em contato com os serviços de emergência locais, além de preencher este relatório."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION201] = "Use-o para relatar discursos ou escritos abusivos ou ameaçadores que expressem preconceito contra um determinado grupo, especialmente com base em raça, nacionalidade, religião ou orientação sexual."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION202] = "Use isso para relatar alguém que está deliberadamente perturbando o ambiente do jogo ou a experiência da comunidade."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION203] = "Use isto ao reportar outro jogador por enviar a mesma mensagem repetidamente no BATE-PAPO."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION204] = "Use isso para relatar apenas o chat de VOZ."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION205] = "Use isso para relatar um nome de personagem ou <<1>> que seja profano ou ofensivo."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION301] = "Os CSRs avaliarão os registros de bate-papo do jogo para confirmar os detalhes da negociação discutida e compará-la com os registros de negociação do jogo."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION302] = "Use esta opção para relatar qualquer jogador postando informações da vida real de qualquer outro jogador."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION303] = "Isso inclui, mas não está limitado a, o uso de programas de terceiros (bots), armas hackeadas, hacks de parede, falhas de terreno, trolagem de rolagem, etc."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION304] = "Use esta opção quando os jogadores usam texto ou mecânica de jogo para executar repetidamente comportamentos indesejados após serem solicitados a parar."
