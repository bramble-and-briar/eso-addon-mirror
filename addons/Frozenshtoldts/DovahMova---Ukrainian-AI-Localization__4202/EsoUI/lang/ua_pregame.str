[SI_GRAPHICSPRESETS3] = "Високі"
[SI_GRAPHICSPRESETS4] = "Ультра"
[SI_GRAPHICSPRESETS7] = "Користувацькі"
[SI_GRAPHICS_OPTIONS_BACKGROUND_FPS_LIMIT] = "Обмеження FPS"
[SI_GRAPHICS_OPTIONS_BACKGROUND_FPS_LIMIT_TOOLTIP] = "Встановлює максимальну частоту кадрів, до якої гра обмежується, коли увімкнено опцію «Обмежити FPS у фоновому режимі» і гра працює у фоновому режимі."
[SI_GRAPHICS_OPTIONS_CAP_CONSOLE_FRAMERATE_IN_MENUS] = "Обмеження FPS у меню"
[SI_GRAPHICS_OPTIONS_CAP_CONSOLE_FRAMERATE_IN_MENUS_TOOLTIP] = "Обмежує частоту кадрів у більшості меню, щоб зменшити споживання енергії. Застосовується лише під час використання графіки продуктивності."
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY] = "Графіка"
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY_TOOLTIP] = "Контролює якість рендерингу."
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY_TOOLTIP_PS5] = "Якість – надає пріоритет роздільній здатності над частотою кадрів.\n\nПродуктивність – надає пріоритет частоті кадрів над роздільною здатністю."
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY_TOOLTIP_XBSS] = "Якість – надає пріоритет роздільній здатності та графічним функціям над частотою кадрів.\n\nПродуктивність – надає пріоритет частоті кадрів над роздільною здатністю та графічними функціями."
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY_TOOLTIP_XBSX] = "Якість – надає пріоритет роздільній здатності над частотою кадрів.\n\nПродуктивність – надає пріоритет частоті кадрів над роздільною здатністю."
[SI_GRAPHICS_OPTIONS_ENERGY_SUSTAINABILITY_SCREEN_DIM_AND_RESOLUTION] = "Зменшення енергоспоживання в режимі очікування"
[SI_GRAPHICS_OPTIONS_ENERGY_SUSTAINABILITY_SCREEN_DIM_AND_RESOLUTION_CONSOLE_TOOLTIP] = "Знижує роздільну здатність після простою."
[SI_GRAPHICS_OPTIONS_ENERGY_SUSTAINABILITY_SCREEN_DIM_AND_RESOLUTION_PC_TOOLTIP] = "Приглушує екран та знижує роздільну здатність після простою."
[SI_GRAPHICS_OPTIONS_USE_BACKGROUND_FPS_LIMIT] = "Обмежити FPS у фоновому режимі"
[SI_GRAPHICS_OPTIONS_USE_BACKGROUND_FPS_LIMIT_TOOLTIP] = "Увімкнути обмеження FPS, коли гра працює у фоновому режимі, щоб заощадити ресурси ЦП та ГП."
[SI_GRAPHICS_OPTIONS_VIDEO_ACTIVE_DISPLAY] = "Активний дисплей"
[SI_GRAPHICS_OPTIONS_VIDEO_ACTIVE_DISPLAY_FORMAT] = "Дисплей <<1>>"
[SI_GRAPHICS_OPTIONS_VIDEO_ACTIVE_DISPLAY_TOOLTIP] = "Встановлює пристрій відображення, на якому запускатиметься гра."
[SI_GRAPHICS_OPTIONS_VIDEO_AMBIENT_OCCLUSION_TYPE] = "Затінення навколишнього середовища"
[SI_GRAPHICS_OPTIONS_VIDEO_ANTI_ALIASING] = "Згладжування"
[SI_GRAPHICS_OPTIONS_VIDEO_ANTI_ALIASING_TOOLTIP] = "Згладжує краї об'єктів у світі. Вимкнення цієї опції може підвищити продуктивність за рахунок відображення більш різких країв об'єктів."
[SI_GRAPHICS_OPTIONS_VIDEO_BLOOM] = "Світіння"
[SI_GRAPHICS_OPTIONS_VIDEO_BLOOM_TOOLTIP] = "Збільшує інтенсивність світіння навколо джерел світла. Вимкнення цієї опції підвищить продуктивність."
[SI_GRAPHICS_OPTIONS_VIDEO_CATEGORY_ABILITY] = "Здібність"
[SI_GRAPHICS_OPTIONS_VIDEO_CATEGORY_DISPLAY] = "Дисплей"
[SI_GRAPHICS_OPTIONS_VIDEO_CATEGORY_GRAPHICS] = "Графіка"
[SI_GRAPHICS_OPTIONS_VIDEO_CHARACTER_RESOLUTION] = "Роздільна здатність персонажів"
[SI_GRAPHICS_OPTIONS_VIDEO_CHARACTER_RESOLUTION_TOOLTIP] = "Визначає кількість персонажів високої роздільної здатності поблизу гравця та відстань, на якій вони з'являються."
[SI_GRAPHICS_OPTIONS_VIDEO_CLUTTER_2D_QUALITY] = "Трава"
[SI_GRAPHICS_OPTIONS_VIDEO_CLUTTER_2D_QUALITY_TOOLTIP] = "Визначає кількість трави та наземного сміття у світі. Вищі налаштування збільшують відстань, на якій видно траву. Зменшення цього налаштування може підвищити продуктивність."
[SI_GRAPHICS_OPTIONS_VIDEO_DEPTH_OF_FIELD_MODE] = "Глибина різкості"
[SI_GRAPHICS_OPTIONS_VIDEO_DEPTH_OF_FIELD_MODE_TOOLTIP] = "Визначає вигляд глибини різкості, яка імітує фотографічний ефект, що призводить до розмиття віддалених об'єктів залежно від їхньої відстані до об'єктів на передньому плані."
[SI_GRAPHICS_OPTIONS_VIDEO_DISPLAY_MODE] = "Режим відображення"
[SI_GRAPHICS_OPTIONS_VIDEO_DISPLAY_MODE_TOOLTIP] = "Встановлює основний режим відображення гри."
[SI_GRAPHICS_OPTIONS_VIDEO_DISTORTION] = "Спотворення"
[SI_GRAPHICS_OPTIONS_VIDEO_DISTORTION_TOOLTIP] = "Деякі об'єкти у світі відображають ефекти спотворення поблизу. Вимкнення цієї опції може покращити продуктивність."
[SI_GRAPHICS_OPTIONS_VIDEO_DLSS_MODE] = "Режим DLSS"
[SI_GRAPHICS_OPTIONS_VIDEO_DLSS_MODE_TOOLTIP] = "Контролює баланс між якістю та покращенням продуктивності, коли NVIDIA DLSS увімкнено."
[SI_GRAPHICS_OPTIONS_VIDEO_FSR_MODE] = "Режим FSR"
[SI_GRAPHICS_OPTIONS_VIDEO_FSR_MODE_TOOLTIP] = "Контролює баланс між якістю та покращенням продуктивності, коли Fidelity Fx Super Resolution (FSR) увімкнено."
[SI_GRAPHICS_OPTIONS_VIDEO_GAMMA_ADJUSTMENT] = "Налаштування гамми"
[SI_GRAPHICS_OPTIONS_VIDEO_GAMMA_ADJUSTMENT_TOOLTIP] = "Регулює загальні налаштування гамми (яскравості) гри без впливу на продуктивність. Змініть це налаштування, якщо гра виглядає занадто яскравою або темною на вашому екрані."
[SI_GRAPHICS_OPTIONS_VIDEO_GOD_RAYS] = "Сонячні промені"
[SI_GRAPHICS_OPTIONS_VIDEO_GOD_RAYS_TOOLTIP] = "Сонце відображає промені світла залежно від його кута відносно камери. Вимкнення цієї опції може покращити продуктивність."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_ENABLED] = "HDR (Бета)"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_ENABLED_TOOLTIP] = "Увімкнути HDR, якщо гра запущена на моніторі з підтримкою HDR та увімкненим HDR."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_MODE] = "Режим HDR"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_MODE_TOOLTIP] = "Встановлює режим HDR."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_PEAK_BRIGHTNESS] = "Пікова яскравість HDR"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_PEAK_BRIGHTNESS_TOOLTIP] = "Встановлює пікову яскравість HDR."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_SCENE_BRIGHTNESS] = "Яскравість сцени HDR"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_SCENE_BRIGHTNESS_TOOLTIP] = "Встановлює яскравість сцени HDR."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_SCENE_CONTRAST] = "Контраст сцени HDR"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_SCENE_CONTRAST_TOOLTIP] = "Встановлює контраст сцени HDR."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_UI_BRIGHTNESS] = "Яскравість інтерфейсу HDR"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_UI_BRIGHTNESS_TOOLTIP] = "Встановлює яскравість інтерфейсу HDR."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_UI_CONTRAST] = "Контрастність інтерфейсу HDR"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_UI_CONTRAST_TOOLTIP] = "Встановлює контрастність інтерфейсу HDR."
[SI_GRAPHICS_OPTIONS_VIDEO_MAC_AMBIENT_OCCLUSION_TYPE_TOOLTIP] = "Покращує точність тіней та освітлення, враховуючи об'єкти, що блокують світло. HBAO є більш ресурсомістким, ніж SSAO, але забезпечує більш реалістичний результат. Вимкнення цього параметра може допомогти покращити продуктивність."
[SI_GRAPHICS_OPTIONS_VIDEO_MAXIMUM_PARTICLE_SYSTEMS] = "Максимальна кількість систем частинок"
[SI_GRAPHICS_OPTIONS_VIDEO_MAXIMUM_PARTICLE_SYSTEMS_RESTRICTION] = "Цей параметр буде застосовано лише після виходу з гри або зміни локації."
[SI_GRAPHICS_OPTIONS_VIDEO_MAXIMUM_PARTICLE_SYSTEMS_TOOLTIP] = "Визначає загальну кількість систем частинок, що відображаються у світі в будь-який момент часу. Зменшення цього параметра зменшить кількість відображуваних систем частинок, але може покращити продуктивність."
[SI_GRAPHICS_OPTIONS_VIDEO_OCCLUSION_CULLING_ENABLED] = "Програмне відсікання оклюзії"
[SI_GRAPHICS_OPTIONS_VIDEO_OCCLUSION_CULLING_ENABLED_TOOLTIP] = "Контролює, чи ввімкнено відсікання оклюзії. Відсікання оклюзії використовуватиме більше ресурсів вашого ЦП для зменшення навантаження на ваш ГП. Використовуйте це, якщо частота кадрів обмежена вашим ГП."
[SI_GRAPHICS_OPTIONS_VIDEO_PARTICLE_SUPPRESSION_DISTANCE] = "Відстань пригнічення частинок"
[SI_GRAPHICS_OPTIONS_VIDEO_PARTICLE_SUPPRESSION_DISTANCE_TOOLTIP] = "Регулює відстань, на якій некритичні частинки стають невидимими. Збільшення цього значення покаже більше таких частинок далі у світі, але за рахунок продуктивності."
[SI_GRAPHICS_OPTIONS_VIDEO_PLANAR_WATER_REFLECTION_QUALITY] = "Якість планарних віддзеркалень"
[SI_GRAPHICS_OPTIONS_VIDEO_PLANAR_WATER_REFLECTION_QUALITY_TOOLTIP] = "Визначає роздільну здатність та деталізацію планарних віддзеркалень, що відображаються на поверхні води. Планарні віддзеркалення мають високу якість, але можуть знизити продуктивність при ввімкненні. Вода, яка не може використовувати планарні віддзеркалення, повернеться до віддзеркалень екранного простору."
[SI_GRAPHICS_OPTIONS_VIDEO_PRESETS] = "Якість графіки"
[SI_GRAPHICS_OPTIONS_VIDEO_PRESETS_TOOLTIP] = "Встановлює загальну якість графіки гри, регулюючи всі розширені параметри нижче."
[SI_GRAPHICS_OPTIONS_VIDEO_RENDER_THREAD] = "Багатопотоковий рендеринг"
[SI_GRAPHICS_OPTIONS_VIDEO_RENDER_THREAD_TOOLTIP] = "Вмикає окремий потік для процесу рендерингу, що може покращити продуктивність."
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION] = "Роздільна здатність"
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION_FORMAT] = "<<1>>x<<2>>"
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION_FORMAT_WIDE] = "<<1>>x<<2>> (Широкий)"
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION_TOOLTIP] = "Визначає загальну роздільну здатність, у якій працюватиме гра. Збільшення роздільної здатності забезпечить вищу якість зображення за рахунок продуктивності. Обрана роздільна здатність має відповідати співвідношенню сторін вашого монітора."
[SI_GRAPHICS_OPTIONS_VIDEO_SCREENSPACE_WATER_REFLECTION_QUALITY] = "Якість екранних віддзеркалень води"
[SI_GRAPHICS_OPTIONS_VIDEO_SCREENSPACE_WATER_REFLECTION_QUALITY_TOOLTIP] = "Визначає якість екранних віддзеркалень, що відображаються на поверхні води. Збільшення цього параметра покращить точність віддзеркалення, але може знизити продуктивність."
[SI_GRAPHICS_OPTIONS_VIDEO_SHADOWS] = "Якість тіней"
[SI_GRAPHICS_OPTIONS_VIDEO_SHADOWS_TOOLTIP] = "Визначає якість тіней, що відображаються у світі. Вищі налаштування збільшують дальність промальовування тіней, їхню різкість та кількість об'єктів у світі, що відкидають тіні. Зниження цієї якості може допомогти покращити продуктивність."
[SI_GRAPHICS_OPTIONS_VIDEO_SHOW_ADDITIONAL_ALLY_EFFECTS] = "Показувати додаткові ефекти союзників"
[SI_GRAPHICS_OPTIONS_VIDEO_SHOW_ADDITIONAL_ALLY_EFFECTS_TOOLTIP] = "Відображає всі постійні наступальні здібності союзників у підземеллях та наземних зонах. Вимкнення цього може підвищити продуктивність."
[SI_GRAPHICS_OPTIONS_VIDEO_SUB_SAMPLING] = "Якість субдискретизації"
[SI_GRAPHICS_OPTIONS_VIDEO_SUB_SAMPLING_TOOLTIP] = "Визначає роздільну здатність, у якій гра відтворюватиме світ. Інтерфейс не залежить від цього параметра. Зниження якості може допомогти покращити продуктивність."
[SI_GRAPHICS_OPTIONS_VIDEO_TEXTURE_RES] = "Якість текстур"
[SI_GRAPHICS_OPTIONS_VIDEO_TEXTURE_RES_TOOLTIP] = "Контролює якість текстур, що використовуються у світі, змінюючи їхній розмір. Вищі налаштування забезпечують більшу деталізацію об'єктів, моделей персонажів та оточення, але потребують більше відеопам'яті для плавної роботи. "
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_ENEMY_INTENSITY] = "Інтенсивність візуальних ефектів ворогів"
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_ENEMY_INTENSITY_TOOLTIP] = "Налаштовує видимість візуальних ефектів, що створюються всіма ворожими гравцями."
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_FRIENDLY_INTENSITY] = "Інтенсивність візуальних ефектів союзників"
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_FRIENDLY_INTENSITY_TOOLTIP] = "Налаштовує видимість візуальних ефектів, що створюються всіма дружніми гравцями."
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_SELF_INTENSITY] = "Інтенсивність власних візуальних ефектів"
[SI_GRAPHICS_OPTIONS_VIDEO_VFX_SELF_INTENSITY_TOOLTIP] = "Налаштовує видимість візуальних ефектів, що створюються вами."
[SI_GRAPHICS_OPTIONS_VIDEO_VIEW_DISTANCE] = "Відстань огляду"
[SI_GRAPHICS_OPTIONS_VIDEO_VIEW_DISTANCE_TOOLTIP] = "Налаштовує відстань, на якій певні об'єкти в грі перестануть бути видимими. Збільшення цього параметра забезпечить багатше та реалістичніше оточення за рахунок продуктивності."
[SI_GRAPHICS_OPTIONS_VIDEO_VSYNC] = "Вертикальна синхронізація"
[SI_GRAPHICS_OPTIONS_VIDEO_VSYNC_TOOLTIP] = "Допомагає усунути артефакти розривів, синхронізуючи частоту кадрів із частотою оновлення монітора."
[SI_GRAPHICS_OPTIONS_VIDEO_WINDOWS_AMBIENT_OCCLUSION_TYPE_TOOLTIP] = "Покращує точність тіней та освітлення, враховуючи об'єкти, що блокують світло. LSAO є реалістичнішим та дорожчим за HBAO, який є реалістичнішим та дорожчим за SSAO. Screen Space GI покращує LSAO, враховуючи додаткові відбиття світла. Вимкнення цього параметра може допомогти покращити продуктивність."
[SI_GREGORIANCALENDARMONTHS1] = "Січень"
[SI_GREGORIANCALENDARMONTHS10] = "Жовтень"
[SI_GREGORIANCALENDARMONTHS11] = "Листопад"
[SI_GREGORIANCALENDARMONTHS12] = "Грудень"
