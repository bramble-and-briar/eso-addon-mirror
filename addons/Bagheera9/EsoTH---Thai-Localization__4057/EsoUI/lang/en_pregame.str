[SI_ACCEPT_PLAYGO_TERMS_HEADER] = "Accept PlayGo Terms"
[SI_ACCEPT_PLAYGO_TERMS_PROMPT] = "Would you like to accept the PlayGo terms for allowing additional content to be installed when updates occur?"
[SI_ACCESSIBILITY_MODE_PROMPT_CONTINUE] = "Continue (Accessibility Mode <<1>>)"
[SI_ACCESSIBILITY_MODE_PROMPT_CONTINUE_DISABLED] = "Disabled"
[SI_ACCESSIBILITY_MODE_PROMPT_CONTINUE_ENABLED] = "Enabled"
[SI_ACCESSIBILITY_MODE_PROMPT_ENABLE_LABEL] = "Enable Accessibility Mode"
[SI_ACCESSIBILITY_MODE_PROMPT_MAIN_TEXT] = "Accessibility Mode allows the use of options such as screen narration, as well as alternative menu navigation.\n\nEnabling Accessibility Mode forces use of the |cffffffGamepad UI|r."
[SI_ACCESSIBILITY_OPTIONS_ACCESSIBILITY_HEADER] = "Accessibility"
[SI_ACCESSIBILITY_OPTIONS_ACCESSIBILITY_MODE] = "Accessibility Mode"
[SI_ACCESSIBILITY_OPTIONS_ACCESSIBILITY_MODE_TOOLTIP] = "Enables a predefined set of accessibility options."
[SI_ACCESSIBILITY_OPTIONS_ACCESSIBLE_QUICKWHEELS] = "Togglable Quickwheels"
[SI_ACCESSIBILITY_OPTIONS_ACCESSIBLE_QUICKWHEELS_TOOLTIP] = "When enabled, quickwheels may be toggled on or off and are navigable via hotkeys."
[SI_ACCESSIBILITY_OPTIONS_ARCANIST] = "Arcanist Aim Assist"
[SI_ACCESSIBILITY_OPTIONS_CONSOLE_GAMEPAD_AIM_ASSIST_INTENSITY] = "Aim Assist Intensity"
[SI_ACCESSIBILITY_OPTIONS_CONSOLE_GAMEPAD_AIM_ASSIST_INTENSITY_TOOLTIP] = "Adjusts aim assist intensity for Arcanist beam abilities. Setting to zero eliminates aim assist."
[SI_ACCESSIBILITY_OPTIONS_GAMEPAD_AIM_ASSIST_INTENSITY] = "Gamepad Aim Assist Intensity"
[SI_ACCESSIBILITY_OPTIONS_GAMEPAD_AIM_ASSIST_INTENSITY_TOOLTIP] = "Adjusts aim assist intensity for Arcanist beam abilities while using a gamepad. Setting to zero eliminates aim assist."
[SI_ACCESSIBILITY_OPTIONS_GENERAL] = "General"
[SI_ACCESSIBILITY_OPTIONS_MOUSE_AIM_ASSIST_INTENSITY] = "Mouse Aim Assist Intensity"
[SI_ACCESSIBILITY_OPTIONS_MOUSE_AIM_ASSIST_INTENSITY_TOOLTIP] = "Adjusts aim assist intensity for Arcanist beam abilities while using a mouse. Setting to zero eliminates aim assist."
[SI_ACCESSIBILITY_OPTIONS_NARRATION_VOICE_SPEED] = "Voice Speed"
[SI_ACCESSIBILITY_OPTIONS_NARRATION_VOICE_SPEED_TOOLTIP] = "Sets the talking speed of narration."
[SI_ACCESSIBILITY_OPTIONS_NARRATION_VOICE_TYPE] = "Voice Type"
[SI_ACCESSIBILITY_OPTIONS_NARRATION_VOICE_TYPE_TOOLTIP] = "Sets the type of voice used for narration."
[SI_ACCESSIBILITY_OPTIONS_NARRATION_VOLUME] = "Voice Volume"
[SI_ACCESSIBILITY_OPTIONS_NARRATION_VOLUME_TOOLTIP] = "Controls the volume of the synthesized voice used in screen and chat narration."
[SI_ACCESSIBILITY_OPTIONS_PLAYER_WAYPOINT_COLOR] = "Custom Waypoint Color"
[SI_ACCESSIBILITY_OPTIONS_PLAYER_WAYPOINT_COLOR_TOOLTIP] = "Allows the player to select a custom waypoint color on the map."
[SI_ACCESSIBILITY_OPTIONS_SCREEN_NARRATION] = "Screen Narration"
[SI_ACCESSIBILITY_OPTIONS_SCREEN_NARRATION_TOOLTIP] = "Narrates the contents of menu screens as you navigate them."
[SI_ACCESSIBILITY_OPTIONS_TEXT_CHAT_NARRATION] = "Narrate Chat"
[SI_ACCESSIBILITY_OPTIONS_TEXT_CHAT_NARRATION_TOOLTIP] = "When this setting is enabled, chat text will be spoken back with a rendered voice."
[SI_ACCESSIBILITY_OPTIONS_TEXT_INPUT_NARRATION] = "Narrate Text Input"
[SI_ACCESSIBILITY_OPTIONS_TEXT_INPUT_NARRATION_TOOLTIP] = "When this setting is enabled, text input will be spoken back with a rendered voice."
[SI_ACCESSIBILITY_OPTIONS_VOICE_CHAT_ACCESSIBILITY] = "Voice Chat Accessibility"
[SI_ACCESSIBILITY_OPTIONS_VOICE_CHAT_ACCESSIBILITY_TOOLTIP] = "When this setting is enabled, incoming voice chat will be transcribed and outgoing text can be rendered to voice and sent to the active voice chat channel."
[SI_ACCESSIBILITY_OPTIONS_ZONE_CHAT_NARRATION] = "Narrate Zone Chat"
[SI_ACCESSIBILITY_OPTIONS_ZONE_CHAT_NARRATION_TOOLTIP] = "When this setting is enabled, all zone chat will be spoken back with a rendered voice."
[SI_ACCESSIBILITY_SETTINGS_CONTINUE_KEYBIND] = "Continue"
