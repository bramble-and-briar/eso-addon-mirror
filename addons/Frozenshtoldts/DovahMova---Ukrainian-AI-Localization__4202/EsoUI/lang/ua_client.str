[SI_HOUSING_PATH_SETTINGS_PATHING_STATE_TOOLTIP] = "Визначає, чи рухається об'єкт цим шляхом, чи залишається нерухомим на першому вузлі шляху."
[SI_HOUSING_PATH_SETTINGS_PATHING_TYPE_TEXT] = "Тип шляху"
[SI_HOUSING_PATH_SETTINGS_PATHING_TYPE_TOOLTIP] = "Якщо вибрано «Пінг-понг», об'єкт рухається шляхом до кінця, а потім повертається до початку.\n\nЯкщо вибрано «Петля», останній вузол шляху з'єднується з першим, утворюючи коло.\n\nЯкщо вибрано «Випадково», щоразу, коли об'єкт досягає вузла, він випадковим чином вибирає своє наступне місце розташування з решти вузлів на шляху."
