[SI_ZONECOMPLETIONTYPE9] = "World Bosses"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION10] = "|cffffffสถานที่โดดเด่น|r คือสถานที่ที่น่าสนใจที่กระจายอยู่ทั่วทุกมุมโลก \n\nการค้นพบสถานที่โดดเด่นทั้งหมดในหนึ่งโซนจะมอบความสำเร็จ "ผู้เบิกทาง" ของโซนนั้น"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION11] = "|cffffffคลังหนังสือของชาลิดอร์|r กระจัดกระจายอยู่ทั่วโลก หนังสือเหล่านี้สามารถสังเกตเห็นได้จากแสงสีม่วงที่โดดเด่น \n\nการค้นพบพวกมันจะช่วยเพิ่มระดับกิลด์นักเวทย์ของคุณ และช่วยพัฒนาสายทักษะที่เกี่ยวข้อง"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION12] = "|cffffffหินมุนดัส|r เป็นหินที่สามารถมอบพรในรูปแบบบัฟชั่วคราวให้กับผู้เล่น บัฟนี้จะคงอยู่จนกว่ามันจะถูกแทนที่ด้วยบัฟจากหินมุนดัสก้อนอื่น"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION13] = "|cffffffดันเจี้ยนสาธารณะ|r เป็นดันเจี้ยนแบบเปิดที่สามารถพบได้ทั่วไปในทวีป Tamriel และที่อื่นๆ มันได้รับการออกแบบมาสำหรับกลุ่มผู้เล่น 4 คน \n\nหากผู้เล่นทำการสำรวจดันเจี้ยนสาธารณะจนสำเร็จเสร็จสิ้นจะมอบแต้มทักษะ ค่าประสบการณ์ เงิน และอุปกรณ์สวมใส่ให้กับคุณ"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION14] = "|cffffffสถานีคราฟชุดเซ็ต|r เป็นสถานที่ที่คุณสามารถสร้างชุดสวมใส่ไอเท็มที่มีโบนัสเซ็ตเฉพาะได้"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION1] = "|cffffffเควสเนื้อเรื่องหลัก|r คือเส้นเนื้อเรื่องหลักของโซนนั้น \n\nการทำเควสเหล่านี้จะมอบแต้มทักษะ ค่าประสบการณ์ เงิน และอุปกรณ์สวมใส่ให้กับคุณ"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION2] = "|cffffffสถานที่สำคัญ|r คือ สถานที่ที่มีเควสเรื่องราวที่เป็นเอกเทศ ซึ่งช่วยให้คุณได้สำรวจเรื่องราว ตัวละคร และสถานที่ภายในโซนนั้น \n\nการสำรวจเรื่องราวเหล่านี้จะมอบค่าประสบการณ์ เงิน และอุปกรณ์สวมใส่ให้กับคุณ"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION4] = "|cffffffศาลสัญจร|r ช่วยให้คุณสามารถเดินทางไปยังศาลสัญจรอื่นที่ถูกปลดล็อกแล้วโดยไม่เสียค่าใช้จ่าย และสามารถเดินทางไปถึงได้ในทันที \n\nคุณยังสามารถเดินทางไปยังศาลสัญจรจากที่ไหนก็ได้บนโลกโดยไม่จำเป็นต้องอยู่ใกล้กับศาลสัญจร แต่อาจมีค่าใช้จ่ายในการเดินทางเล็กน้อย"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION5] = "|cffffffเดลฟ์|r คือดันเจี้ยนขนาดเล็กที่สามารถเคลียร์ได้ด้วยตัวคนเดียว สามารถพบได้ทั่วโลก \n\nเดลฟ์แต่ละแห่งจะมีผลึกเวหาซ่อนอยู่ข้างในเสมอ และมีบอสที่จะดร็อปชุดไอเท็มเซ็ตเฉพาะเมื่อถูกฆ่า"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION6] = "|cffffffเดลฟ์กลุ่ม|r คือดันเจี้ยนแบบเปิดขนาดกลางที่สามารถพบได้ใน Craglorn มันได้รับการออกแบบมาสำหรับกลุ่มผู้เล่น 4 คน \n\nเดลฟ์กลุ่มแต่ละแห่งจะมีผลึกเวหาซ่อนอยู่ข้างในเสมอ และมีบอสที่จะดร็อปชุดไอเท็มเซ็ตเฉพาะเมื่อถูกฆ่า"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION7] = "|cffffffผลึกเวหา|r กระจัดกระจายอยู่ทั่วโลก พวกมันสามารถสังเกตเห็นได้จากลำแสงสีขาวสว่าง \n\nการค้นพบผลึกเวหาครบ 3 ก้อนจะมอบแต้มทักษะให้กับคุณ 1 แต้มทักษะ ซึ่งสามารถใช้ปลดล็อกหรือพัฒนาทักษะใหม่ได้"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION8] = "|cffffffWorld Events|r เช่น Dark Anchors เป็นกิจกรรมอีเวนต์ที่เกิดขึ้นในโลกซึ่งเหมาะสำหรับการรับมือโดยกลุ่มนักผจญภัย \n\nการทำอีเวนต์เหล่านี้สำเร็จจะมอบค่าประสบการณ์ เงิน และอุปกรณ์สวมใส่ระดับสูงให้กับคุณ"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION9] = "|cffffffWorld Bosses|r เป็นศัตรูที่มีระดับความยาก พวกมันถูกออกแบบมาให้กลุ่มนักผจญภัยได้รับมือ \n\nการปราบพวกมันแต่ละตัวจะมอบอุปกรณ์สวมใส่ระดับสูงให้กับคุณ"
