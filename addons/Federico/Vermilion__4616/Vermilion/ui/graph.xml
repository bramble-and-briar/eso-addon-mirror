<GuiXml>
  <Controls>

    <!-- Virtual template for polyline segments. -->
    <Line name="VermilionGraphLineTemplate"
          thickness="2"
          textureFile="EsoUI/Art/UnitAttributeVisualizer/attributeBar_dynamic_fill.dds"
          pixelRoundingEnabled="false"
          virtual="true"/>

    <!--
      Two-layer architecture (mirror of Verdant):
      - Outer container (TopLevelControl): movable/resizable window with its own
        backdrop, holds the chrome (title, record/stop/flush, view navigation).
      - Inner viewport: a separate Control with its own Backdrop, hosts the
        single graph canvas. Both views (BY_SKILL / BY_OUTCOME) render here;
        the dual-canvas SkillArea Verdant used is dropped for v0.1.
    -->
    <TopLevelControl name="VermilionGraphWindow"
                     hidden="true"
                     clampedToScreen="true"
                     movable="true"
                     mouseEnabled="true"
                     resizeHandleSize="8">

      <Dimensions x="718" y="472"/>
      <OnMouseDoubleClick>Vermilion.Graph.on_title_double_click()</OnMouseDoubleClick>
      <OnMoveStart>Vermilion.Graph.on_move_start()</OnMoveStart>
      <OnMoveStop>Vermilion.Graph.on_move_stop()</OnMoveStop>
      <OnResizeStart>Vermilion.Graph.on_resize_start()</OnResizeStart>
      <OnResizeStop>Vermilion.Graph.on_resize_stop()</OnResizeStop>

      <Controls>

        <!-- Outer container backdrop (donut chrome: <Center> disabled from Lua). -->
        <Backdrop name="$(parent)Bg">
          <AnchorFill/>
          <Edge file="EsoUI/Art/Tooltips/UI-Border.dds"
                edgeFileWidth="128" edgeFileHeight="16" edgeSize="6"/>
          <Insets left="6" top="6" right="-6" bottom="-6"/>
        </Backdrop>

        <!-- Chrome donut: 4 strips around the viewport. Anchors mirror the
             Viewport's (top=50, bottom=-14, left=14, right=-14). -->
        <Texture name="$(parent)ChromeTop" addressMode="WRAP" autoAdjustTextureCoords="false"
                 textureFile="EsoUI/Art/Tooltips/UI-TooltipCenter.dds">
          <Anchor point="TOPLEFT"     relativeTo="$(parent)" relativePoint="TOPLEFT"  offsetX="2"  offsetY="2"/>
          <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)" relativePoint="TOPRIGHT" offsetX="-2" offsetY="100"/>
        </Texture>

        <Texture name="$(parent)ChromeBottom" addressMode="WRAP" autoAdjustTextureCoords="false"
                 textureFile="EsoUI/Art/Tooltips/UI-TooltipCenter.dds">
          <Anchor point="TOPLEFT"     relativeTo="$(parent)" relativePoint="BOTTOMLEFT"  offsetX="2"  offsetY="-14"/>
          <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)" relativePoint="BOTTOMRIGHT" offsetX="-2" offsetY="-2"/>
        </Texture>

        <Texture name="$(parent)ChromeLeft" addressMode="WRAP" autoAdjustTextureCoords="false"
                 textureFile="EsoUI/Art/Tooltips/UI-TooltipCenter.dds">
          <Anchor point="TOPLEFT"     relativeTo="$(parent)" relativePoint="TOPLEFT"    offsetX="2"  offsetY="100"/>
          <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)" relativePoint="BOTTOMLEFT" offsetX="14" offsetY="-14"/>
        </Texture>

        <Texture name="$(parent)ChromeRight" addressMode="WRAP" autoAdjustTextureCoords="false"
                 textureFile="EsoUI/Art/Tooltips/UI-TooltipCenter.dds">
          <Anchor point="TOPLEFT"     relativeTo="$(parent)" relativePoint="TOPRIGHT"    offsetX="-14" offsetY="100"/>
          <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)" relativePoint="BOTTOMRIGHT" offsetX="-2"  offsetY="-14"/>
        </Texture>

        <!-- Brand mark: small logo at the left of the title bar. Identity /
             anti-clone signature; decorative (mouse disabled → drag passes
             through to the window). -->
        <Texture name="$(parent)BrandLogo" textureFile="Vermilion/assets/logo.dds">
          <Anchor point="TOPLEFT" offsetX="12" offsetY="6"/>
          <Dimensions x="26" y="26"/>
        </Texture>

        <Texture name="$(parent)OrnamentTop" textureFile="Vermilion/assets/skin/ornament.dds" level="8">
          <Dimensions x="256" y="32"/>
          <Anchor point="CENTER" relativePoint="TOP" offsetY="2"/>
        </Texture>

        <Button name="$(parent)SettingsBtn"
                mouseEnabled="true"
                font="ZoFontGameSmall"
                inherits="ZO_DefaultButton">
          <Anchor point="TOPRIGHT" offsetX="-34" offsetY="7"/>
          <Dimensions x="64" y="22"/>
          <OnClicked>Vermilion.Settings.toggle()</OnClicked>
        </Button>

        <Button name="$(parent)AboutBtn"
                mouseEnabled="true"
                font="ZoFontGameSmall"
                inherits="ZO_DefaultButton">
          <Anchor point="TOPRIGHT" offsetX="-102" offsetY="7"/>
          <Dimensions x="48" y="22"/>
          <OnClicked>Vermilion.About.toggle()</OnClicked>
        </Button>

        <Button name="$(parent)CloseBtn"
                mouseEnabled="true"
                mouseOverBlendMode="ADD"
                inherits="ZO_ButtonBehaviorClickSound">
          <Anchor point="TOPRIGHT" offsetX="-8" offsetY="7"/>
          <Dimensions x="22" y="22"/>
          <OnClicked>Vermilion.Graph.on_close_click()</OnClicked>
        </Button>

        <!-- Controls row: Record / Stop / Flush. -->
        <Button name="$(parent)RecordBtn"
                mouseEnabled="true"
                font="ZoFontGameSmall"
                inherits="ZO_DefaultButton">
          <Anchor point="TOPLEFT" offsetX="14" offsetY="33"/>
          <Dimensions x="72" y="24"/>
          <OnClicked>Vermilion.Graph.on_record_main_click()</OnClicked>
        </Button>

        <Button name="$(parent)RecordMenuBtn"
                mouseEnabled="true"
                font="ZoFontGameSmall"
                inherits="ZO_DefaultButton">
          <Anchor point="TOPLEFT" offsetX="86" offsetY="33"/>
          <Dimensions x="20" y="24"/>
          <OnClicked>Vermilion.Graph.on_record_menu_click()</OnClicked>
        </Button>


        <Button name="$(parent)StopBtn"
                mouseEnabled="true"
                font="ZoFontGameSmall"
                inherits="ZO_DefaultButton">
          <Anchor point="TOPLEFT" offsetX="112" offsetY="34"/>
          <Dimensions x="56" y="22"/>
          <OnClicked>Vermilion.Graph.on_stop_click()</OnClicked>
        </Button>

        <Button name="$(parent)FlushBtn"
                mouseEnabled="true"
                font="ZoFontGameSmall"
                inherits="ZO_DefaultButton">
          <Anchor point="TOPLEFT" offsetX="174" offsetY="34"/>
          <Dimensions x="56" y="22"/>
          <OnClicked>Vermilion.Graph.on_flush_click()</OnClicked>
        </Button>

        <Button name="$(parent)LibBtn"
                mouseEnabled="true"
                mouseOverBlendMode="ADD"
                inherits="ZO_ButtonBehaviorClickSound">
          <Anchor point="TOPLEFT" offsetX="236" offsetY="31"/>
          <Dimensions x="28" y="28"/>
          <Textures normal="Vermilion/assets/skin/lib_up.dds"
                    pressed="Vermilion/assets/skin/lib_down.dds"
                    mouseOver="Vermilion/assets/skin/lib_over.dds"/>
          <OnClicked>Vermilion.Library.toggle()</OnClicked>
        </Button>

        <Button name="$(parent)SaveBtn"
                mouseEnabled="true"
                mouseOverBlendMode="ADD"
                inherits="ZO_ButtonBehaviorClickSound">
          <Anchor point="TOPLEFT" offsetX="268" offsetY="31"/>
          <Dimensions x="28" y="28"/>
          <Textures normal="Vermilion/assets/skin/save_up.dds"
                    pressed="Vermilion/assets/skin/save_down.dds"
                    mouseOver="Vermilion/assets/skin/save_over.dds"
                    disabled="Vermilion/assets/skin/save_disabled.dds"/>
          <OnClicked>Vermilion.Graph.on_save_click()</OnClicked>
        </Button>

        <Button name="$(parent)ExportBtn"
                mouseEnabled="true"
                mouseOverBlendMode="ADD"
                inherits="ZO_ButtonBehaviorClickSound">
          <Anchor point="TOPRIGHT" offsetX="-34" offsetY="33"/>
          <Dimensions x="20" y="20"/>
          <Textures normal="Vermilion/assets/skin/export_up.dds"
                    pressed="Vermilion/assets/skin/export_down.dds"
                    mouseOver="Vermilion/assets/skin/export_over.dds"
                    disabled="Vermilion/assets/skin/export_disabled.dds"/>
          <OnClicked>Vermilion.Export.open()</OnClicked>
        </Button>

        <Button name="$(parent)SayBtn"
                mouseEnabled="true"
                mouseOverBlendMode="ADD"
                inherits="ZO_ButtonBehaviorClickSound">
          <Anchor point="TOPRIGHT" offsetX="-9" offsetY="33"/>
          <Dimensions x="20" y="20"/>
          <Textures normal="Vermilion/assets/skin/say_up.dds"
                    pressed="Vermilion/assets/skin/say_down.dds"
                    mouseOver="Vermilion/assets/skin/say_over.dds"
                    disabled="Vermilion/assets/skin/say_disabled.dds"/>
          <OnClicked>Vermilion.Say.post()</OnClicked>
        </Button>

        <Button name="$(parent)PrevSessBtn"
                mouseEnabled="true"
                mouseOverBlendMode="ADD"
                inherits="ZO_ButtonBehaviorClickSound">
          <Anchor point="TOPLEFT" offsetX="302" offsetY="35"/>
          <Dimensions x="20" y="20"/>
          <Textures normal="Vermilion/assets/skin/arrow_left_up.dds"
                    pressed="Vermilion/assets/skin/arrow_left_down.dds"
                    mouseOver="Vermilion/assets/skin/arrow_left_over.dds"/>
          <OnClicked>Vermilion.Graph.step_session(-1)</OnClicked>
        </Button>

        <Button name="$(parent)NextSessBtn"
                mouseEnabled="true"
                mouseOverBlendMode="ADD"
                inherits="ZO_ButtonBehaviorClickSound">
          <Anchor point="TOPLEFT" offsetX="324" offsetY="35"/>
          <Dimensions x="20" y="20"/>
          <Textures normal="Vermilion/assets/skin/arrow_right_up.dds"
                    pressed="Vermilion/assets/skin/arrow_right_down.dds"
                    mouseOver="Vermilion/assets/skin/arrow_right_over.dds"/>
          <OnClicked>Vermilion.Graph.step_session(1)</OnClicked>
        </Button>

        <Label name="$(parent)StatusLabel"
               font="ZoFontGameSmall"
               horizontalAlignment="LEFT"
               verticalAlignment="CENTER">
          <Anchor point="TOPLEFT"  offsetX="350"  offsetY="38"/>
          <Dimensions y="14"/>
        </Label>
        <Label name="$(parent)RecModeLabel" font="ZoFontGameSmall"
               horizontalAlignment="LEFT" verticalAlignment="CENTER">
          <Anchor point="LEFT" relativeTo="$(parent)StatusLabel" relativePoint="RIGHT" offsetX="10" offsetY="0"/>
          <Anchor point="RIGHT" relativePoint="TOPRIGHT" offsetX="-60" offsetY="45"/>
          <Dimensions y="14"/>
        </Label>

        <!-- View navigation: [<<] [SKILL] [>] — in the controls row, far right,
             matching Verdant's layout (the DPS readout moved up to the title). -->
        <Button name="$(parent)PrevViewBtn"
                hidden="true"
                mouseEnabled="true"
                mouseOverBlendMode="ADD"
                inherits="ZO_ButtonBehaviorClickSound">
          <Anchor point="TOPRIGHT" offsetX="-80" offsetY="34"/>
          <Dimensions x="22" y="22"/>
          <Textures normal="EsoUI/Art/Buttons/large_leftdoublearrow_up.dds"
                    pressed="EsoUI/Art/Buttons/large_leftdoublearrow_down.dds"
                    mouseOver="EsoUI/Art/Buttons/large_leftdoublearrow_over.dds"/>
          <OnClicked>Vermilion.Graph.prev_view()</OnClicked>
        </Button>

        <Label name="$(parent)ViewLabel"
               hidden="true"
               font="ZoFontGameSmall"
               horizontalAlignment="CENTER"
               verticalAlignment="CENTER">
          <Anchor point="TOPRIGHT" offsetX="-34" offsetY="38"/>
          <Dimensions x="44" y="14"/>
        </Label>

        <Button name="$(parent)NextViewBtn"
                hidden="true"
                mouseEnabled="true"
                mouseOverBlendMode="ADD"
                inherits="ZO_ButtonBehaviorClickSound">
          <Anchor point="TOPRIGHT" offsetX="-8" offsetY="34"/>
          <Dimensions x="22" y="22"/>
          <Textures normal="EsoUI/Art/Buttons/large_rightArrow_up.dds"
                    pressed="EsoUI/Art/Buttons/large_rightArrow_down.dds"
                    mouseOver="EsoUI/Art/Buttons/large_rightArrow_over.dds"/>
          <OnClicked>Vermilion.Graph.next_view()</OnClicked>
        </Button>

        <!-- ── Inner viewport: single canvas for both views ─────────────── -->
        <Control name="$(parent)Tabs" mouseEnabled="false">
          <Anchor point="TOPLEFT"  offsetX="20"  offsetY="76"/>
          <Anchor point="TOPRIGHT" offsetX="-20" offsetY="76"/>
          <Dimensions y="24"/>
        </Control>

        <Control name="$(parent)Viewport" mouseEnabled="false">
          <Anchor point="TOPLEFT"     offsetX="14"  offsetY="100"/>
          <Anchor point="BOTTOMRIGHT" offsetX="-14" offsetY="-14"/>

          <Controls>

            <Backdrop name="$(parent)Bg">
              <AnchorFill/>
              <Edge file="EsoUI/Art/Tooltips/UI-Border.dds"
                    edgeFileWidth="128" edgeFileHeight="16" edgeSize="4"/>
              <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds"/>
              <Insets left="4" top="4" right="-4" bottom="-4"/>
            </Backdrop>

            <Control name="$(parent)Canvas" mouseEnabled="false">
              <Anchor point="TOPLEFT"     offsetX="6"  offsetY="6"/>
              <Anchor point="BOTTOMRIGHT" offsetX="-6" offsetY="-6"/>
            </Control>

            <Label name="$(parent)NoDataLabel"
                   font="ZoFontGameSmall"
                   horizontalAlignment="CENTER"
                   verticalAlignment="CENTER">
              <AnchorFill/>
            </Label>

          </Controls>
        </Control>

      </Controls>
    </TopLevelControl>

    <TopLevelControl name="VermilionRecPanel" mouseEnabled="true" hidden="true" tier="HIGH">
      <Dimensions x="344" y="96"/>
      <Controls>
        <Backdrop name="$(parent)Bg">
          <AnchorFill/>
          <Edge file="EsoUI/Art/Tooltips/UI-Border.dds"
                edgeFileWidth="128" edgeFileHeight="16" edgeSize="4"/>
          <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds"/>
          <Insets left="4" top="4" right="-4" bottom="-4"/>
        </Backdrop>
      </Controls>
    </TopLevelControl>

  </Controls>
</GuiXml>
