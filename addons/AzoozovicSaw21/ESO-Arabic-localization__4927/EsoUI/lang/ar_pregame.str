[SI_ZONECOMPLETIONTYPE_DESCRIPTION1] = ".ﺕﺍﺪﻌﻣﻭ ،ﺐﻫﺫ ،ﺓﺮﺒﺧ ،ﺓﺭﺎﻬﻣ ﻁﺎﻘﻧ ﻚﺤﻨﻤﻳ ﻥﺃ ﻦﻜﻤﻳ ﻡﺎﻬﻤﻟﺍ ﻩﺬﻫ ﻝﺎﻤﻛﺇ .ﺔﻘﻄﻨﻤﻟﺍ ﻲﻓ ﺔﺼﻘﻠﻟ ﻲﺴﻴﺋﺮﻟﺍ ﺱﻮﻘﻟﺍ ﻲﻫ|cffffffﺔﻘﻄﻨﻤﻟﺍ ﺔﺼﻗ ﺕﺎﻤﻬﻣ|r"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION10] = ".Pathfinder ﺯﺎﺠﻧﺈﺑ ﻚﺌﻓﺎﻜﻳ ﺔﻘﻄﻨﻤﻟﺍ ﻲﻓ ﺔﻴﺋﺎﻨﺜﺘﺳﺍ ﻖﻃﺎﻨﻤﻟﺍ ﻊﻴﻤﺟ ﻑﺎﺸﻜﺘﺳﺍ .ﻢﻟﺎﻌﻟﺍ ﻲﻓ ﻡﺎﻤﺘﻫﻟ ﺓﺮﻴﺜﻣ ﻦﻛﺎﻣﺃ |cffffffﺔﻴﺋﺎﻨﺜﺘﺳﺍ ﺕﺎﺣﺎﺴﻤﻟﺍ|r"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION11] = ".ﺎﻬﺑ ﻂﺒﺗﺮﻤﻟﺍ ﺕﺍﺭﺎﻬﻤﻟﺍ ﻂﺧ ﻲﻓ ﻡﺪﻘﺘﻟﺍ ﺔﺣﺎﺗﺇﻭ ﺓﺮﺤﺴﻟﺍ ﺔﺑﺎﻘﻧ ﻲﻓ ﻚﺘﺒﺗﺭ ﻊﻓﺭ ﻰﻟﺇ ﺎﻬﻴﻠﻋ ﺭﻮﺜﻌﻟﺍ ﻱﺩﺆﻴﺳ .ﺢﺿﺍﻮﻟﺍ ﻲﺠﺴﻔﻨﺒﻟﺍ ﺎﻬﺠﻫﻮﺘﺑ ﺎﻫﺰﻴﻴﻤﺗ ﻦﻜﻤﻳﻭ ،ﻢﻟﺎﻌﻟﺍ ﺀﺎﺤﻧﺃ ﻲﻓ ﺓﺮﺜﻌﺒﻣ |cffffffﺭﻭﺪﻴﻟﺎﺷ ﺔﺒﺘﻜﻣ ﺐﺘﻛ|r"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION12] = ".ﺮﺧﺁ ﺱﻭﺪﻧﻮﻣ ﺮﺠﺤﺑ ﻪﻟﺍﺪﺒﺘﺳﺍ ﻢﺘﻳ ﻰﺘﺣ ﺮﻴﺛﺄﺘﻟﺍ ﺍﺬﻫ ﺮﻤﺘﺴﻳ .ﺎﺘﻗﺆﻣ ﺍﺮﻴﺛﺄﺗ ﺎﻬﺤﻨﻣ ﻝﺧ ﻦﻣ ﺓﺰﻴﻣ ﺐﻋﻟﺍ ﺢﻨﻤﺗ ﻢﻟﺎﻌﻟﺍ ﻲﻓ ﺀﺎﻴﺷﺃ |cffffffﺱﻭﺪﻧﻮﻣ ﺭﺎﺠﺣﺃ|r"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION13] = ".ﺕﺍﺪﻌﻣﻭ ﺐﻫﺫﻭ ﺓﺮﺒﺧﻭ ﺓﺭﺎﻬﻣ ﺔﻄﻘﻧ ﻚﺤﻨﻤﻳ ﻥﺃ ﻦﻜﻤﻳ ﺔﻣﺎﻌﻟﺍ ﺕﺎﻧﺍﺰﻧﺰﻟﺍ ﻦﻣ ﺔﻔﻠﺘﺨﻣ ﻡﺎﺴﻗﺃ ﻝﺎﻤﻛﺇ .ﻦﻴﺒﻋ ﺔﻌﺑﺭﺃ ﻦﻣ ﺕﺎﻋﻮﻤﺠﻤﻟ ﺎﻬﻤﻴﻤﺼﺗ ﻢﺗ .ﺎﻫﺪﻌﺑ ﺎﻣﻭ ﻞﻳﺮﻣﺎﺗ ﻲﻓ ﻊﻘﺗ ﺡﻮﺘﻔﻣ ﻢﻟﺎﻋ ﺕﺎﻧﺍﺰﻧﺯ ﻲﻫ|cffffffﺔﻣﺎﻌﻟﺍ ﺕﺎﻧﺍﺰﻧﺰﻟﺍ|r"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION14] = ".ﺓﺩﺪﺤﻣ ﺕﺂﻓﺎﻜﻣ ﻞﻤﺤﺗ ﺮﺻﺎﻨﻋ ﻊﻨﺻ ﺎﻬﻴﻓ ﻚﻨﻜﻤﻳ ﻢﻟﺎﻌﻟﺍ ﻲﻓ ﻊﻗﺍﻮﻣ ﻩﺬﻫ |cffffffﺮﻳﻮﺼﺘﻟﺍ ﺕﺎﻄﺤﻣ|r"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION2] = ".ﺕﺍﺪﻌﻤﻟﺍﻭ ،ﺐﻫﺬﻟﺍﻭ ،ﺓﺮﺒﺨﻟﺎﺑ ﻚﺌﻓﺎﻜﺗ ﻩﺬﻫ .ﻊﻗﺍﻮﻤﻟﺍﻭ ﺕﺎﻴﺼﺨﺸﻟﺍﻭ ﺺﺼﻘﻟﺍ ﻑﺎﺸﺘﻛﺍ ﻚﻨﻜﻤﻳ ﺚﻴﺣ ،ﺎﻬﺗﺍﺫ ﺪﺤﺑ ﺔﺼﻗ ﺎﻬﻟ ﻖﻃﺎﻨﻣ ﻩﺬﻫ |cffffffﻡﺎﻤﺘﻫﺍ ﻁﺎﻘﻧ|r"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION4] = ".ﻢﻟﺎﻌﻟﺍ ﺀﺎﺤﻧﺃ ﻊﻴﻤﺟ ﻦﻣ ﺐﻫﺬﻟﺍ ﻦﻣ ﺮﻴﻐﺻ ﻎﻠﺒﻣ ﻊﻓﺪﺑ ﺔﺣﻮﺘﻔﻤﻟﺍ ﺲﺘﻴﺸﺘﻴﻐﻟﻮﻴﻟﺍ ﻰﻟﺇ ﺮﻔﺴﻟﺍ ﺎﻀﻳﺃ ﻚﻨﻜﻤﻳ .ﻞﺒﻗ ﻦﻣ ﺎﻬﺤﺘﻓﻭ ﺎﻬﻓﺎﺸﺘﻛﺍ ﻢﺗ ﻲﺘﻟﺍ ﻯﺮﺧﺍ ﺲﻴﺠﻟﻮﻴﻟﺍ ﻦﻴﺑ ﺎﻧﺎﺠﻣﻭ ﺍﺭﻮﻓ ﺎﻬﺑ ﻡﺎﻴﻘﻟﺍ ﻚﻨﻜﻤﻳ ﺮﻔﺳ ﻁﺎﻘﻧ ﻩﺬﻫ |cffffffﻕﺮﻄﻟﺍ ﺕﺍﺮﻤﻣ|r"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION5] = ".ﺓﺩﺪﺤﻣ ﺮﺻﺎﻨﻋ ﻂﻘﺴﻳ ﻢﻴﻋﺯﻭ ﻙﺰﻴﻧ ﻰﻠﻋ ﻱﻮﺘﺤﺗ ﺎﻤﺋﺍﺩ ﻑﻮﻬﻜﻟﺍ .ﺽﺭﺍ ﻰﻠﻋ ﺎﻫﺩﺮﻔﻤﺑ ﺎﻬﻟﺎﻤﻛﺇ ﻦﻜﻤﻳ ﺕﺎﻧﺍﺰﻧﺯ ﻲﻫ |cffffffﻑﻮﻬﻜﻟﺍ|r"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION6] = ".ﺓﺩﺪﺤﻣ ﺮﺻﺎﻨﻋ ﻂﻘﺴﻳ ﻢﻴﻋﺯﻭ ﻙﺰﻴﻧ ﻰﻠﻋ ﻱﻮﺘﺤﺗ ﺎﻤﺋﺍﺩ ﺔﻴﻋﺎﻤﺠﻟﺍ ﻑﻮﻬﻜﻟﺍ .ﻦﻴﺒﻋ ﺔﻌﺑﺭﺃ ﻦﻣ ﺕﺎﻋﻮﻤﺠﻤﻟ ﺎﺼﻴﺼﺧ ﺔﻤﻤﺼﻣ ﺡﻮﺘﻔﻣ ﻢﻟﺎﻋ ﺕﺎﻧﺍﺰﻧﺯ ﻲﻫﻭ ،ﻥﺭﻮﻠﻏﺍﺮﻛ ﻲﻓ ﻊﻘﺗ |cffffffﺕﺎﻋﻮﻤﺠﻤﻟﺍ ﻑﻮﻬﻛ|r"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION7] = ".ﺓﺪﻳﺪﺟ ﺕﺍﺭﺪﻗ ﻞﻴﻜﺸﺗ ﻭﺃ ﺢﺘﻔﻟ ﺎﻬﻣﺍﺪﺨﺘﺳﺍ ﻚﻨﻜﻤﻳ ،ﺓﺭﺪﻗ ﺔﻄﻘﻧ ﻚﺤﻨﻤﻴﺳ ﻙﺰﻴﻧ ﺔﺛﺛ ﻑﺎﺸﺘﻛﺍ .ﻩﺭﺪﺼﺗ ﻱﺬﻟﺍ ﻊﻃﺎﺴﻟﺍ ﺾﻴﺑﺍ ﺀﻮﻀﻟﺍ ﻉﺎﻌﺷ ﻝﺧ ﻦﻣ ﺎﻬﻴﻠﻋ ﻑﺮﻌﺘﻟﺍ ﻦﻜﻤﻳﻭ ﻢﻟﺎﻌﻟﺍ ﺀﺎﺤﻧﺃ ﻊﻴﻤﺟ ﻲﻓ ﺮﺸﺘﻨﺗ |cffffffﻙﺯﺎﻴﻨﻟﺍ|r"
