[SI_GUILD_INFO_SCENE_TITLE] = "Gillesinformation"
[SI_GUILD_INTRODUCTION] = "Gillen är ett utmärkt sätt att slå dig ihop med andra resenärer som du möter när du utforskar Tamriel! Dessa stora, permanenta grupper låter spelare gå samman, arbeta mot gemensamma mål och låsa upp särskilda förmåner som gillesbutiker."
[SI_GUILD_INVITED_PLAYER_LOCATION] = "Väntande inbjudan"
[SI_GUILD_INVITE_ACTION] = "Lägg till medlem"
[SI_GUILD_INVITE_BLACKISTED_ALERT] = "<<1>> är svartlistad från <<2>>."
[SI_GUILD_INVITE_MESSAGE] = "Du har bjudits in till <<X:1>>|cffffff<<2>>|r av |cffffff<<3>>|r."
[SI_GUILD_KEEP_ATTACK_END] = "Inga fler vakter har dödats vid <<1>>."
[SI_GUILD_KEEP_ATTACK_UPDATE] = "<<1>> <<1[vakt har/vakter har]>> dödats vid <<2>> av <<3>> <<3[spelare/spelare]>>."
[SI_GUILD_KEEP_OWNERSHIP_HEADER] = "Ägarskap i\nAllianskriget"
[SI_GUILD_KIOSK_BANKED_GOLD_HEADER] = "Saldo i gillesbanken:"
[SI_GUILD_KIOSK_BIDDING_CLOSES_IN_HEADER] = "Budgivningen stänger om:"
[SI_GUILD_KIOSK_BID_DESCRIPTION] = "Ditt gille kan lägga bud för att anställa denna handlare framöver. Det vinnande gillets butik görs tillgänglig för allmänheten via denna handlare i totalt |cffffff7 dagar|r. Anställningsperioden börjar inte förrän en vinnare har utsetts när budgivningen stänger.\n\n|cffffffOBS:|r Ditt gille kan lägga bud på upp till |cffffff<<1>>|r handlare per vecka, men kan bara vinna |cffffff1|r, baserat på ert högsta vinnande bud. Om flera vinnande bud är lika stora vinner det tidigaste. Alla andra bud återbetalas när budgivningen stänger."
[SI_GUILD_KIOSK_BID_ERROR_TRADING_HOUSE_LOCKED] = "Gillen måste ha låst upp gillesbutiker för att lägga bud på en gilleshandlare. Detta gille har inte de |cffffff<<1>>|r medlemmar som krävs."
[SI_GUILD_KIOSK_BID_GUILD_CHOICE_HEADER] = "Bud för gillet:"
[SI_GUILD_KIOSK_BID_RATE_EXCEEDED] = "För många bud på kort tid."
[SI_GUILD_KIOSK_BID_TITLE] = "Lägg bud på gilleshandlare"
[SI_GUILD_KIOSK_CURRENT_BID_HEADER] = "Nuvarande bud:"
[SI_GUILD_KIOSK_DISPLAY_CAPTION_WITH_OWNER] = "Gilleshandlare (<<1>>)"
[SI_GUILD_KIOSK_INITIAL_BID] = "Lägg bud"
[SI_GUILD_KIOSK_MINIMUM_BID_HEADER] = "Lägsta bud:"
[SI_GUILD_KIOSK_NEW_BID_HEADER] = "Nytt bud:"
[SI_GUILD_KIOSK_PURCHASE] = "Anställ"
[SI_GUILD_KIOSK_PURCHASE_COST] = "Anställningskostnad:"
[SI_GUILD_KIOSK_PURCHASE_DESCRIPTION] = "Ditt gille kan anställa denna handlare med omedelbar verkan. När handlaren är anställd görs ditt gilles butik tillgänglig för allmänheten via denna handlare under de närmaste |cffffff<<1>>|r.\n\n|cffffffOBS:|r Ett gille kan bara ha en anställd handlare åt gången."
[SI_GUILD_KIOSK_PURCHASE_ERROR_KIOSK_RENTED] = "Gillen kan bara anställa en gilleshandlare åt gången. Detta gille har redan anställt |cffffff<<1>>|r."
[SI_GUILD_KIOSK_PURCHASE_ERROR_TRADING_HOUSE_LOCKED] = "Gillen måste ha låst upp gillesbutiker för att anställa en gilleshandlare. Detta gille har inte de |cffffff<<1>>|r medlemmar som krävs."
